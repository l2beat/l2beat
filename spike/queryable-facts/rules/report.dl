// =============================================================================
// Output relations: what the report, the `qf` commands and the explorer read.
// =============================================================================

.output deployable
.output entryPoint
.output writes
.output transitivelyCalls
.output callsIn
.output writesIn
.output containsAssembly
.output unhandled
// Read by the project layer (rules/project.dl) when several units are put together.
.output reachableIn
.output reachesFrom
.output hasAnyCheck
.output hasSignerCheck
.output alwaysSigner
.output sometimesSigner
.output signerCheck
.output checkGetter
.output checkSelf
.output weakCheck
.output timeCheck
.output condCall

// The storage-writers table (may): for each storage variable of each deployable contract, the entry
// points that may write it, through any chain of calls. Deployment is the pseudo entry "constructor".
.decl storageWriters(C: symbol, V: symbol, Slot: number, E: symbol)
storageWriters(C, V, Slot, E) :- storageSlot(C, V, Slot, _), reachesFrom(C, E, F), writesOwn(C, F, V, _).
storageWriters(C, V, Slot, "constructor") :- deployable(C), storageSlot(C, V, Slot, _), initializer(V, _).
.output storageWriters

// How each writer gets there: E reaches F, which changes V this way, at this line.
.decl writerDetail(C: symbol, V: symbol, E: symbol, F: symbol, How: symbol, Line: number)
writerDetail(C, V, E, F, "direct", L) :-
    storageWriters(C, V, _, E), reachesFrom(C, E, F), writeSite(W, _, F, V, _), stateVariable(V, _, _, _, _, _), sourceLoc(W, _, L, _, _, _).
writerDetail(C, V, E, F, cat("through storage reference ", R), L) :-
    storageWriters(C, V, _, E), reachesFrom(C, E, F), writeSite(W, _, F, R, _), aliases(R, V), sourceLoc(W, _, L, _, _, _).
writerDetail(C, V, E, F, "inline assembly sstore", L) :-
    storageWriters(C, V, _, E), reachesFrom(C, E, F), assembly(A, F, _), asmSstore(K, A, _, T, _), yulSlotOf(C, A, T, V), sourceLoc(K, _, L, _, _, _).
writerDetail(C, V, "constructor", "", "declaration initializer", L) :-
    storageWriters(C, V, _, "constructor"), initializer(V, _), sourceLoc(V, _, L, _, _, _).
.output writerDetail

// Unknown effects reachable from an entry point, with the line of the site.
.decl opaqueWrites(C: symbol, E: symbol, F: symbol, Kind: symbol, Detail: symbol, Line: number, K: symbol)
opaqueWrites(C, E, F, Kind, Detail, Line, K) :-
    reachesFrom(C, E, F), opaqueWrite(F, K, Kind, Detail), sourceLoc(K, _, Line, _, _, _).
.output opaqueWrites
.output possibleTargets

// Findings with the line of their evidence (0 when there is none).
.decl findings(C: symbol, E: symbol, V: symbol, Kind: symbol, Detail: symbol, Tier: symbol, Line: number)
findings(C, E, V, K, D, T, Line) :- finding(C, E, V, K, D, T, X), X != "", sourceLoc(X, _, Line, _, _, _).
findings(C, E, V, K, D, T, 0)    :- finding(C, E, V, K, D, T, "").
.output findings
.output finding

// The checks behind the findings, for `qf guards` and the report.
.output senderCheck
.output senderGate
.output checkPrincipal
.output callerSelectable
.output alwaysChecks
.output sometimesChecks
.output opaqueWrite
