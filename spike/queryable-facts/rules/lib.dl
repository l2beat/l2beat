// =============================================================================
// Rule library (spike). Layers, bottom to top: structure → call graph → writes → sender checks → findings.
// These rules never look at the raw tree: they read the concept relations that rules/concepts.dl
// derives from it (function, stmt, callSite, writeSite, ...). Every relation below is *derived*:
// Soufflé computes it from the base facts, and can explain any tuple back down to those facts.
//
// Reading a rule:  head(X, Y) :- body1(X, Z), body2(Z, Y), !body3(X).
//   "head(X, Y) holds whenever there are values making every body atom true
//    (and no tuple exists for the negated ones)". Variables start uppercase; _ is a wildcard.
// =============================================================================

// ---------------------------------------------------------------------------
// Layer 2: structure
// Which contracts matter, which functions they really have, what can be called from outside.
// ---------------------------------------------------------------------------

// B is used as a base class by someone. Order 0 in `inherits` is the contract itself, so O > 0
// means "a real base". Needed to define `deployable` by negation.
.decl inheritedBy(B: symbol)
inheritedBy(B) :- inherits(_, B, O), O > 0.

// What actually gets deployed: a concrete (non-abstract) contract, not an interface or library,
// that nobody inherits from. Everything downstream is stated per deployable contract, because
// the same function body means different things inside different deployments.
.decl deployable(C: symbol)
deployable(C) :- contract(C, _, "contract", 0), !inheritedBy(C).

// The definition of signature Sig that contract C actually sees, once inheritance is resolved.
// `inherits` lists C's linearization (C itself first, then bases most-derived first), so the
// version with the smallest Order wins: that is the override the compiler would pick.
// Constructors are excluded: they never override each other, they chain (see ctorChain).
// (Solidity forces an explicit override when two unrelated bases define the same signature, so
// "earliest in the linearization" is always the most-derived one.)
.decl memberFunction(C: symbol, F: symbol)
memberFunction(C, F) :-
    inherits(C, B, O),
    function(F, B, _, Sig, Kind, _, _, _),
    Kind != "constructor",
    O = min O2 : { inherits(C, B2, O2), function(_, B2, _, Sig, Kind, _, _, _) }.

// Deployment code of C: its own constructor and every base constructor, all of which run once.
.decl ctorChain(C: symbol, Ctor: symbol)
ctorChain(C, Ctor) :- deployable(C), inherits(C, B, _), function(Ctor, B, _, _, "constructor", _, _, _).

// What the outside world can call on a deployed C: its public/external functions, fallback and
// receive. (Public getters of state variables are synthesized by the compiler, are not in the
// AST, and only read, so they are not entry points here.)
.decl entryPoint(C: symbol, F: symbol)
entryPoint(C, F) :-
    deployable(C), memberFunction(C, F),
    function(F, _, _, _, Kind, Vis, _, _),
    (Kind = "function" ; Kind = "fallback" ; Kind = "receive"),
    (Vis = "public" ; Vis = "external").

// ---------------------------------------------------------------------------
// Layer 3: call graph
// Who calls whom, first textually, then resolved inside one deployable contract.
// ---------------------------------------------------------------------------

// Static edges that stay inside this contract's code: internal calls, modifiers, library calls
// (`using for` or `Lib.f`), explicit `super.f()`/`Base.f()`, and base constructors.
// External calls are deliberately not followed: another contract's body is not this contract's
// storage, so it cannot write our variables (a delegatecall can, and is handled as opaque below).
.decl calls(F: symbol, G: symbol, Kind: symbol)
calls(F, G, Kind) :-
    callSite(_, _, F, Kind, G, _), G != "",
    (Kind = "internal" ; Kind = "internalExplicit" ; Kind = "modifier" ; Kind = "library" ; Kind = "baseConstructor").

// Function-typed variables (locals, parameters, state variables); Type is solc's type string.
.decl fnTypedVar(Var: symbol, Type: symbol)
fnTypedVar(V, T) :- localVar(V, _, _, T, _), strlen(T) >= 9, substr(T, 0, 9) = "function ".
fnTypedVar(V, T) :- param(_, _, V, T, _), strlen(T) >= 9, substr(T, 0, 9) = "function ".
fnTypedVar(V, T) :- stateVariable(V, _, _, T, _, _), strlen(T) >= 9, substr(T, 0, 9) = "function ".

// `f()` where f is a variable of internal function type. (External function types are external
// calls, which cannot write our storage; `safe.nonce()`, a getter, is not a pointer at all.)
.decl pointerCall(K: symbol, F: symbol, Var: symbol)
pointerCall(K, F, Var) :- callSite(K, _, F, "functionPointer", Var, _), fnTypedVar(Var, T), !contains("external", T).

// A pointer call runs one of the functions the variable was ever given (context-insensitive: may).
// A pointer nothing visible was assigned to is an unknown effect (opaqueWrite below), never dropped.
calls(F, G, "internal") :- pointerCall(_, F, Var), fnAssigned(Var, G).
.decl pointerResolved(K: symbol)
pointerResolved(K) :- pointerCall(K, _, Var), fnAssigned(Var, _).

// The transitive closure of `calls`: the classic Datalog recursion. Context-free (ignores
// which deployable contract we are in); see callsIn for the resolved version.
.decl transitivelyCalls(F: symbol, G: symbol)
transitivelyCalls(F, G) :- calls(F, G, _).
transitivelyCalls(F, H) :- calls(F, G, _), transitivelyCalls(G, H).

// Virtual dispatch: inside deployable C, a call written as G0 actually runs G, the override of
// G0's signature that C sees (memberFunction). Three cases:
//   1. G0 is inherited by C → run C's member with the same signature and kind;
//   2. G0 belongs to a contract C does not inherit from (e.g. a free function) → run G0 itself;
//   3. `super.f()`, `Base.f()`, library calls and base constructors are explicit → run G0 itself.
.decl dispatch(C: symbol, F: symbol, G0: symbol, G: symbol)
dispatch(C, F, G0, G) :-
    calls(F, G0, Kind), (Kind = "internal" ; Kind = "modifier"),
    deployable(C), function(G0, B0, _, Sig, K0, _, _, _), inherits(C, B0, _),
    memberFunction(C, G), function(G, _, _, Sig, K0, _, _, _).
dispatch(C, F, G0, G0) :-
    calls(F, G0, Kind), (Kind = "internal" ; Kind = "modifier"),
    deployable(C), function(G0, B0, _, _, _, _, _, _), !inherits(C, B0, _).
dispatch(C, F, G0, G0) :-
    calls(F, G0, Kind), deployable(C),
    (Kind = "internalExplicit" ; Kind = "library" ; Kind = "baseConstructor").

// Code that can run in deployable C: start from its entry points and constructor chain, then
// follow resolved calls. Mutually recursive with callsIn, which Soufflé handles as one fixpoint.
.decl reachableIn(C: symbol, F: symbol)
reachableIn(C, F) :- entryPoint(C, F).
reachableIn(C, F) :- ctorChain(C, F).
reachableIn(C, G) :- reachableIn(C, F), callsIn(C, F, G).

// The resolved call graph of deployable C: F calls G, with dispatch applied, restricted to code
// that can actually run in C.
.decl callsIn(C: symbol, F: symbol, G: symbol)
callsIn(C, F, G) :- reachableIn(C, F), dispatch(C, F, _, G).

// Which entry point E of C reaches function F (E itself included). Deployment is modelled as one
// pseudo entry point labelled "constructor", so constructor-time writes get attributed too.
.decl reachesFrom(C: symbol, E: symbol, F: symbol)
reachesFrom(C, E, E) :- entryPoint(C, E).
reachesFrom(C, "constructor", Ctor) :- ctorChain(C, Ctor).
reachesFrom(C, E, G) :- reachesFrom(C, E, F), callsIn(C, F, G).

// ---------------------------------------------------------------------------
// Layer 4: state writes
// From "this statement assigns to that variable" to "this entry point can change that slot".
// ---------------------------------------------------------------------------

// The hello world from the issue: F contains a write whose target is a state variable.
// Function-level and context-insensitive: the smallest useful statement about writes.
.decl writesDirect(F: symbol, V: symbol)
writesDirect(F, V) :- writeSite(_, _, F, V, _), stateVariable(V, _, _, _, _, _).

// ...and its transitive closure through the static call graph, exactly as written in the issue.
// Kept as-is for comparison; the report uses the context-aware writesIn below.
.decl writes(F: symbol, V: symbol)
writes(F, V) :- writesDirect(F, V).
writes(F, V) :- calls(F, G, _), writes(G, V).

// Storage references (locals and parameters declared `storage`) are pointers into state:
// `Data storage d = items[i]; d.x = 1;` writes `items`. `aliases(R, V)` says reference R may
// point into state variable V. Context-insensitive on purpose: every call site's argument flows
// to the parameter, the same over-approximation the Python analyzer documents under "Precision".
.decl aliases(R: symbol, V: symbol)
// A reference initialised from (or re-pointed to) a state variable, directly or via another reference.
aliases(R, V) :- refBinding(R, V), stateVariable(V, _, _, _, _, _).
aliases(R, V) :- refBinding(R, R2), aliases(R2, V).
// A storage parameter P of G receives whatever X the caller passed at index I.
aliases(P, V) :- param(G, I, P, _, "storage"), callSite(K, _, _, _, G, _), argBinding(K, I, X), denotes(X, V).
// Call results: X = "<K>#<i>" denotes whatever callee G returns at index i (dispatch-insensitive: static callee).
aliases(X, V) :- callResult(X, K, I), callSite(K, _, _, _, G, _), returnsRef(G, I, Y), denotes(Y, V).
// `r.slot := p.slot` in assembly: reference r now points wherever p points.
aliases(R, V) :- asmLet(A, RSlot, "ident", PSlot), asmExtRef(A, RSlot, R, "slot"), asmExtRef(A, PSlot, P, "slot"), denotes(P, V).

// X (a state variable or a storage reference) ultimately denotes state variable V.
// A state variable denotes itself; a reference denotes whatever it aliases.
.decl denotes(X: symbol, V: symbol)
denotes(V, V) :- stateVariable(V, _, _, _, _, _).
denotes(R, V) :- aliases(R, V).

// Inside assembly block A (running in deployable C), Yul text T denotes the storage slot of V:
//   1. `v.slot` references exported by the compiler;
//   2. `let x := v.slot` chains;
//   3. a literal slot number that matches C's storage layout (`sstore(3, ...)` when V lives in slot 3).
.decl yulSlotOf(C: symbol, A: symbol, T: symbol, V: symbol)
yulSlotOf(C, A, T, V) :- asmExtRef(A, T, V, "slot"), assembly(A, F, _), reachableIn(C, F).
yulSlotOf(C, A, X, V) :- asmLet(A, X, "ident", T), yulSlotOf(C, A, T, V).
yulSlotOf(C, A, T, V) :- asmSstore(_, A, "literal", T, N), N >= 0, assembly(A, F, _), reachableIn(C, F), storageSlot(C, V, N, _).

// F's own writes, in the context of deployable C, with how we know:
//   "direct"     an assignment/++/delete/push/pop whose target is the state variable itself;
//   "storageRef" a write through a storage reference that aliases V;
//   "assembly"   an `sstore` whose slot expression we could resolve to V.
.decl writesOwn(C: symbol, F: symbol, V: symbol, How: symbol)
writesOwn(C, F, V, "direct")     :- reachableIn(C, F), writeSite(_, _, F, V, _), stateVariable(V, _, _, _, _, _).
writesOwn(C, F, V, "storageRef") :- reachableIn(C, F), writeSite(_, _, F, R, _), aliases(R, V).
writesOwn(C, F, V, "assembly")   :- reachableIn(C, F), assembly(A, F, _), asmSstore(_, A, _, T, _), yulSlotOf(C, A, T, V).

// Transitive writes in context: F writes V itself, or calls (with dispatch) something that does.
.decl writesIn(C: symbol, F: symbol, V: symbol)
writesIn(C, F, V) :- writesOwn(C, F, V, _).
writesIn(C, F, V) :- callsIn(C, F, G), writesIn(C, G, V).

// An `sstore` whose slot we managed to name (so it is *not* opaque).
.decl resolvedSstore(K: symbol)
resolvedSstore(K) :- asmSstore(K, A, _, T, _), yulSlotOf(_, A, T, _).

// Writes that cannot be tied to a named variable. Never dropped: a universal claim
// ("only the owner can change anything") must see them. Kinds:
//   delegatecall / callcode   the callee runs with *our* storage and may write anything;
//   assembly                  an sstore we could not resolve, or a pre-0.6 block with no Yul AST;
//   asm-delegatecall          a delegatecall/callcode written in Yul;
//   storageRef                a write through a reference we could not tie to any variable;
//   functionPointer           a call through an internal function pointer with no visible target;
//   unresolvedCall            a call whose callee the concept layer could not resolve at all.
.decl opaqueWrite(F: symbol, K: symbol, Kind: symbol, Detail: symbol)
opaqueWrite(F, K, "delegatecall", T) :- callSite(K, _, F, "lowLevel", "delegatecall", T).
opaqueWrite(F, K, "callcode", T)     :- callSite(K, _, F, "lowLevel", "callcode", T).
opaqueWrite(F, K, "assembly", T)     :- asmSstore(K, A, _, T, _), assembly(A, F, _), !resolvedSstore(K).
opaqueWrite(F, K, "asm-delegatecall", N) :- asmCall(K, A, N), (N = "delegatecall" ; N = "callcode"), assembly(A, F, _).
opaqueWrite(F, A, "assembly", "assembly without Yul AST (solc < 0.6): effects unknown") :- assembly(A, F, 0).
// A write through a storage reference we could not tie to any state variable is still a write.
opaqueWrite(F, W, "storageRef", R)   :- writeSite(W, _, F, R, _), !stateVariable(R, _, _, _, _, _), !refHasAlias(R).
opaqueWrite(F, K, "functionPointer", T) :- pointerCall(K, F, _), !pointerResolved(K), callSite(K, _, F, _, _, T).
opaqueWrite(F, K, "unresolvedCall", T)  :- callSite(K, _, F, "unknown", _, T).

// Helper for the negation above: R aliases at least one state variable.
.decl refHasAlias(R: symbol)
refHasAlias(R) :- aliases(R, _).

// For an unresolved sstore, the state variables the same assembly block touches are the likely targets.
.decl possibleTargets(K: symbol, V: symbol)
possibleTargets(K, V) :- opaqueWrite(_, K, "assembly", _), asmSstore(K, A, _, _, _), asmExtRef(A, _, V, _), stateVariable(V, _, _, _, _, _).

// Entry E of deployable C reaches inline assembly in F: claims about E must be downgraded honestly.
.decl containsAssembly(C: symbol, E: symbol, F: symbol)
containsAssembly(C, E, F) :- reachesFrom(C, E, F), assembly(_, F, _).

// ---------------------------------------------------------------------------
// Layer 5: sender checks — where msg.sender is tested on the way to a write.
// Still the statement tree, not a control-flow graph (L2B-14860). "Runs on every completing
// execution" is decided by straight-line position: no branch or loop above the statement, and
// no `return` anywhere before it. A check is a condition that mentions the sender, directly
// (`msg.sender`) or through a getter that returns it (`_msgSender()`).
// ---------------------------------------------------------------------------

// Inner is nested anywhere inside statement Outer (Parent "" is the function body itself).
.decl within(Outer: symbol, Inner: symbol)
within(P, S) :- stmt(S, _, _, P, _), P != "".
within(P, S) :- within(P, Q), stmt(S, _, _, Q, _).

// Straight-line: every ancestor of S up to the body is a plain block (no if/loop/try in between).
.decl unconditional(S: symbol)
unconditional(B) :- functionBody(_, B).
unconditional(S) :- stmt(S, _, _, P, _), unconditional(P), stmt(P, _, PK, _, _), (PK = "Block" ; PK = "UncheckedBlock").

// A `return` earlier in the same function than S, at any nesting: reaching S is then not guaranteed
// (`value = 1; if (stop) return; revert();` — the revert is straight-line yet skipped when stop holds).
.decl returnBefore(S: symbol, R: symbol)
returnBefore(S, R) :- stmt(S, F, _, _, _), stmt(R, F, "Return", _, _), sourceLoc(R, _, _, _, PR, _), sourceLoc(S, _, _, _, PS, _), PR < PS.
.decl exitBefore(S: symbol)
exitBefore(S) :- returnBefore(S, _).

// S runs on every execution of its function that completes: straight-line, and nothing before it
// can leave the function early. (A revert before S aborts the whole call, so it needs no case here.)
.decl alwaysExecuted(S: symbol)
alwaysExecuted(S) :- unconditional(S), !exitBefore(S).

// The statement a site (call or write) lives in; a statement is its own statement.
.decl stmtOf(X: symbol, S: symbol)
stmtOf(K, S) :- callSite(K, S, _, _, _, _), S != "".
stmtOf(W, S) :- writeSite(W, S, _, _, _), S != "".
stmtOf(S, S) :- stmt(S, _, _, _, _).

// Statements that abort unconditionally when reached: `revert ...;` or a `revert(...)` call.
// (require/assert abort only when their condition fails, so they are *checks*, not aborts.)
.decl aborts(S: symbol)
aborts(S) :- stmt(S, _, "RevertStatement", _, _).
aborts(S) :- callSite(_, S, _, "builtin", "revert", _).

// Some statement nested in S aborts / is a `return`.
.decl abortsWithin(S: symbol)
abortsWithin(S) :- within(S, T), aborts(T).
.decl returnsWithin(S: symbol)
returnsWithin(S) :- within(S, T), stmt(T, _, "Return", _, _).

// F can never complete: an always-executed abort in its body. Its writes never persist.
.decl alwaysReverts(F: symbol)
alwaysReverts(F) :- aborts(S), stmt(S, F, _, _, _), alwaysExecuted(S).

// The condition of X talks about the sender: `msg.sender` itself, or a call to a function whose
// `return` hands back msg.sender (OpenZeppelin's `_msgSender()`).
.decl mentionsSender(X: symbol)
mentionsSender(X) :- refs(X, "msg.sender").
mentionsSender(X) :- refs(X, G), returnsGlobal(G, "msg.sender").
// ... or a parameter that every caller fills with the sender: `_checkRole(role, _msgSender())` then
// `if (!hasRole(role, account)) revert` checks the sender under the name `account`.
mentionsSender(X) :- refsParam(X, P, _), senderParam(P).

// Argument I of call K carries the sender: `msg.sender` itself, or a getter returning it.
.decl argSender(K: symbol, I: number)
argSender(K, I) :- argGlobal(K, I, "msg.sender").
argSender(K, I) :- argCall(K, I, G), returnsGlobal(G, "msg.sender").
// Parameter P of an internal function receives the sender at every call of that function.
.decl senderParam(P: symbol)
senderParam(P) :- param(G, I, P, _, _), callSite(K, _, _, _, G, _), argSender(K, I), !nonSenderArg(P).
.decl nonSenderArg(P: symbol)
nonSenderArg(P) :- param(G, I, P, _, _), callSite(K, _, _, Kind, G, _), (Kind = "internal" ; Kind = "internalExplicit"), !argSender(K, I).

// A *check*: require/assert on the sender, or `if (<sender ...>) { ... revert ... }`. A check anywhere
// in F protects every write in F, even earlier ones: a revert rolls the whole transaction back.
.decl senderCheck(X: symbol, F: symbol)
senderCheck(K, F) :- callSite(K, _, F, "builtin", B, _), (B = "require" ; B = "assert"), mentionsSender(K).
senderCheck(S, F) :- stmt(S, F, "IfStatement", _, _), mentionsSender(S), abortsWithin(S).

// A *gate*: `if (<sender ...>) return;` — protects only what comes after it; a return undoes nothing.
.decl senderGate(S: symbol, F: symbol)
senderGate(S, F) :- stmt(S, F, "IfStatement", _, _), mentionsSender(S), returnsWithin(S), !abortsWithin(S).

// What the sender is compared with: a state variable named in the condition, or one returned by a
// getter the condition calls (`owner()` → `_owner`). This names the principal; it does not say the
// comparison grants access — `msg.sender != owner` lands here too, so findings quote the condition.
.decl checkPrincipal(X: symbol, P: symbol)
checkPrincipal(X, P) :- (senderCheck(X, _) ; senderGate(X, _)), refs(X, P), stateVariable(P, _, _, _, _, _).
checkPrincipal(X, P) :- (senderCheck(X, _) ; senderGate(X, _)), refs(X, G), returnsStateVar(G, P).

// The condition is a disjunction (`open || msg.sender == owner`): the sender test is one way to pass.
.decl weakCheck(X: symbol)
weakCheck(X) :- (senderCheck(X, _) ; senderGate(X, _)), condShape(X, "or").

// Check X sits inside `if (<param> ...)` with no else, and the parameter is never reassigned: the
// caller decides whether the check runs at all (the playground's `conditionalGuard(bool enforce, ..)`).
.decl callerSelectable(X: symbol, F: symbol, Guard: symbol, ParamName: symbol)
callerSelectable(X, F, Guard, Name) :-
    senderCheck(X, F), stmtOf(X, XS), stmt(Guard, F, "IfStatement", _, _), within(Guard, XS),
    !hasElse(Guard), refsParam(Guard, P, Name), !reassigned(P).
.decl reassigned(P: symbol)
reassigned(P) :- writeSite(_, _, _, P, _), param(_, _, P, _, _).

// Inside deployable C, F checks the sender on every completing execution: an always-executed check
// in its own body, in one of its modifiers, or in a function it always calls. Callees are resolved
// through dispatch, so an override that drops the check is seen for what it is.
.decl alwaysChecks(C: symbol, F: symbol, X: symbol)
alwaysChecks(C, F, X) :- reachableIn(C, F), senderCheck(X, F), stmtOf(X, S), alwaysExecuted(S).
alwaysChecks(C, F, X) :- reachableIn(C, F), callSite(_, "", F, "modifier", M0, _), dispatch(C, F, M0, M), alwaysChecks(C, M, X).
alwaysChecks(C, F, X) :-
    reachableIn(C, F), callSite(_, S, F, Kind, G0, _), (Kind = "internal" ; Kind = "internalExplicit" ; Kind = "library"),
    S != "", alwaysExecuted(S), dispatch(C, F, G0, G), alwaysChecks(C, G, X).

// F checks the sender only on some paths: the check sits under a branch, after a possible early
// return, or in a callee that is not always called. Imprecise on purpose: `if (a) require(owner)
// else require(guardian)` lands here although every path is checked — telling those apart needs a CFG.
.decl sometimesChecks(C: symbol, F: symbol, X: symbol)
sometimesChecks(C, F, X) :- reachableIn(C, F), senderCheck(X, F), !alwaysChecks(C, F, X).
sometimesChecks(C, F, X) :-
    reachableIn(C, F), callSite(_, _, F, Kind, G0, _), (Kind = "modifier" ; Kind = "internal" ; Kind = "internalExplicit" ; Kind = "library"),
    dispatch(C, F, G0, G), (sometimesChecks(C, G, X) ; alwaysChecks(C, G, X)), !alwaysChecks(C, F, X).

// F has some sender check or gate on the way (used to conclude "no check found" by negation).
.decl hasAnyCheck(C: symbol, F: symbol)
hasAnyCheck(C, F) :- alwaysChecks(C, F, _).
hasAnyCheck(C, F) :- sometimesChecks(C, F, _).
hasAnyCheck(C, F) :- reachableIn(C, F), senderGate(_, F).

// Statements of E (running in C) where V may change: a write site of V, direct or through a storage
// reference; a call statement whose dispatched callee writes V; an assembly block that stores to V.
.decl effectStmt(C: symbol, E: symbol, V: symbol, S: symbol)
effectStmt(C, E, V, S) :- reachableIn(C, E), writeSite(_, S, E, V, _), stateVariable(V, _, _, _, _, _), S != "".
effectStmt(C, E, V, S) :- reachableIn(C, E), writeSite(_, S, E, R, _), aliases(R, V), S != "".
effectStmt(C, E, V, S) :- reachableIn(C, E), callSite(_, S, E, _, G0, _), S != "", dispatch(C, E, G0, G), writesIn(C, G, V).
effectStmt(C, E, V, A) :- reachableIn(C, E), assembly(A, E, _), asmSstore(_, A, _, T, _), yulSlotOf(C, A, T, V).
// V changes in one of E's modifiers, which run before the body: no gate in the body comes first.
.decl modifierEffect(C: symbol, E: symbol, V: symbol)
modifierEffect(C, E, V) :- reachableIn(C, E), callSite(_, "", E, "modifier", M0, _), dispatch(C, E, M0, M), writesIn(C, M, V).
// Some statement that may change V comes before gate S (byte offsets stand in for control flow).
.decl effectBefore(C: symbol, E: symbol, V: symbol, S: symbol)
effectBefore(C, E, V, S) :- senderGate(S, E), effectStmt(C, E, V, T), sourceLoc(T, _, _, _, PT, _), sourceLoc(S, _, _, _, PS, _), PT < PS.
// Gate S runs on every completing execution of E and before every statement that may change V.
.decl gateCovers(C: symbol, E: symbol, V: symbol, S: symbol)
gateCovers(C, E, V, S) :- senderGate(S, E), alwaysExecuted(S), entryWrites(C, E, V), V != "*", !modifierEffect(C, E, V), !effectBefore(C, E, V, S).

// ---------------------------------------------------------------------------
// Layer 6: findings — one row per observation about (deployable C, entry point E, variable V).
// Tier says what kind of statement the row is (README, "Tiers"):
//   structural   read off the tree: a check with this condition sits here, a write precedes it
//   may          over-approximation: E may write V (paths that can never run are included)
//   guaranteed   holds on every completing execution, under the model — structured control flow,
//                internal calls resolved by dispatch, no unknown effect on the path
//   heuristic    pattern-based: path coverage from straight-line position, "no check" relative to
//                what the rules recognise as a check
//   unknown      an effect the analysis cannot follow; nothing universal holds past it
// Detail says what was found, in the words of the code. Whether a check *authorises* anyone is
// left to the reader: the condition is quoted, so `!=` stays visible. Evidence is the id to point at.
// ---------------------------------------------------------------------------

// Entry E of C may change V, including through calls (may). Unknown effects are claimed under "*".
.decl entryWrites(C: symbol, E: symbol, V: symbol)
entryWrites(C, E, V) :- entryPoint(C, E), writesIn(C, E, V).
entryWrites(C, E, "*") :- entryPoint(C, E), reachesFrom(C, E, F), opaqueWrite(F, _, _, _).

// The condition of check or gate X, quoted.
.decl checkText(X: symbol, T: symbol)
checkText(X, cat("`", Cond, "`")) :- (senderCheck(X, _) ; senderGate(X, _)), condition(X, Cond).

.decl finding(C: symbol, E: symbol, V: symbol, Kind: symbol, Detail: symbol, Tier: symbol, Evidence: symbol)

// The function can never complete, so the write never persists.
finding(C, E, V, "never-persists", "the function always reverts before it can complete: this write never persists", "guaranteed", S) :-
    entryWrites(C, E, V), alwaysReverts(E), aborts(S), stmt(S, E, _, _, _), alwaysExecuted(S).

// A check that runs whenever the call completes.
finding(C, E, V, "always-checked", cat("sender check ", T, " runs on every completing execution"), "guaranteed", X) :-
    entryWrites(C, E, V), !alwaysReverts(E), alwaysChecks(C, E, X), !weakCheck(X), checkText(X, T).
// Same, but the sender test is one side of an OR: the other side passes without it.
finding(C, E, V, "or-check", cat("sender check ", T, " runs on every completing execution, but the sender test is only one side of an OR"), "guaranteed", X) :-
    entryWrites(C, E, V), !alwaysReverts(E), alwaysChecks(C, E, X), weakCheck(X), checkText(X, T).
// The branch around the check is decided by a parameter of the entry point.
finding(C, E, V, "caller-selectable",
        cat("sender check ", T, " runs only inside `if (", GCond, ")` with no else; `", Name, "` is a parameter of this function, so the caller decides whether the check runs"),
        "structural", X) :-
    entryWrites(C, E, V), !alwaysReverts(E), sometimesChecks(C, E, X), callerSelectable(X, E, Guard, Name), condition(Guard, GCond), checkText(X, T).
// A straight-line check that an earlier `return` can skip.
finding(C, E, V, "check-after-return",
        cat("sender check ", T, " is straight-line but comes after the `return` at line ", to_string(L), ", which can leave the function before the check"),
        "structural", X) :-
    entryWrites(C, E, V), !alwaysReverts(E), sometimesChecks(C, E, X), senderCheck(X, E), stmtOf(X, S), unconditional(S),
    returnBefore(S, R), sourceLoc(R, _, L, _, _, _), checkText(X, T).
// A check exists, but only some paths run it (and neither case above applies).
finding(C, E, V, "some-paths", cat("sender check ", T, " runs only on some paths"), "heuristic", X) :-
    entryWrites(C, E, V), !alwaysReverts(E), sometimesChecks(C, E, X), !callerSelectableCheck(X, E), !checkAfterReturn(X, E), checkText(X, T).
.decl callerSelectableCheck(X: symbol, E: symbol)
callerSelectableCheck(X, E) :- callerSelectable(X, E, _, _).
.decl checkAfterReturn(X: symbol, E: symbol)
checkAfterReturn(X, E) :- senderCheck(X, E), stmtOf(X, S), unconditional(S), exitBefore(S).

// An early return on the sender that comes before every statement where V may change.
finding(C, E, V, "gate-covers", cat("early return on the sender ", T, " runs on every completing execution, before every statement that can change this variable"), "guaranteed", S) :-
    entryWrites(C, E, V), !alwaysReverts(E), gateCovers(C, E, V, S), checkText(S, T).
// An early return on the sender that some change of V precedes: that change persists for any caller.
finding(C, E, V, "write-before-gate", cat("early return on the sender ", T, " comes after a statement that changes this variable: that change persists for any caller"), "structural", S) :-
    entryWrites(C, E, V), V != "*", !alwaysReverts(E), senderGate(S, E), alwaysExecuted(S), !gateCovers(C, E, V, S), checkText(S, T).
// An early return on the sender that itself runs only on some paths.
finding(C, E, V, "gate-some-paths", cat("early return on the sender ", T, " runs only on some paths"), "heuristic", S) :-
    entryWrites(C, E, V), V != "*", !alwaysReverts(E), senderGate(S, E), !alwaysExecuted(S), checkText(S, T).

// Nothing on the way tests the sender — relative to what the rules recognise as a check.
finding(C, E, V, "no-check", "no sender check found: no require/assert/if on msg.sender (or on a getter returning it) in the function, its modifiers, or anything it calls", "heuristic", "") :-
    entryWrites(C, E, V), !alwaysReverts(E), !hasAnyCheck(C, E).

// Something on the way from E that the analysis cannot follow. Never dropped: a universal claim
// ("only the owner can change anything") must see these.
finding(C, E, "*", "unknown-effect", Detail, "unknown", K) :-
    entryPoint(C, E), reachesFrom(C, E, F), opaqueWrite(F, K, Kind, D), unknownText(Kind, D, Detail).
.decl unknownText(Kind: symbol, D: symbol, Text: symbol)
unknownText("delegatecall", D, cat("delegatecall `", D, "`: the callee runs with this contract's storage and may write anything")) :- opaqueWrite(_, _, "delegatecall", D).
unknownText("callcode", D, cat("callcode `", D, "`: the callee runs with this contract's storage and may write anything")) :- opaqueWrite(_, _, "callcode", D).
unknownText("asm-delegatecall", D, cat(D, " in inline assembly: the callee runs with this contract's storage and may write anything")) :- opaqueWrite(_, _, "asm-delegatecall", D).
unknownText("assembly", D, cat("inline assembly stores to slot `", D, "`, which the rules could not tie to a variable")) :- opaqueWrite(_, _, "assembly", D), !preYulAssembly(D).
unknownText("assembly", D, D) :- opaqueWrite(_, _, "assembly", D), preYulAssembly(D).
unknownText("storageRef", D, cat("write through storage reference `", D, "`, which the rules could not tie to a variable")) :- opaqueWrite(_, _, "storageRef", D).
unknownText("functionPointer", D, cat("call through a function pointer whose target is not visible here: `", D, "`")) :- opaqueWrite(_, _, "functionPointer", D).
unknownText("unresolvedCall", D, cat("call whose target the rules could not resolve: `", D, "`")) :- opaqueWrite(_, _, "unresolvedCall", D).
.decl preYulAssembly(D: symbol)
preYulAssembly(D) :- opaqueWrite(_, _, "assembly", D), strlen(D) >= 16, substr(D, 0, 16) = "assembly without".

// Inline assembly on the path that stores to storage (every slot named) or runs foreign code: the
// names may be right, but nothing universal is guaranteed past it. Blocks that only compute or read
// (chain id, immutable args, signature splitting) cap nothing and get no row.
finding(C, E, "*", "assembly", "reaches inline assembly that writes storage: statements about every execution are not guaranteed past this point", "unknown", A) :-
    entryPoint(C, E), reachesFrom(C, E, F), assembly(A, F, _), asmEffectful(A), !asmOpaque(A).
.decl asmEffectful(A: symbol)
asmEffectful(A) :- asmSstore(_, A, _, _, _).
asmEffectful(A) :- asmCall(_, A, N), (N = "delegatecall" ; N = "callcode").
asmEffectful(A) :- assembly(A, _, 0).
.decl asmOpaque(A: symbol)
asmOpaque(A) :- opaqueWrite(_, K, "assembly", _), asmSstore(K, A, _, _, _).
asmOpaque(A) :- opaqueWrite(_, K, "asm-delegatecall", _), asmCall(K, A, _).
asmOpaque(A) :- opaqueWrite(_, A, "assembly", _), assembly(A, _, 0).
