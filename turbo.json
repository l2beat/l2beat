{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "globalDependencies": [
    "packages/typescript-config/*.json",
    ".discovery.json"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate-types"],
      "outputs": ["build/**", "dist/**"]
    },
    "db:generate-types": {
      "outputs": ["src/kysely/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate-types"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate-types"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate-types"]
    },
    "format": {},
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
