{
  "extends": "@l2beat/typescript-config/react",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "dist"]
}
