  projectId       String   @db.VarChar(255)
  bucketId        String   @db.VarChar(255)
  chain           String   @db.VarChar(32)
  timestamp       DateTime @db.Timestamp(6)
  blockNumber     Int
  txHash          String   @db.VarChar(66)
  logIndex        Int
