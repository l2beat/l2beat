generator kysely {
  provider     = "prisma-kysely"
  output       = "../src/kysely/generated"
  enumFileName = "enums.ts"
  fileName     = "types.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DB_URL")
}

model CurrentPrice {
  coingeckoId String   @id @db.VarChar(255)
  priceUsd    Float    @db.Real
  updatedAt   DateTime @db.Timestamp(6)
}

model DaBeatStats {
  id                 String @id @db.VarChar(255)
  totalStake         Float  @db.Real
  thresholdStake     Float  @db.Real
  numberOfValidators Int?
}

model Activity {
  projectId String   @db.VarChar(255)
  timestamp DateTime @db.Timestamp(6)
  count     Int
  uopsCount Int?
  start     Int      @default(0)
  end       Int      @default(0)

  @@id([projectId, timestamp])
}

/// Activity per hour, kept for the last two weeks for the 1D and 7D charts
model HourlyActivity {
  projectId String   @db.VarChar(255)
  timestamp DateTime @db.Timestamp(6)
  count     Int
  uopsCount Int?

  @@id([projectId, timestamp])
}

/// Each project's blocks of the last few hours, counted as Activity counts
/// them, with the hashes that link them to their parents. Live views read
/// them, and Activity sums them instead of fetching the blocks again
model LiveActivityBlock {
  projectId  String   @db.VarChar(255)
  number     Int
  hash       String   @db.VarChar(66)
  parentHash String   @db.VarChar(66)
  timestamp  DateTime @db.Timestamp(6)
  count      Int
  uopsCount  Int?
  gasUsed    BigInt

  @@id([projectId, number])
  @@index([timestamp])
}

model AggregatedL2Cost {
  timestamp      DateTime @db.Timestamp(6)
  projectId      String   @db.VarChar(255)
  totalGas       Int
  totalGasEth    Float    @db.Real
  totalGasUsd    Float    @db.Real
  blobsGas       Int?
  blobsGasEth    Float?   @db.Real
  blobsGasUsd    Float?   @db.Real
  calldataGas    Int
  calldataGasEth Float    @db.Real
  calldataGasUsd Float    @db.Real
  computeGas     Int
  computeGasEth  Float    @db.Real
  computeGasUsd  Float    @db.Real
  overheadGasEth Float    @db.Real
  overheadGasUsd Float    @db.Real
  overheadGas    Int

  @@id([projectId, timestamp])
  @@index([projectId])
  @@index([timestamp])
}

model DataAvailability {
  timestamp       DateTime @db.Timestamp(6)
  daLayer         String   @db.VarChar(255)
  projectId       String   @db.VarChar(255)
  configurationId String   @db.VarChar(12)
  totalSize       BigInt

  @@id([timestamp, daLayer, projectId, configurationId])
  @@index([projectId, timestamp(sort: Asc)])
}

model DiscoveryCache {
  key   String @id
  value String
}

model IndexerConfiguration {
  id            String @id @db.Char(12)
  indexerId     String @db.VarChar(255)
  currentHeight Int?
  minHeight     Int
  maxHeight     Int?
  properties    String

  @@index([indexerId])
}

model IndexerState {
  indexerId    String    @id @db.VarChar(255)
  safeHeight   Int
  minTimestamp DateTime? @db.Timestamp(6)
  configHash   String?
}

model L2Cost {
  configurationId String   @db.VarChar(12)
  txHash          String   @db.VarChar(255)
  timestamp       DateTime @db.Timestamp(6)
  gasUsed         Int
  gasPrice        BigInt
  calldataGasUsed Int
  calldataLength  Int
  blobGasUsed     Int?
  blobGasPrice    BigInt?

  @@id([configurationId, txHash])
}

model L2CostPrice {
  timestamp DateTime @id @db.Timestamp(6)
  priceUsd  Float    @db.Real
}

model Liveness {
  timestamp       DateTime @db.Timestamp(6)
  blockNumber     Int
  txHash          String   @db.VarChar(255)
  configurationId String   @db.VarChar(12)
  // 'none' marks ungrouped records; the sentinel keeps the column non-null so
  // it can be part of the primary key and one transaction can store a record
  // per grouping key. Partial unique grouping index (excluding 'none'):
  // migration 20260827130000.
  groupingKey     String   @default("none") @db.VarChar(255)

  @@id([configurationId, txHash, groupingKey])
  @@index([configurationId, timestamp])
}

model RealTimeLiveness {
  configurationId String   @db.VarChar(12)
  txHash          String   @db.VarChar(255)
  timestamp       DateTime @db.Timestamp(6)
  blockNumber     Int
  // Partial unique grouping index: migration 20260723120002.
  groupingKey     String?  @db.VarChar(255)

  @@id([configurationId, txHash])
  @@index([configurationId, timestamp])
}

model UpdateMonitor {
  projectId         String    @db.VarChar(255)
  blockNumber       Int
  timestamp         DateTime? @db.Timestamp(6)
  discoveryJsonBlob Json
  configHash        String    @default("") @db.VarChar(255)

  @@id([projectId])
}

model UpdateNotifier {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @db.Timestamp(6)
  projectId    String   @db.VarChar(255)
  timestamp    DateTime @default(now()) @db.Timestamp(6)
  diffJsonBlob Json

  @@index([timestamp])
  @@index([projectId])
}

model UpdateMessage {
  projectId String   @db.VarChar(255)
  timestamp DateTime @db.Timestamp(6)
  message   String   @db.Text

  @@id([projectId, timestamp])
}

model AggregatedLiveness {
  timestamp       DateTime @db.Timestamp(6)
  projectId       String   @db.VarChar(255)
  subtype         String   @db.VarChar(255)
  min             Int
  avg             Int
  max             Int
  numberOfRecords Int

  @@id([timestamp, projectId, subtype])
  @@index([projectId])
}

model Anomaly {
  timestamp DateTime @db.Timestamp(6)
  projectId String   @db.VarChar(255)
  subtype   String   @db.VarChar(255)
  duration  Int

  @@id([timestamp, projectId, subtype])
}

model RealTimeAnomaly {
  start      DateTime  @db.Timestamp(6)
  projectId  String    @db.VarChar(255)
  subtype    String    @db.VarChar(255)
  status     String    @db.VarChar(255)
  isApproved Boolean   @default(false)
  end        DateTime? @db.Timestamp(6)

  @@id([start, projectId, subtype])
}

model AnomalyStats {
  timestamp DateTime @db.Timestamp(6)
  projectId String   @db.VarChar(255)
  subtype   String   @db.VarChar(255)
  mean      Float    @db.Real
  stdDev    Float    @db.Real

  @@id([timestamp, projectId, subtype])
}

model FlatSources {
  projectId   String   @db.VarChar(255)
  timestamp   DateTime @default(now()) @db.Timestamp(6)
  contentHash String   @db.VarChar(255)
  flat        Json

  @@id([projectId])
}

model TvsAmount {
  timestamp       DateTime @db.Timestamp(6)
  configurationId String   @db.Char(12)
  amount          Decimal  @db.Decimal(80, 0)

  @@id([timestamp, configurationId])
}

model TvsBlockTimestamp {
  timestamp       DateTime @db.Timestamp(6)
  configurationId String   @db.Char(12)
  chain           String   @db.VarChar(255)
  blockNumber     Int

  @@id([timestamp, configurationId])
  @@index([chain])
}

model TvsPrice {
  timestamp       DateTime @db.Timestamp(6)
  configurationId String   @db.Char(12)
  priceId         String   @db.VarChar(255)
  priceUsd        Float    @db.Real

  @@id([timestamp, configurationId])
  @@index([priceId])
}

model TokenValue {
  timestamp       DateTime @db.Timestamp(6)
  configurationId String   @db.Char(12)
  projectId       String   @db.VarChar(255)
  tokenId         String   @db.VarChar(255)
  amount          Float    @db.Real
  value           Float    @db.Real
  valueForProject Float    @db.Real
  valueForSummary Float    @db.Real
  priceUsd        Float    @default(0) @db.Real

  @@id([timestamp, configurationId])
  @@index([projectId])
  @@index([tokenId])
  @@index([projectId, tokenId, timestamp(sort: Desc)])
  @@index([projectId, timestamp, tokenId, valueForProject, valueForSummary])
}

/// Value of each escrow balance a TVS token sums, for tokens whose project
/// shows value per escrow (privacy buckets). Written with TokenValue.
model TvsEscrowValue {
  timestamp       DateTime @db.Timestamp(6)
  /// TokenValue configurationId of the token the escrow belongs to.
  configurationId String   @db.Char(12)
  projectId       String   @db.VarChar(255)
  tokenId         String   @db.VarChar(255)
  chain           String   @db.VarChar(255)
  escrowAddress   String   @db.VarChar(255)
  amount          Float    @db.Real
  value           Float    @db.Real

  @@id([timestamp, configurationId, chain, escrowAddress])
  @@index([configurationId])
  @@index([projectId, timestamp])
}

model DefiTvl {
  timestamp       DateTime @db.Timestamp(6)
  sourceTimestamp DateTime @db.Timestamp(6)
  configurationId String   @db.Char(12)
  projectId       String   @db.VarChar(255)
  chain           String   @db.VarChar(255)
  valueUsd        Float    @db.DoublePrecision

  @@id([timestamp, configurationId, chain])
  @@index([configurationId])
  @@index([projectId, timestamp(sort: Desc)])
}

/// Hourly onchain state of a liquid staking token; the exit columns are set only for the protocols they apply to.
model LiquidStakingSnapshot {
  configurationId        String   @db.Char(12)
  projectId              String   @db.VarChar(255)
  timestamp              DateTime @db.Timestamp(6)
  blockNumber            Int
  /// ETH per token, 18 decimals; for Lido per share, i.e. per wstETH.
  exchangeRate           Decimal  @db.Decimal(80, 0)
  /// Withdrawal queue counters (Lido, ether.fi), or the unwrap request and allocation counters (wBETH).
  lastRequestId          Int?
  lastFinalizedRequestId Int?
  /// ETH the protocol pays out at once: burning rETH (Rocket Pool), or the instant redemption (ether.fi), wei.
  instantExitEth         Decimal? @db.Decimal(80, 0)
  /// The instant exit's fee, basis points.
  instantExitFeeBps      Int?
  /// Lock on an onchain redemption (wBETH), seconds.
  lockTime               Int?
  /// ETH the best onchain pool pays for 1 token, wei; null without a quote.
  marketExitEth          Decimal? @db.Decimal(80, 0)
  /// What that token is worth at the protocol's rate, wei.
  marketExitValueEth     Decimal? @db.Decimal(80, 0)

  @@id([configurationId, timestamp])
  @@index([projectId, timestamp])
}

/// Ethereum staking per UTC day, in wei: the beacon state as the day starts and the execution flows during it.
model EthereumStakingDaily {
  /// Start of the day.
  timestamp         DateTime @id @db.Timestamp(6)
  /// The beacon state read: the last slot before the day starts.
  slot              Int
  /// Sum of every validator's balance.
  totalBalance      Decimal  @db.Decimal(80, 0)
  /// Balance of the validators that earn: the total without those waiting to enter or exited.
  activeBalance     Decimal  @db.Decimal(80, 0)
  /// Deposits waiting to be credited; null before Pectra, when there was no queue.
  pendingDeposits   Decimal? @db.Decimal(80, 0)
  /// Withdrawals paid in the day's blocks.
  withdrawals       Decimal  @db.Decimal(80, 0)
  /// Deposits the beacon chain credited during the day, to a balance or the pending queue.
  deposits          Decimal  @db.Decimal(80, 0)
  /// What builders paid proposers, in the blocks with a builder payment.
  builderPayments   Decimal  @db.Decimal(80, 0)
  /// Priority fees of the blocks without a builder payment, which their proposers kept.
  priorityFees      Decimal  @db.Decimal(80, 0)
  /// ETH sent to the fee recipient in its own transactions, in the blocks without a builder payment.
  directTransfers   Decimal  @db.Decimal(80, 0)
  blockCount        Int
  /// Blocks counted as builder blocks: the fee recipient's last transaction pays the proposer.
  builderBlockCount Int
}

model TokenMetadata {
  tokenId      String  @db.VarChar(255)
  projectId    String  @db.VarChar(255)
  source       String  @db.VarChar(255)
  category     String  @db.VarChar(255)
  isAssociated Boolean

  @@id([tokenId])
  @@index([projectId])
}

model PrivacyPrice {
  timestamp       DateTime @db.Timestamp(6)
  configurationId String   @db.Char(12)
