# Environment variables for `pnpm da:preview` (see docs/da-tracking.md).
# The script reads packages/backend/.env - copy the variables you need there.
# Each DA layer is enabled only when its url is set; others are skipped.

# Ethereum blobs (beacon chain API)
ETHEREUM_BEACON_API_URL=https://example.com/beacon
# Optional - overrides the rpc url from the ethereum chain config
ETHEREUM_RPC_URL=https://example.com/rpc
# ETHEREUM_BEACON_API_CALLS_PER_MINUTE=600
# ETHEREUM_RPC_CALLS_PER_MINUTE=120
# ETHEREUM_BLOBS_BATCH_SIZE=2500

# Celestia
CELESTIA_BLOBS_API_URL=https://example.com/celestia
# CELESTIA_BLOBS_API_CALLS_PER_MINUTE=20000
# CELESTIA_BLOBS_API_TIMEOUT=30000
# CELESTIA_BLOBS_BATCH_SIZE=100

# Avail
AVAIL_BLOBS_API_URL=https://example.com/avail
# AVAIL_BLOBS_API_CALLS_PER_MINUTE=2000
# AVAIL_BLOBS_BATCH_SIZE=100

# EigenDA (both urls required)
EIGEN_DA_API_URL=https://example.com/eigen
EIGEN_DA_PER_PROJECT_API_URL=https://example.com/eigen-per-project
# EIGEN_DA_API_CALLS_PER_MINUTE=2000

# Optional read-only database connection. When set, ethereum blobs are read
# from the indexed Blob table instead of the beacon API (much faster, and
# works even without ETHEREUM_BEACON_API_URL).
DA_PREVIEW_DB_URL=postgresql://user:password@host:5432/db

# LOG_LEVEL=INFO
