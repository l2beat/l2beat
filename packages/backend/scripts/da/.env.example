# Environment variables for `pnpm da:preview` (see docs/da-tracking.md).
# Copy this file to .env in this directory (scripts/da/.env); variables set
# there take precedence over packages/backend/.env, which remains a fallback.

# Ethereum blobs (beacon chain API)
ETHEREUM_BEACON_API_URL=https://example.com/beacon
# Optional - overrides the rpc url from the ethereum chain config
ETHEREUM_RPC_URL=https://example.com/rpc
# ETHEREUM_BEACON_API_CALLS_PER_MINUTE=600
# ETHEREUM_RPC_CALLS_PER_MINUTE=120
# ETHEREUM_BLOBS_BATCH_SIZE=2500

# Optional read-only database connection. When set, ethereum blobs are read
# from the indexed Blob table instead of the beacon API (much faster, and
# works even without ETHEREUM_BEACON_API_URL).
# DA_PREVIEW_DB_URL=postgresql://user:password@host:5432/db

