{
  "name": "@l2beat/discovery-v2",
  "description": "Single-address extractor: V1 discovery entries with model-authored, recipe-shaped state fetching.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "mocha",
    "clean": "rm -rf dist *.tsbuildinfo",
    "build": "tsc && node -e \"require('fs').cpSync('src/library/recipes', 'dist/library/recipes', { recursive: true })\"",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint:fix": "biome check --formatter-enabled=false --write .",
    "lint": "biome check --formatter-enabled=false .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@l2beat/backend-tools": "workspace:*",
    "@l2beat/discovery": "workspace:*",
    "@l2beat/shared": "workspace:*",
    "@l2beat/shared-pure": "workspace:*",
    "@l2beat/validate": "workspace:*",
    "cmd-ts": "^0.13.0",
    "ethers": "^5.7.2",
    "jq-wasm": "^3.0.0-jq-1.8.2"
  },
  "devDependencies": {
    "@l2beat/typescript-config": "workspace:*",
    "tsx": "^4.9.3"
  }
}
