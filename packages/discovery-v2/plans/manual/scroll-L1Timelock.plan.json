{
  "version": 1,
  "contract": "TimelockController",
  "shapeHash": "0x86f2f8f0a8a0a5a9e5a84434ceaea660fc1d7e495ef1df1e392d8fafd20c4b09",
  "steps": [
    {
      "id": "accessControl",
      "covers": ["getRoleAdmin(bytes32)", "hasRole(bytes32,address)"],
      "fetch": {
        "kind": "logs",
        "events": ["RoleGranted", "RoleRevoked", "RoleAdminChanged"]
      },
      "use": "accessControl@1",
      "args": {
        "roleNames": {
          "0x5f58e3a2316349923ce3780f8d587db2d72378aed66a8261c916544fa6846ca5": "TIMELOCK_ADMIN_ROLE",
          "0xb09aa5aeb3702cfd50b6b62bc4532604938f21248a27a1d5ca736082b6819cc1": "PROPOSER_ROLE",
          "0xd8aa0f3194971a2a116679f7c2090f6939c8d4e01a2a8d7e41d55e5351469e63": "EXECUTOR_ROLE",
          "0xfd643c72710c63c0180259aba6b2d05451e3591a24e58b62239378085726f783": "CANCELLER_ROLE"
        }
      },
      "reason": "OpenZeppelin AccessControl: _roles is written only by _grantRole, _revokeRole and _setRoleAdmin, each of which emits its event, so the role table answers hasRole and getRoleAdmin for every role. Role names come from the *_ROLE() baseline getters, as V1's template names them."
    }
  ],
  "skips": [
    { "item": "getTimestamp(bytes32)", "reason": "user-activity" },
    { "item": "isOperation(bytes32)", "reason": "user-activity" },
    { "item": "isOperationDone(bytes32)", "reason": "user-activity" },
    { "item": "isOperationPending(bytes32)", "reason": "user-activity" },
    { "item": "isOperationReady(bytes32)", "reason": "user-activity" },
    {
      "item": "hashOperation(address,uint256,bytes,bytes32,bytes32)",
      "reason": "computation"
    },
    {
      "item": "hashOperationBatch(address[],uint256[],bytes[],bytes32,bytes32)",
      "reason": "computation"
    },
    { "item": "supportsInterface(bytes4)", "reason": "not-state" }
  ]
}
