{
  "plan": {
    "version": 1,
    "contract": "MultipleVersionRollupVerifier",
    "shapeHash": "0x68ef4e9fec5e32121dc21eb0a83b381d885515e0002848af86de620f62f32d5a",
    "steps": [
      {
        "id": "updateVerifier",
        "fetch": {
          "kind": "logs",
          "events": ["UpdateVerifier"]
        },
        "use": "list@1",
        "args": {
          "key": "version",
          "add": [
            {
              "event": "UpdateVerifier"
            }
          ]
        },
        "reason": "Versions are introduced by the constructor or updateVerifier (onlyOwner), both of which emit UpdateVerifier."
      },
      {
        "id": "latestVerifier",
        "covers": ["latestVerifier(uint256)"],
        "fetch": {
          "kind": "callEach",
          "method": "latestVerifier(uint256)",
          "keys": {
            "from": "$step.updateVerifier"
          }
        },
        "use": "map@1",
        "reason": "The constructor and updateVerifier (onlyOwner) emit UpdateVerifier for every version written to latestVerifier."
      },
      {
        "id": "legacyVerifiersLength",
        "covers": ["legacyVerifiersLength(uint256)"],
        "fetch": {
          "kind": "callEach",
          "method": "legacyVerifiersLength(uint256)",
          "keys": {
            "from": "$step.updateVerifier"
          }
        },
        "use": "map@1",
        "reason": "updateVerifier (onlyOwner) is the only function that appends to legacyVerifiers and emits UpdateVerifier for its version."
      }
    ],
    "skips": [
      {
        "item": "getVerifier(uint256,uint256)",
        "reason": "computation"
      },
      {
        "item": "legacyVerifiers(uint256,uint256)",
        "reason": "unbounded"
      }
    ]
  },
  "provenance": {
    "source": "model",
    "createdAt": "2026-09-22T05:48:37.833Z",
    "model": "gpt-5.6-sol",
    "rounds": 1,
    "decisionHash": "0xee578a96d6e9ae3a30d727e60b74a264d25834a5c0f1eb64857b07d416ea95f3"
  }
}
