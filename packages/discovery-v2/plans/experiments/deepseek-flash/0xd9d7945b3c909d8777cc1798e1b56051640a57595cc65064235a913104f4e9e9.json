{
  "plan": {
    "version": 1,
    "contract": "SequencerInbox",
    "shapeHash": "0xd9d7945b3c909d8777cc1798e1b56051640a57595cc65064235a913104f4e9e9",
    "steps": [
      {
        "id": "dasKeySetInfo",
        "covers": [
          "dasKeySetInfo(bytes32)",
          "isValidKeysetHash(bytes32)"
        ],
        "fetch": {
          "kind": "logs",
          "events": [
            "SetValidKeyset",
            "InvalidateKeyset"
          ]
        },
        "use": "set@1",
        "args": {
          "key": "keysetHash",
          "add": [
            {
              "event": "SetValidKeyset"
            }
          ],
          "remove": [
            {
              "event": "InvalidateKeyset"
            }
          ]
        },
        "reason": "dasKeySetInfo is written only by setValidKeyset and invalidateKeysetHash (onlyRollupOwner), which emit SetValidKeyset and InvalidateKeyset"
      },
      {
        "id": "getKeysetCreationBlock",
        "covers": [
          "getKeysetCreationBlock(bytes32)"
        ],
        "fetch": {
          "kind": "callEach",
          "method": "getKeysetCreationBlock(bytes32)",
          "keys": {
            "from": "$step.dasKeySetInfo"
          }
        },
        "use": "map@1",
        "reason": "getKeysetCreationBlock reads dasKeySetInfo[ksHash], so its keys are exactly the keyset hashes enumerated from SetValidKeyset events by the dasKeySetInfo step"
      }
    ],
    "skips": [
      {
        "item": "forceInclusionDeadline(uint64)",
        "reason": "computation"
      },
      {
        "item": "inboxAccs(uint256)",
        "reason": "unbounded"
      },
      {
        "item": "isBatchPoster(address)",
        "reason": "unbounded"
      },
      {
        "item": "isSequencer(address)",
        "reason": "unbounded"
      }
    ]
  },
