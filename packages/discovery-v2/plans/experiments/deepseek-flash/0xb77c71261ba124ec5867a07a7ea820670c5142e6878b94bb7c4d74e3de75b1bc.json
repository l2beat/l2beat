        ],
        "fetch": {
          "kind": "callEach",
          "method": "getLastUnpauseTime(address)",
          "keys": {
            "from": "$step.unpause"
          }
        },
        "use": "map@1",
        "reason": "getLastUnpauseTime returns lastUnpauseTime[component], which is written to block.timestamp in unpause (onlyOwner), whose Unpause event enumerates every component that can hold a value"
      }
    ],
