      {
        "id": "routes",
        "covers": [
          "routes(bytes4)"
        ],
        "fetch": {
          "kind": "callEach",
          "method": "routes(bytes4)",
          "keys": {
            "from": "$step.routeAdded"
          }
        },
        "use": "map@1",
        "reason": "routes is written only by addRoute and freezeRoute (onlyOwner), which emit RouteAdded and RouteFrozen, and every selector is enumerated from RouteAdded"
      }
    ],
