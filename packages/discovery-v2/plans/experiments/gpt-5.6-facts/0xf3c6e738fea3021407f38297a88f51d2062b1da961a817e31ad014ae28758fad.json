{
  "plan": {
    "version": 1,
    "contract": "L1GatewayRouter",
    "shapeHash": "0xf3c6e738fea3021407f38297a88f51d2062b1da961a817e31ad014ae28758fad",
    "steps": [
      {
        "id": "ERC20Gateway",
        "covers": [
          "ERC20Gateway(address)"
        ],
        "fetch": {
          "kind": "logs",
          "events": [
            "SetERC20Gateway"
          ]
        },
        "use": "latest@1",
        "args": {
          "value": "newGateway",
          "set": [
            {
              "event": "SetERC20Gateway"
            }
          ],
          "groupBy": "token"
        },
        "reason": "ERC20Gateway is written only by setERC20Gateway (onlyOwner), which emits SetERC20Gateway."
      },
      {
        "id": "getL2ERC20Address",
        "covers": [
          "getL2ERC20Address(address)"
        ],
        "fetch": {
          "kind": "callEach",
          "method": "getL2ERC20Address(address)",
          "keys": {
            "from": "$step.ERC20Gateway"
          }
        },
        "use": "map@1",
        "reason": "Token keys are completely enumerated by SetERC20Gateway events emitted by setERC20Gateway (onlyOwner)."
      }
    ],
    "skips": [
      {
        "item": "getERC20Gateway(address)",
        "reason": "computation"
      }
    ]
  },
