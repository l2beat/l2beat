{
  "plan": {
    "version": 1,
    "contract": "MultipleVersionRollupVerifier",
    "shapeHash": "0x68ef4e9fec5e32121dc21eb0a83b381d885515e0002848af86de620f62f32d5a",
    "steps": [
      {
        "id": "updateVerifier",
        "fetch": {
          "kind": "logs",
          "events": [
            "UpdateVerifier"
          ]
        },
        "use": "list@1",
        "args": {
          "key": "version",
          "add": [
            {
              "event": "UpdateVerifier"
            }
          ]
        },
        "reason": "Verifier update history is emitted by constructor initialization and updateVerifier (onlyOwner) through UpdateVerifier."
      },
      {
        "id": "latestVerifier",
        "covers": [
          "latestVerifier(uint256)"
        ],
        "fetch": {
          "kind": "callEach",
          "method": "latestVerifier(uint256)",
          "keys": {
            "from": "$step.updateVerifier"
          }
        },
        "use": "map@1",
        "reason": "latestVerifier is initialized by the constructor and written by updateVerifier (onlyOwner), both of which emit UpdateVerifier with every version key."
      },
      {
        "id": "legacyVerifiersLength",
        "covers": [
          "legacyVerifiersLength(uint256)"
        ],
        "fetch": {
          "kind": "callEach",
          "method": "legacyVerifiersLength(uint256)",
          "keys": {
            "from": "$step.updateVerifier"
          }
        },
        "use": "map@1",
        "reason": "legacyVerifiers is written only by updateVerifier (onlyOwner), which emits UpdateVerifier with every version key."
      }
    ],
    "skips": [
      {
        "item": "getVerifier(uint256,uint256)",
        "reason": "computation"
      },
      {
        "item": "legacyVerifiers(uint256,uint256)",
        "reason": "unbounded"
      }
    ]
  },
  "provenance": {
    "source": "model",
    "createdAt": "2026-09-22T12:35:23.488Z",
