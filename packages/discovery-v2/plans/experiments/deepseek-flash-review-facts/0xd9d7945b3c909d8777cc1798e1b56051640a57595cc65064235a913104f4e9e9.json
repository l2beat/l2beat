              "event": "SetValidKeyset"
            }
          ]
        },
        "reason": "setValidKeyset (onlyRollupOwner) emits SetValidKeyset for every keyset hash ever registered, giving the complete key domain of dasKeySetInfo (invalidateKeysetHash only flips a key already announced here)"
      },
      {
        "id": "dasKeySetInfo",
        "covers": [
          "dasKeySetInfo(bytes32)",
          "getKeysetCreationBlock(bytes32)",
          "isValidKeysetHash(bytes32)"
        ],
        "fetch": {
          "kind": "callEach",
          "method": "dasKeySetInfo(bytes32)",
          "keys": {
            "from": "$step.setValidKeyset"
          }
        },
        "use": "map@1",
        "reason": "dasKeySetInfo is written only by setValidKeyset and invalidateKeysetHash (onlyRollupOwner), which emit SetValidKeyset and InvalidateKeyset, so its full key set is enumerated from those logs"
      }
    ],
    "skips": [
