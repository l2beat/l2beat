{
  "plan": {
    "version": 1,
    "contract": "PauseController",
    "steps": [
      {
        "id": "lastUnpauseTime",
        "fetch": {
          "kind": "logs",
          "events": [
            "Unpause",
            "ResetPauseCooldownPeriod"
          ]
        },
        "use": "set@1",
        "args": {
          "key": "component",
          "add": [
            {
              "event": "Unpause"
            },
            {
              "event": "ResetPauseCooldownPeriod"
            }
          ]
        },
        "reason": "lastUnpauseTime is written only by unpause and resetPauseCooldownPeriod (both onlyOwner), which emit Unpause and ResetPauseCooldownPeriod naming the component key"
      },
      {
        "id": "getLastUnpauseTime",
        "covers": [
          "getLastUnpauseTime(address)"
        ],
        "fetch": {
          "kind": "callEach",
          "method": "getLastUnpauseTime(address)",
          "keys": {
            "from": "$step.lastUnpauseTime"
          }
        },
        "use": "map@1",
        "reason": "getLastUnpauseTime reads lastUnpauseTime[component] for every component named by the Unpause and ResetPauseCooldownPeriod events"
      }
    ],
