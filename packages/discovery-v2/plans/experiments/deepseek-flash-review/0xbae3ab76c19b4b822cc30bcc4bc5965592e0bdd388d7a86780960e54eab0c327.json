    "steps": [
      {
        "id": "isSequencer",
        "covers": [
          "isSequencer(address)"
        ],
        "fetch": {
          "kind": "logs",
          "events": [
            "UpdateSequencer"
          ]
        },
        "use": "set@1",
        "args": {
          "key": "account",
          "add": [
            {
              "event": "UpdateSequencer",
              "when": {
                "arg": "status",
                "equals": true
              }
            }
          ],
          "remove": [
            {
              "event": "UpdateSequencer",
              "when": {
                "arg": "status",
                "equals": true,
                "negate": true
              }
            }
          ]
        },
        "reason": "isSequencer is written only by addSequencer/removeSequencer (onlyOwner), which emit UpdateSequencer"
      },
      {
        "id": "isProver",
        "covers": [
          "isProver(address)"
        ],
        "fetch": {
          "kind": "logs",
          "events": [
            "UpdateProver"
          ]
        },
        "use": "set@1",
        "args": {
          "key": "account",
          "add": [
            {
              "event": "UpdateProver",
              "when": {
                "arg": "status",
                "equals": true
              }
            }
          ],
          "remove": [
            {
              "event": "UpdateProver",
              "when": {
                "arg": "status",
                "equals": true,
                "negate": true
              }
            }
          ]
        },
        "reason": "isProver is written only by addProver/removeProver (onlyOwner), which emit UpdateProver"
      },
      {
        "id": "revertBatch",
        "fetch": {
          "kind": "logs",
          "events": [
            "RevertBatch(uint256,bytes32)",
            "RevertBatch(uint256,uint256)"
          ]
        },
        "use": "count@1",
        "args": {
          "events": [
            "RevertBatch"
          ]
        },
        "reason": "the reverted batches have no getter and are observable only through the RevertBatch events emitted by revertBatch (onlyOwner) and commitAndFinalizeBatch"
      }
    ],
    "skips": [
