{
  "name": "@l2beat/test-utils",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "./build/setup.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./setup": {
      "types": "./build/setup.d.ts",
      "default": "./build/setup.js"
    },
    "./postgres": {
      "types": "./build/postgres.d.ts",
      "default": "./build/postgres.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf build *.tsbuildinfo",
    "format:fix": "biome format --write .",
    "format": "biome format .",
    "lint:fix": "biome check --formatter-enabled=false --write .",
    "lint": "biome check --formatter-enabled=false .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@l2beat/typescript-config": "workspace:*",
    "@l2beat/vitest-config": "workspace:*",
    "ts-morph": "^28.0.0"
  }
}
