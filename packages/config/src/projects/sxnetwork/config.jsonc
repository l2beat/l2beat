{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "sxnetwork",
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": [
    "eth:0xa104C0426e95a5538e89131DbB4163d230C35f86",
    "eth:0xB4968C66BECc8fb4f73b50354301c1aDb2Abaa91"
  ],
  "names": {
    "eth:0xddb901e4E9A2e659aa1d6476d5D7A2833E7c3dFa": "SxNetworkMultisig",
    "eth:0xa4C325e25215C1fB2405EB28d81d2dFdbfC8D24C": "CalderaMultisig"
  },
  "overrides": {
    "eth:0x44Ec40D86b4643Bd5110ED07BE188F8473Ad2d3a": {
      "fields": {
        // Seeds the L2's ArbOS 61 transaction-filtering precompile (0x..74) as a
        // relative and applies the shared orbitstack/ArbFilteredTransactionsManager
        // template. Hosted on the UpgradeExecutor because it owns the L2 chain
        // (through retryables) and so controls who can filter.
        "transactionFilteringPrecompile": {
          "handler": {
            "type": "hardcoded",
            "value": "sxr:0x0000000000000000000000000000000000000074"
          },
          "template": "orbitstack/ArbFilteredTransactionsManager"
        }
      }
    },
    "sxr:0x0000000000000000000000000000000000000074": {
      // Precompile with a 0xfe stub as code; point at the Nitro implementation.
      // Its integrity is covered by the RollupProxy wasmModuleRoot.
      "manualSourcePaths": {
        "sxr:0x0000000000000000000000000000000000000074": "https://github.com/OffchainLabs/nitro/blob/v3.11.0/precompiles/ArbFilteredTransactionsManager.go"
      }
    }
  }
}
