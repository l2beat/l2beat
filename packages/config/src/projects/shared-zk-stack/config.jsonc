{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "shared-zk-stack",
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": [
    "eth:0x303a465B659cBB0ab36eE643eA362c509EEb5213", // BridgeHub
    "eth:0xE689e79a06D3D09f99C21E534cCF6a8b7C9b3C45",
    "eth:0x72213dfe8CA61B0A782970dCFebFb877778f9119",
    // rollup DA contracts of the v31 diamond cut, used by the chains that applied it
    "eth:0xc16161C7f704388285fE58db287F6216a350dAFA",
    "eth:0x1c715018c5565eaCC758236D4A9A760162a84Cbd",
    // MultisigCommitter: shared ValidatorTimelock of the ZKsync OS ChainTypeManager, owned by the ProtocolUpgradeHandler since v31.
    // The ChainTypeManager template ignores validatorTimelockPostV29 (normally configured per chain) and no project tracks the ZKsync OS chains.
    "eth:0x18cC381705761aa2d2e8ea62888a4029A0fAd3aB",

    "zksync:0x76705327e682F2d96943280D99464Ab61219e34f",
    "zksync:0xEEEa739a8b6fB1b8f703E23C9Be03CeeA643b160"
  ],
  "names": {
    "eth:0x2cf3bD6a9056b39999F3883955E183F655345063": "EraChainAdminProxy",
    "eth:0x085b8B6407f150D62adB1EF926F7f304600ec714": "ProtocolTimelockController(L2->L1)",
    "eth:0x303a465B659cBB0ab36eE643eA362c509EEb5213": "BridgeHub",
    // replaced in the ProtocolUpgradeHandler by v31, but still the VETO_GUARDIAN of ZkTokenGovernor and ZkGovOpsGovernor
    "eth:0x600dA620Ab29F41ABC6596a15981e14cE58c86b8": "LegacyGuardians",
    "eth:0xBfaa733261500101996A10A231794263567d52ab": "ZKsyncOSServerNotifier",
    "eth:0x871faE53b5db4989023936f46e2b1aE161B20E15": "ZKsyncOSL1GenesisUpgrade",
    "eth:0x853bEB619c14d6435b770c35642862B8e91a3d08": "L1GenesisUpgrade",
    // v31: per-chain escrow balances moved out of the L1NativeTokenVault
    "eth:0x7fd8B995fc27aD7de97853e65B17CaCfc0a573Cc": "L1AssetTracker",
    "eth:0x419A453e690CEac6E57C7798a375cbB2454dd919": "ChainRegistrationSender",
    // Priority Mode validators of the two ChainTypeManagers
    "eth:0xE220059BBA4684BF2Cf0B9E6E5A9DF94D9fb90E9": "EraPermissionlessValidator",
    "eth:0x8509eA34177B051110826A36621C1C52C9752CAA": "ZKsyncOSPermissionlessValidator",
    // verifiers registered in the ChainTypeManagers for the current protocol versions. Versioned names: the chain
    // projects still discover their current (older) verifiers under the unversioned names and look them up by name.
    "eth:0x5d5d33b16d9e79d9d9b8196ec760e70a31a44711": "EraDualVerifier_v33",
    "eth:0xc16161C7f704388285fE58db287F6216a350dAFA": "RollupDAManager_v31",
    "eth:0x1c715018c5565eaCC758236D4A9A760162a84Cbd": "RollupL1DAValidator_v31",
    "eth:0x870C0A2bd4f253dd867b2239a0d8d86f87D64128": "EraVerifierFflonk_v33",
    "eth:0x71ef07eB0BaFE5342f7d9513Fe7A544Dc90B8001": "EraVerifierPlonk_v33",
    "eth:0x433b6ff15824806c8c14ece4a6fe1f1909f7da2f": "ZKsyncOSDualVerifier_v31",
    "eth:0x77EE31260Bed9e6879ffBb66e8ABB3EBCE0B2aBF": "ZKsyncOSVerifierFflonk_v31",
    "eth:0x47a250D4Eb7F1bf9B4De89c31228DB0E938FF415": "ZKsyncOSVerifierPlonk_v31",

    "zksync:0x5A7d6b2F92C77FAD6CCaBd7EE0624E64907Eaf3E": "ZkToken",
    "zksync:0xdB1E46B448e68a5E35CB693a99D59f784aD115CC": "ZkTokenProxyAdmin",
    "zksync:0xb83FF6501214ddF40C91C9565d095400f3F45746": "ZkTokenGovernor",
    "zksync:0xe5d21A9179CA2E1F0F327d598D464CcF60d89c3d": "ZkTokenTimelockController",
    "zksync:0x76705327e682F2d96943280D99464Ab61219e34f": "ZkProtocolGovernor",
    "zksync:0x085b8B6407f150D62adB1EF926F7f304600ec714": "ProtocolTimelockController",
    "zksync:0xEEEa739a8b6fB1b8f703E23C9Be03CeeA643b160": "ZkGovOpsGovernor",
    "zksync:0xC9E442574958f96C026DeF9a50C3236cab17428a": "GovOpsTimelockController"
  },
  "overrides": {
    // sub-ms spam
    "eth:0x13f07d9BF17615f6a17F272fe1A913168C275A66": { "category": "spam" },
    "eth:0x34Ea62D4b9bBB8AD927eFB6ab31E3Ab3474aC93a": { "category": "spam" },
    "eth:0x35eA56fd9eAd2567F339Eb9564B6940b9DD5653F": { "category": "spam" },
    "eth:0x3888777686F0b0d8c3108fc22ad8DE9E049bE26F": { "category": "spam" },
    "eth:0x69462a81ba94D64c404575f1899a464F123497A2": { "category": "spam" },
    "eth:0x725065b4eB99294BaaE57AdDA9c32e42F453FA8A": { "category": "spam" },
    "eth:0x84BF0Ac41Eeb74373Ddddae8b7055Bf2bD3CE6E0": { "category": "spam" },
    "eth:0x9B39Ea22e838B316Ea7D74e7C4B07d91D51ccA88": { "category": "spam" },
    "eth:0x9B8Be3278B7F0168D82059eb6BAc5991DcdfA803": { "category": "spam" },
    "eth:0xB7aC3A79A23B148c85fba259712c5A1e7ad0ca44": { "category": "spam" },
    "eth:0xc3Abc9f9AA75Be8341E831482cdA0125a7B1A23e": { "category": "spam" },
    "eth:0xFB90Da9DC45378A1B50775Beb03aD10C7E8DC231": { "category": "spam" },
    "eth:0x015318c16AE443a20DE0A776dB06a59F0D279057": { "category": "spam" },
    "eth:0x178D8Eb1A1fb81B5102808A83318Bb04C6a9fC6D": { "category": "spam" },
    "eth:0x2A90830083C5Ca1f18d7AA7fCDC2998f93475384": { "category": "spam" },
    "eth:0x538612F6eba6ff80FBD95D60dCDee16b8FfF2c0f": { "category": "spam" },
    "eth:0x55c671BcE13120387Ded710A1d1b80C0e3d8E857": { "category": "spam" },
    "eth:0x590926dBCDfD19627c3BbD2A6Eb96DeC7a3AbF69": { "category": "spam" },
    "eth:0x6D26874130A174839b9cd8CB87Ed4E09D0c1a5f0": { "category": "spam" },
    "eth:0xCe7a3dFcc35602155809920Ff65e093aa726f6cf": { "category": "spam" },

    "eth:0xC2a36181fB524a6bEfE639aFEd37A67e77d62cf1": {
      // ProxyAdmin (owned by ProtocolUpgradeHandler): upgrade admin of BridgeHub, L1AssetRouter, L1NativeTokenVault, L1Nullifier, ChainAssetHandler, MessageRoot, CTM -> upgrading any of these steals/freezes Era's escrowed funds
      "critical": true
    },
    "eth:0x1e4c534e7ce1FF5621Ea506D99b367D7d8EFbE3e": {
      // ProxyAdmin of the ProtocolUpgradeHandler proxy itself -> upgrading PUH grants full ownership of the shared bridge/governance system
      "critical": true
    },
    "zksync:0x085b8B6407f150D62adB1EF926F7f304600ec714": {
      // ProtocolTimelockController: the L2_PROTOCOL_GOVERNOR sender trusted by the ProtocolUpgradeHandler to start (queue) protocol upgrades of Era's Diamond and the shared escrows (0s min delay, self-administered)
      "critical": true
    },

    "zksync:0x76705327e682F2d96943280D99464Ab61219e34f": {
      // ZkProtocolGovernor: sole proposer/executor/canceller/admin on the ProtocolTimelockController, i.e. the canonical originator of every standard protocol upgrade (ZIP) reaching Era's L1 contracts
      "critical": true,
      "description": "Main Governance contract allowing for token voting (simple majority) with the ZK token through delegates. This contract is used for protocol upgrade proposals (ZIPs) that start on ZKsync Era, go through Ethereum Layer 1 and can - from there - target all L1 and L2 contracts. At least {{proposalThreshold_MTokens}}M ZK tokens are necessary to start a proposal and a {{currentQuorum_MTokens}}M quorum of voted tokens must be met to succeed."
    },
    "zksync:0x5A7d6b2F92C77FAD6CCaBd7EE0624E64907Eaf3E": {
      // ZK token: its voting power controls the protocol governor, and its minter administration is controlled by token governance.
      // Critical since token voting became binding for the shared L1 contracts: the first ProtocolUpgradeHandler (L2_PROTOCOL_GOVERNOR = timelock of the ZkProtocolGovernor) accepted ownership of BridgeHub/CTM/L1SharedBridge in tx 0x04252ef77e208a233dfe0e7a3c70a04c8c8e95364c6ec67e5dd4ca7299bad8cb. The 2024-06-10 token upgrade predates this and is not a change of the perimeter.
      "critical": { "sinceTimestamp": 1726123295 },
      "fields": {
        "accessControl": {
          "edit": [
            "set",
            ["DEFAULT_ADMIN_ROLE", "members"],
            [
              "map",
              [
                "if",
                ["=", "zksync:0xF41EcA3047B37dc7d88849de4a4dc07937Ad6bc4"],
                ["format", "UndoL2Alias"]
              ]
            ]
          ]
        },
        "DefaultAdmin": {
          "edit": [
            "map",
            [
              "if",
              ["=", "zksync:0xF41EcA3047B37dc7d88849de4a4dc07937Ad6bc4"],
              ["format", "UndoL2Alias"]
            ]
          ]
        }
      }
    },
    "zksync:0xdB1E46B448e68a5E35CB693a99D59f784aD115CC": {
      // Upgrade admin of the ZK token proxy.
      "critical": true,
      "fields": {
        "owner": {
          "edit": [
            "if",
            ["=", "zksync:0xF41EcA3047B37dc7d88849de4a4dc07937Ad6bc4"],
            ["format", "UndoL2Alias"]
          ]
        }
      }
    },
    "zksync:0xb83FF6501214ddF40C91C9565d095400f3F45746": {
      "critical": true,
      "description": "Governance contract allowing for token voting (simple majority) with the ZK token through delegates. This contract is used for Token Program Proposals (TPPs) usually targeting the ZK token on ZKsync Era. At least {{proposalThreshold_MTokens}}M ZK tokens are necessary to start a proposal (for delegates) and a {{currentQuorum_MTokens}}M quorum of voted tokens must be met to succeed.",
      "fields": {
        "isProposeGuarded": { "severity": "HIGH" },
        "PROPOSE_GUARDIAN": {
          "permissions": [
            {
              "type": "interact",
              "description": "make direct proposals without owning ZK tokens. In propose-guarded mode, this address is the ONLY allowed proposer. Propose-guarded mode is currently set to {{isProposeGuarded}}."
            }
          ],
          "edit": [
            "if",
            ["=", "zksync:0xcd2753Bd3829dfeC575AFC3816d4899CD103C62D"],
            ["format", "UndoL2Alias"]
          ]
        },
        "VETO_GUARDIAN": {
          "permissions": [
            {
              "type": "interact",
              "description": "cancel proposals while they are pending (after having been proposed) or active (during the voting period)."
            }
          ],
          "edit": [
            "if",
            ["=", "zksync:0x711ea620AB29f41AbC6596a15981e14ce58C97c9"],
            ["format", "UndoL2Alias"]
          ]
        }
      }
    },
    "zksync:0xe5d21A9179CA2E1F0F327d598D464CcF60d89c3d": {
      // Timelock that executes token-governance decisions, including control of token minters.
      "critical": true
    },
    "zksync:0xEEEa739a8b6fB1b8f703E23C9Be03CeeA643b160": {
      "description": "Governance contract allowing for token voting (simple majority) with the ZK token through delegates. This contract is used for Governance Advisory Proposals (GAPs), which are advisory and execute through the GovOpsTimelockController. At least {{proposalThreshold_MTokens}}M ZK tokens are necessary to start a proposal and a {{currentQuorum_MTokens}}M quorum of voted tokens must be met to succeed.",
      "fields": {
        "VETO_GUARDIAN": {
          "permissions": [
            {
              "type": "interact",
              "description": "cancel proposals while they are pending (after having been proposed) or active (during the voting period)."
            }
          ],
          "edit": [
            "if",
            ["=", "zksync:0x711ea620AB29f41AbC6596a15981e14ce58C97c9"],
            ["format", "UndoL2Alias"]
          ]
        }
      }
    }
  }
}
