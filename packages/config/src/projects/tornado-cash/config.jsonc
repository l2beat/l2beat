  // Ossification perimeter: the 19 immutable pools of the InstanceRegistry,
  // five unregistered ETH pools with the same code (deployed 2026-10-15 without
  // an operator), their Verifier and the MiMCHasher. The pools have no admin (the legacy operator renounced in May
  // 2020), so verifier and hasher can no longer change. Governance (TORN, Governance,
  // InstanceRegistry, RelayerRegistry, TornadoRouter, trees and mining) can only
  // gate the optional router path and relayers, never pool funds, proofs or
  // direct withdrawals (cf. the May 2023 governance takeover, which left the
  // pools untouched), so it is not critical.
  "overrides": {
    "eth:0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e": {
      "ignoreDiscovery": true
    },
    // Governance owns tornadocash.eth. These fields watch the app it pins.
    "eth:0x5efda50f22d34F262c29268506C5Fa42cB56A1Ce": {
      "fields": {
        "appEnsResolver": {
          "description": "Resolver set for tornadocash.eth in the ENS registry.",
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "address": "eth:0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e",
            "method": "function resolver(bytes32 node) view returns (address)",
            "args": [
              "0xe6ae31d630cc7a8279c0f1c7cbe6e7064814c47d1785fa2703d9ae511ee2be0c"
            ],
            "ignoreRelative": true
          }
        },
        "appContenthash": {
          "description": "IPFS contenthash of tornadocash.eth, the app that governance pins.",
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "address": "{{ appEnsResolver }}",
            "method": "function contenthash(bytes32 node) view returns (bytes)",
            "args": [
              "0xe6ae31d630cc7a8279c0f1c7cbe6e7064814c47d1785fa2703d9ae511ee2be0c"
            ]
          }
        }
      }
    },
    "eth:0x83584f83f26aF4eDDA9CBe8C730bc87C364b28fe": {
      "description": "MiMC hasher used by every Tornado pool for commitment-tree operations (linked library in the 2019 pools, constructor argument in the 2021 pools), manually verified against the pinned Tornado circomlib generator.",
      "critical": true,
      "category": "core",
      "manualSourcePaths": {
        "eth:0x83584f83f26aF4eDDA9CBe8C730bc87C364b28fe": "https://github.com/tornadocash/circomlib/blob/c372f14d324d57339c88451834bf2824e73bbdbc/src/mimcsponge_gencontract.js"
      },
      "references": [
        {
          "text": "Tornado Cash hasher build script",
          "href": "https://github.com/tornadocash/tornado-core/blob/master/scripts/compileHasher.js"
        }
      ]
    },
    // Both Poseidon hashers equal poseidonContract.createCode(n) of the Tornado circomlib fork
    // at 3b492f9 (pinned by tornado-anonymity-mining) byte for byte, after the 12-byte
    // deployment loader. The fork uses 35 partial rounds, unlike iden3 circomlib's 56-57.
    "eth:0xD82ed8786D7c69DC7e052F7A542AB047971E73d2": {
      "description": "Anonymity Mining - Poseidon hasher with three inputs (Tornado's 35-partial-round variant) used by TornadoTreesV1 to hash deposit and withdrawal leaves, manually verified against the pinned Tornado circomlib generator.",
      "category": "bridge-external",
      "manualSourcePaths": {
        "eth:0xD82ed8786D7c69DC7e052F7A542AB047971E73d2": "https://github.com/tornadocash/circomlib/blob/3b492f9801573eebcfe1b6c584afe8a3beecf2b4/src/poseidon_gencontract.js"
      },
      "references": [
        {
          "text": "Tornado anonymity mining circomlib pin",
          "href": "https://github.com/tornadocash/tornado-anonymity-mining/blob/95f6bbfe17498f3a77b157652274b27a5e31fed0/package.json"
        }
      ]
    },
    "eth:0x94C92F096437ab9958fC0A37F09348f30389Ae79": {
      "description": "Anonymity Mining - Poseidon hasher with two inputs (Tornado's 35-partial-round variant) used by the legacy DepositTree and WithdrawalTree to hash tree nodes, manually verified against the pinned Tornado circomlib generator.",
      "category": "bridge-external",
      "manualSourcePaths": {
        "eth:0x94C92F096437ab9958fC0A37F09348f30389Ae79": "https://github.com/tornadocash/circomlib/blob/3b492f9801573eebcfe1b6c584afe8a3beecf2b4/src/poseidon_gencontract.js"
      },
      "references": [
        {
          "text": "Tornado anonymity mining circomlib pin",
          "href": "https://github.com/tornadocash/tornado-anonymity-mining/blob/95f6bbfe17498f3a77b157652274b27a5e31fed0/package.json"
        }
      ]
    },
