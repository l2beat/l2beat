{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "rocketpool",
  "import": ["../globalConfig.jsonc"],
  "maxAddresses": 200,
  "types": {
    // Fractions are stored with 18 decimals and rendered as percentages, so
    // they are un-decimaled by 16 rather than 18.
    "Undecimal16": {
      "typeCaster": "Undecimal",
      "arg": { "decimals": 16 }
    }
  },
  "initialAddresses": [
    // RocketStorage. Every other protocol contract is registered here under a
    // name hash and is reachable only by resolving that hash, so this is the
    // single entrypoint to the graph.
    "eth:0x1d8f8f00cfa6758d7bE78336684788Fb0ee0Fa46"
  ],
  "names": {
    "eth:0x1d8f8f00cfa6758d7bE78336684788Fb0ee0Fa46": "RocketStorage",
    // Override the two globalTokens display names so the entries keep their
    // contract names, which is what the page description resolves them by.
    "eth:0xae78736Cd615f374D3085123A210448E74Fc6393": "RocketTokenRETH",
    "eth:0xD33526068D116cE69F19A9ee46F0bd304F21A51f": "RocketTokenRPL",
    // The security council's only seat.
    "eth:0x6C565aF34f15dE064b56afEdF7B0F59C15bB20FE": "SecurityCouncilSafe",
    // Replacement verifier from the September 2026 hotfix, still a pending
    // upgrade in RocketDAONodeTrustedUpgrade and not yet the registered one.
    // When the upgrade executes, swap the names so the registered contract
    // keeps the canonical RocketDAOProtocolVerifier name.
    "eth:0xc4D85aA3e318c38005F6D73cC53E5A2b4223723a": "RocketDAOProtocolVerifierV2"
  }
}
