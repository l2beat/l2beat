{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "zeronetwork",
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": ["eth:0xdbD849acC6bA61F461CB8A41BBaeE2D673CA02d9"],
  "names": {
    "eth:0xdbD849acC6bA61F461CB8A41BBaeE2D673CA02d9": "Diamond",
    "eth:0xCA8faaF5BA885fEC8C2c8CD49bADAa7589D173b3": "ZeroNetworkZkEvmAdmin",
    "eth:0x5D8ba173Dc6C3c90C8f7C04C9288BeF5FDbAd06E": "ValidatorTimelock2"
  },
  "overrides": {
    "eth:0x2e5110cF18678Ec99818bFAa849B8C881744b776": {
      "fields": {
        "daTrackingConfig": {
          // Full DA tracking era history for the backend indexer. Append-only:
          // when the chain migrates to a new ValidatorTimelock, close the last
          // era with untilBlock, append a new one and move this field to the
          // new timelock's overrides - never edit or remove existing eras.
          "handler": {
            "type": "zkStackDaTracking",
            "l2ChainId": 543210,
            "eras": [
              {
                // sinceBlock defaults to the first ValidatorAdded for this chain
                "inbox": "eth:0x8c0Bfc04AdA21fd496c55B8C50331f904306F564",
                "validatorSource": "legacyEvents",
                "untilBlock": 25482106 // last batch before the v29 upgrade
              },
              {
                "inbox": "eth:0x2e5110cF18678Ec99818bFAa849B8C881744b776",
                "validatorSource": "crossChainRoles",
                "chainAddress": "eth:0xdbD849acC6bA61F461CB8A41BBaeE2D673CA02d9",
                "sinceBlock": 25482106 // v29 upgrade
              }
            ]
          }
        },
        "validatorsVTLFullAC": {
          // giving the permission to the entire AC, because in practice the actor(s) have all roles
          "handler": {
            "type": "crossChainAccessControl",
            "pickChainAddress": "eth:0xdbD849acC6bA61F461CB8A41BBaeE2D673CA02d9"
          },
          "permissions": [
            {
              "type": "interact",
              "description": "Permissioned to call the functions to commit, prove, execute and revert L2 batches through the ValidatorTimelock in the main Diamond contract."
            }
          ]
        },
        "validatorsVTL": {
          // for backwards compatibility with the zkstack template
          "handler": {
            "type": "crossChainAccessControl",
            "pickChainAddress": "eth:0xdbD849acC6bA61F461CB8A41BBaeE2D673CA02d9"
          },
          "edit": ["get", "EXECUTOR_ROLE", "members"]
        }
      }
    },
    "eth:0x8c0Bfc04AdA21fd496c55B8C50331f904306F564": {
      "fields": {
        "validatorsVTL": {
          "handler": {
            "type": "event",
            "select": ["validator"],
            "add": {
              "event": "event ValidatorAdded(uint256 indexed chainId, address validator)",
              "where": ["=", "#chainId", 543210]
            },
            "remove": {
              "event": "event ValidatorRemoved(uint256 indexed chainId, address validator)",
              "where": ["=", "#chainId", 543210]
            }
          },
          "permissions": [
            {
              "type": "interact",
              "description": "Permissioned to call the functions to commit, prove, execute and revert L2 batches through the ValidatorTimelock in the main Diamond contract."
            }
          ]
        }
      }
    },
    "eth:0x5D8ba173Dc6C3c90C8f7C04C9288BeF5FDbAd06E": {
      "category": "spam",
      "fields": {
        "validatorsVTL": {
          "handler": {
            "type": "event",
            "select": ["validator"],
            "add": {
              "event": "event ValidatorAdded(uint256 indexed chainId, address validator)",
              "where": ["=", "#chainId", 543210]
            },
            "remove": {
              "event": "event ValidatorRemoved(uint256 indexed chainId, address validator)",
              "where": ["=", "#chainId", 543210]
            }
          },
          "permissions": [
            {
              "type": "interact",
              "description": "Permissioned to call the functions to commit, prove, execute and revert L2 batches through the ValidatorTimelock in the main Diamond contract."
            }
          ]
        }
      }
    }
  }
}
