{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "sophon",
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": [
    "eth:0x05eDE6aD1f39B7A16C949d5C33a0658c9C7241e3",
    "eth:0xf553E6D903AA43420ED7e3bc2313bE9286A8F987"
  ],
  "names": {
    "eth:0x05eDE6aD1f39B7A16C949d5C33a0658c9C7241e3": "Diamond",
    "eth:0xE1eeA4D6443b19D373Fe99De838b930Ef0ac2Ad3": "SophonZkEvmAdmin",
    "eth:0xe4644b6d106A18062344c0A853666bc0B8f052d1": "SophonChainAdminMultisig"
  },
  "overrides": {
    // EIP-7702 EOA delegating to a SmartWallet (0xe40ccB2D…).
    // getExpiration/getHook/isAdmin/isSettingsExpired are pure decoders of a
    // `settings` word that never revert, so they overflow as arrays;
    // getImmutableFactory/proxiableUUID revert when called on the EOA.
    "eth:0x891F19CdefBce82e2F39f34C2322526c01E7A845": {
      "ignoreMethods": [
        "getExpiration",
        "getHook",
        "isAdmin",
        "isSettingsExpired",
        "getImmutableFactory",
        "proxiableUUID"
      ]
    },
    "eth:0x2e5110cF18678Ec99818bFAa849B8C881744b776": {
      "fields": {
        "validatorsVTLFullAC": {
          // giving the permission to the entire AC, because in practice the actor(s) have all roles
          "handler": {
            "type": "crossChainAccessControl",
            "pickChainAddress": "eth:0x05eDE6aD1f39B7A16C949d5C33a0658c9C7241e3"
          },
          // UPGRADER_ROLE is tracked separately in upgraderVTL
          "edit": ["delete", "UPGRADER_ROLE"],
          "permissions": [
            {
              "type": "interact",
              "description": "Permissioned to call the functions to commit, prove, execute and revert L2 batches through the ValidatorTimelock in the main Diamond contract."
            }
          ]
        },
        "validatorsVTL": {
          // for backwards compatibility with the zkstack template
          "handler": {
            "type": "crossChainAccessControl",
            "pickChainAddress": "eth:0x05eDE6aD1f39B7A16C949d5C33a0658c9C7241e3"
          },
          "edit": ["get", "EXECUTOR_ROLE", "members"]
        },
        "upgraderVTL": {
          // `pick` instead of `get` / `pickRoleMembers` so that the field does not fail while the role has no members
          "handler": {
            "type": "crossChainAccessControl",
            "pickChainAddress": "eth:0x05eDE6aD1f39B7A16C949d5C33a0658c9C7241e3"
          },
          "edit": ["pick", "UPGRADER_ROLE"],
          "permissions": [
            {
              "type": "interact",
              "description": "Permissioned to call `upgradeChainFromVersion()` through the ValidatorTimelock, executing the protocol upgrade (diamond cut) of the main Diamond contract that is pre-approved for its current protocol version in the ChainTypeManager."
            }
          ]
        },
        "executionDelaySophon": {
          // effective delay for Sophon: max(executionDelay, chainExecutionDelay(Sophon diamond))
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "method": "getExecutionDelay",
            "args": ["0x05eDE6aD1f39B7A16C949d5C33a0658c9C7241e3"]
          }
        },
        "executionDelaySophon_fmt": {
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "method": "getExecutionDelay",
            "args": ["0x05eDE6aD1f39B7A16C949d5C33a0658c9C7241e3"]
          },
          "edit": ["format", "FormatSeconds"]
        }
      }
    }
  }
}
