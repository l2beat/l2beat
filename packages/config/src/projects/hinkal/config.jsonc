    "eth:0xeC138727d8779E61054DD5DFe158b77B6Ef28702": "SwapVerifierEVM2x2x1",
    "eth:0x054388101D8a799541B4E094bBEb6Dff783e2C76": "SwapVerifierEVM2x6x1",
    "eth:0xf7A8BB4A259b5974dC0a72f251c41d9E98D333Ee": "SwapVerifierEVM3x2x1",
    "eth:0x7b479ff8B48E818a285963D8b59508Aa3c65729C": "SwapVerifierEVM3x6x1",
    "eth:0xa7997B7b18BB23b32a4f6c6074B0FBFA0b7e17E5": "SwapGroth16VerifierEVM1x2x1",
    "eth:0x2592E6C9e5A493598bd29FeC0CDdCeD99227D0B6": "SwapGroth16VerifierEVM1x6x1",
    "eth:0x04864a507102C7c63Cc6d798Afc4d1fE3eB05131": "SwapGroth16VerifierEVM2x2x1",
    "eth:0x8391788640Bc7002A97ab218C899D6567C3114E7": "SwapGroth16VerifierEVM2x6x1",
    "eth:0x14eBe78aE7Cf7e4EED6dF7eb837C29e17F376cab": "SwapGroth16VerifierEVM3x2x1",
    "eth:0x0B9efB1e28a570fb930432d542f4Ee5332dc7b11": "SwapGroth16VerifierEVM3x6x1"
  },
  "overrides": {
    // OpenZeppelin v4 timelock: TIMELOCK_ADMIN_ROLE, not DEFAULT_ADMIN_ROLE, administers its
    // roles, so the global template's defaultAdminAC is empty here.
    "eth:0xF04310839973454155d9886a4023451F8D3Db7D0": {
      "critical": true,
      "fields": {
        "timelockAdminAC": {
          "description": "Addresses with TIMELOCK_ADMIN_ROLE.",
          "severity": "MEDIUM",
          "handler": {
            "type": "accessControl",
            "pickRoleMembers": "TIMELOCK_ADMIN_ROLE"
          },
          "permissions": [
            {
              "type": "interact",
              "description": "grant and revoke the proposer, executor, canceller and timelock admin roles without delay."
            }
          ]
        }
      }
    },
    "eth:0xa7997B7b18BB23b32a4f6c6074B0FBFA0b7e17E5": {
      "description": "Unverified Groth16 verifier behind SwapVerifierEVM1x2x1.",
      "critical": true
    },
    "eth:0x2592E6C9e5A493598bd29FeC0CDdCeD99227D0B6": {
      "description": "Unverified Groth16 verifier behind SwapVerifierEVM1x6x1.",
      "critical": true
    },
    "eth:0x04864a507102C7c63Cc6d798Afc4d1fE3eB05131": {
      "description": "Unverified Groth16 verifier behind SwapVerifierEVM2x2x1.",
      "critical": true
    },
    "eth:0x8391788640Bc7002A97ab218C899D6567C3114E7": {
      "description": "Unverified Groth16 verifier behind SwapVerifierEVM2x6x1.",
      "critical": true
    },
    "eth:0x14eBe78aE7Cf7e4EED6dF7eb837C29e17F376cab": {
      "description": "Unverified Groth16 verifier behind SwapVerifierEVM3x2x1.",
      "critical": true
    },
    "eth:0x0B9efB1e28a570fb930432d542f4Ee5332dc7b11": {
      "description": "Unverified Groth16 verifier behind SwapVerifierEVM3x6x1.",
      "critical": true
    },
    "eth:0x795884e56c58D4fF1B26Eb1494F39FcfB38917a1": {
      "description": "Upgradeable Hinkal external action with an unverified implementation. Its verified predecessor runs a batch of arbitrary calls with shielded funds, optionally through a user's HinkalWallet, pays the relayer and returns the resulting token balances to Hinkal.",
      "critical": true,
      "fields": {
        "owner": {
          "description": "Owner of the Emporium logic.",
          "severity": "MEDIUM",
          "type": "PERMISSION",
          "handler": {
            "type": "call",
            "method": "function owner() view returns (address)",
            "args": []
          },
          "permissions": [
            {
              "type": "interact",
              "description": "change the helper that computes relayer fees and add addresses allowed to call runAction."
            }
          ]
        },
        "hinkalHelper": {
          "description": "Helper used to compute relayer fees, read from the EmporiumStorage namespace.",
          "handler": {
            "type": "storage",
            "slot": "0xf10f423c12af70b7aa31f6f1bd94310f38d85adab8d26b5c90b7f07c98bf0800",
            "returnType": "address"
          }
        }
      }
    },
    "eth:0xB2445b1f2fB462F4cF4EAdb90584ce19DBB0acfd": {
      "description": "Unverified factory of the deposit addresses that receive public transfers for a private account. Settling a deposit address moves its funds through the factory into Hinkal.",
      "critical": true
    },
    "eth:0xAEfBA46bbfE44943a36AE42F15EBc8D22Af4C1c9": {
      "description": "Unverified Poseidon hash contract with two inputs, used to build the commitment Merkle tree.",
      "critical": true
    },
    "eth:0x07BecBAE072343c08F1cbf0F3Ab682E5873a1026": {
      "description": "Unverified Poseidon hash contract with four inputs, used to hash onchain commitments.",
      "critical": true
    },
    "eth:0x3b98ca90b01fd48e6cD072Ba25189BD065bdAB21": {
      "description": "Unverified verifier adapter for 1x2x1 transactions through the Uniswap, Odos or OneInch external actions.",
      "critical": true,
      "fields": {
        "verifier": {
          "handler": {
            "type": "call",
            "method": "function verifier() view returns (address)",
            "args": []
          }
        }
      }
    },
    "eth:0x7A912eb23F6362069FFfAE94E211Cc07a09E3f4b": {
      "description": "Unverified verifier adapter for 1x6x1 transactions through the Uniswap, Odos or OneInch external actions.",
      "critical": true,
