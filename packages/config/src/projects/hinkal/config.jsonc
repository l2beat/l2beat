      }
    },
    "eth:0xf7A8BB4A259b5974dC0a72f251c41d9E98D333Ee": {
      "description": "Unverified verifier adapter for 3x2x1 transactions through the Uniswap, Odos or OneInch external actions.",
      "critical": true,
      "fields": {
        "verifier": {
          "handler": {
            "type": "call",
            "method": "function verifier() view returns (address)",
            "args": []
          }
        }
      }
    },
    "eth:0x7b479ff8B48E818a285963D8b59508Aa3c65729C": {
      "description": "Unverified verifier adapter for 3x6x1 transactions through the Uniswap, Odos or OneInch external actions.",
      "critical": true,
      "fields": {
        "verifier": {
          "handler": {
            "type": "call",
            "method": "function verifier() view returns (address)",
            "args": []
          }
        }
      }
    },
    "eth:0x65BA6e273f2f829B6eD14E064D97811580E2b607": {
      "description": "Unverified helper of the Hinkal contract. Its verified predecessor checks that the relayer is whitelisted and is tx.origin, checks calldata integrity and transaction dimensions, and builds the public inputs of the proof from the transaction data.",
      "critical": true,
      "category": "core",
      "fields": {
        "owner": {
          "description": "Owner of the helper.",
          "severity": "HIGH",
          "type": "PERMISSION",
          "handler": {
            "type": "call",
            "method": "function owner() view returns (address)",
            "args": []
          },
          "permissions": [
            {
              "type": "interact",
              "description": "add and remove whitelisted relayers, and change the Hinkal address the helper accepts calls from and binds proofs to."
            }
          ]
        },
        "hinkalAddress": {
          "description": "Hinkal contract that may call the helper. Its address is part of the public inputs of every proof.",
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "method": "function hinkalAddress() view returns (address)",
            "args": []
          }
        },
        "relayers": {
          "description": "Whitelisted relayers. A relayed transaction must be sent by one of them.",
          "severity": "MEDIUM",
          "type": "PERMISSION",
          "handler": {
            "type": "call",
            "method": "function getRelayStore() view returns (address[])",
            "args": []
          },
          "permissions": [
            {
              "type": "interact",
              "description": "submit relayed private transactions and withdrawals for users and collect the relayer fee."
            }
          ]
        },
        "MAX_LEAVES_PD": {
          "description": "Maximum number of commitments in one proofless deposit.",
          "handler": {
            "type": "call",
            "method": "function MAX_LEAVES_PD() pure returns (uint256)",
            "args": []
          }
        }
      }
    }
  }
