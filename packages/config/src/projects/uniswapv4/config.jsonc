{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "uniswapv4",
  "import": ["../globalConfig.jsonc"],
  "maxAddresses": 60,
  "types": {
    "Undecimal0": {
      "typeCaster": "Undecimal",
      "arg": { "decimals": 0 }
    }
  },
  "initialAddresses": [
    // Everything else is crawled from here: poolManager -> owner (Timelock ->
    // GovernorBravo -> UNI) and protocolFeeController (V4FeeAdapter ->
    // V4FeePolicy, TokenJar -> Firepit); V4_POSITION_MANAGER -> Permit2 and
    // PositionDescriptor (-> ProxyAdmin). Pools are storage entries in the
    // PoolManager, not contracts, so there is nothing per-pool to track.
    "eth:0x66a9893cC07D91D95644AEDD05D03f95e1dBA8Af" // UniversalRouter
  ],
  "names": {
    "eth:0x000000000004444c5dc75cB358380D2e3dE08A90": "PoolManager",
    "eth:0xbD216513d74C8cf14cf4747E6AaA6420FF64ee9e": "PositionManager",
    "eth:0x66a9893cC07D91D95644AEDD05D03f95e1dBA8Af": "UniversalRouter",
    "eth:0x000000000022D473030F116dDEE9F6B43aC78BA3": "Permit2",
    "eth:0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984": "UNIToken",
    "eth:0x408ED6354d4973f66138C91495F2f2FCbd8724C3": "GovernorBravo",
    "eth:0x1a9C8182C09F50C8318d769245beA52c32BE35BC": "Timelock",
    "eth:0x89A5D5bF00a27D55c02951E49078a5C5771051dB": "V4FeeAdapter",
    "eth:0x1cd822b70a0591420F65E94b9B3A0D0b0fB3a314": "V4FeePolicy"
  },
  "overrides": {
    // The ERC721 auto-sampler reads a few positions/owners and drags random
    // position tokens and holder EOAs into the graph - ignore it (same issue
    // as the v3 NonfungiblePositionManager).
    "eth:0xbD216513d74C8cf14cf4747E6AaA6420FF64ee9e": {
      "ignoreRelatives": ["WETH9"],
      "ignoreMethods": [
        "ownerOf",
        "getApproved",
        "tokenURI",
        "positionInfo",
        "getPoolAndPositionInfo",
        "getPositionLiquidity",
        "poolKeys",
        "subscriber"
      ]
    },
    // WETH9 is canonical infra, not Uniswap-governed.
    "eth:0xd1428Ba554F4C8450b763a0B2040A4935c63f06C": {
      "ignoreRelatives": ["wrappedNative"]
    },
    // UniversalRouter also routes v2 and v3; the v3 position manager/factory
    // tree is out of scope for this v4 project (tracked in uniswapv3).
    "eth:0x66a9893cC07D91D95644AEDD05D03f95e1dBA8Af": {
      "ignoreRelatives": ["V3_POSITION_MANAGER"]
    },
    // Historical proposal payloads (90+) and derived states blow up the auto
    // array explorer and are not permission-relevant; parameters and roles are
    // kept.
    "eth:0x408ED6354d4973f66138C91495F2f2FCbd8724C3": {
      "proxyType": "call implementation proxy",
      "ignoreMethods": ["getActions", "proposals", "state"]
    }
  }
}
