{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "butternetwork",
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": [
    "base:0x0000317Bec33Af037b5fAb2028f52d14658F6A56",
    "base:0xfeE31a1FD7FcA0E05428ff751242e46F6D5769a6"
  ],
  "names": {
    "base:0xC1eFc08ab7481a9303D1670e8f955ABb38Cd69D4": "Butter Verifier",
    "base:0xf95f0359704A66DB38d159e5A99721F069f30D9c": "Butter Reserve"
  },
  "overrides": {
    // Bridge AuthorityManager: role ids of its target function mapping
    "base:0xACC31A6756B60304C03d6626fc98c062E4539CCA": {
      "fields": {
        "guardians": {
          "handler": {
            "type": "call",
            "method": "getRoleMembers",
            "args": [1]
          },
          "permissions": [
            {
              "type": "interact",
              "description": "pause the Butter Bridge, freeze pending payments, extend the release delay and lower outbound limits."
            }
          ]
        },
        "relayers": {
          "handler": {
            "type": "call",
            "method": "getRoleMembers",
            "args": [3]
          },
          "permissions": [
            {
              "type": "interact",
              "description": "submit inbound messages with a proof to the Butter Bridge and release pending payments after the delay."
            }
          ]
        }
      }
    },
    // unverified code: fields read by full ABI, from the selectors in its bytecode
    "base:0xC1eFc08ab7481a9303D1670e8f955ABb38Cd69D4": {
      "description": "Verifier of inbound Butter Bridge messages from the MAP relay chain, running unverified code. Its getters name a signer set and a quorum.",
      "fields": {
        "signers": {
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "method": "function signers() view returns (address[])",
            "args": []
          },
          "permissions": [
            {
              "type": "interact",
              "description": "sign inbound Butter Bridge messages from the MAP relay chain, as listed signers of the unverified verifier."
            }
          ]
        },
        "quorum": {
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "method": "function quorum() view returns (uint256)",
            "args": []
          }
        },
        "sourceChainId": {
          "handler": {
            "type": "call",
            "method": "function sourceChainId() view returns (uint256)",
            "args": []
          }
        },
        "authority": {
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "method": "function authority() view returns (address)",
            "args": []
          },
          "permissions": [{ "type": "act" }]
        }
      }
    },
    "base:0xf95f0359704A66DB38d159e5A99721F069f30D9c": {
      "description": "Liquidity reserve of the Butter Bridge on Base, running unverified code.",
      "fields": {
        "authority": {
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "method": "function authority() view returns (address)",
            "args": []
          },
          "permissions": [{ "type": "act" }]
        },
        "releaseThreshold": {
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "method": "function releaseThreshold() view returns (uint256)",
            "args": []
          }
        },
        "mos": {
          "handler": {
            "type": "call",
            "method": "function mos() view returns (address)",
            "args": []
          }
        },
        "paused": {
          "severity": "MEDIUM",
          "handler": {
            "type": "call",
            "method": "function paused() view returns (bool)",
            "args": []
          }
        }
      }
    },
    "base:0xfeE31a1FD7FcA0E05428ff751242e46F6D5769a6": {
      "ignoreMethods": ["baseGas", "chainGasPrice"],
      "fields": {
        "baseGasBase": {
          "description": "Base gas component used by FeeService when pricing messages to Base. Authority members can change this value.",
          "severity": "HIGH",
          "type": "RISK_PARAMETER",
          "handler": { "type": "call", "method": "baseGas", "args": [8453] }
        },
        "baseFeeInfo": {
          "description": "FeeService's current Base/WETH pricing tuple: base gas, gas price, and fee receiver. Authority members can change the pricing inputs and receiver.",
          "severity": "HIGH",
          "type": "RISK_PARAMETER",
          "handler": {
            "type": "call",
            "method": "getFeeInfo",
            "args": [8453, "0x4200000000000000000000000000000000000006"]
          }
        }
      }
    }
  }
}
