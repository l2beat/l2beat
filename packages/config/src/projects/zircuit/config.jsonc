{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "zircuit",
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": [
    "eth:0x386B76D9cA5F5Fb150B6BFB35CF5379B22B26dd8",
    "eth:0x912C7271a6A3622dfb8B218eb46a6122aB046C79",
    "zircuit:0x4200000000000000000000000000000000000015"
  ],
  "names": {
    "eth:0x745393Cc03b5fE668ECd52c0E625f59aAD6D3Da0": "ZircuitSuperchainConfig",
    "eth:0x6BCe7408c0781dcE7b71494274302D4b75a1447c": "Verifier",
    "zircuit:0x4200000000000000000000000000000000000015": "L1Block",
    "zircuit:0x4200000000000000000000000000000000000018": "L2ProxyAdmin"
  },
  "overrides": {
    // OPContractsManagerV2 (upgrade tooling). Ignored so discovery doesn't
    // follow it into bare implementations.
    "eth:0xbfb9219d933ec96Ac99C4f3D7231eFE43757811F": {
      "ignoreDiscovery": true
    },
    "zircuit:0x4200000000000000000000000000000000000018": {
      // Sourcify has no source for the Karst L2ProxyAdmin implementation. The
      // path below is a manual label, not an integrity check: the deployed code
      // was checked by hand to be identical to the one at the same address on OP
      // Mainnet. It carries no ABI, so the getters are declared here.
      "manualSourcePaths": {
        "zircuit:0x893c2CEEb71D38514daF67728d3Ff1b213FC4B5F": "https://github.com/ethereum-optimism/optimism/blob/op-contracts/v7.0.0/packages/contracts-bedrock/src/L2/L2ProxyAdmin.sol"
      },
      "critical": true,
      "description": "Administration contract for the L2 predeploy proxies. Adds upgradePredeploys(address), which can only be called by the system depositor account and delegatecalls an L2ContractsManager to upgrade every predeploy in a single network upgrade transaction.",
      "ignoreRelatives": ["addressManager"],
      "fields": {
        "addressManager": {
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "method": "function addressManager() view returns (address)",
            "args": []
          }
        },
        "owner": {
          "handler": {
            "type": "call",
            "method": "function owner() view returns (address)",
            "args": []
          },
          "permissions": [{ "type": "act" }]
        },
        "isUpgrading": {
          "handler": {
            "type": "call",
            "method": "function isUpgrading() view returns (bool)",
            "args": []
          }
        },
        "version": {
          "handler": {
            "type": "call",
            "method": "function version() view returns (string)",
            "args": []
          }
        }
      }
    },
    "zircuit:0x4200000000000000000000000000000000000015": {
      // Sourcify (the only explorer for this chain) serves a stale
      // L2ToL1MessagePasser match for the Jovian L1Block implementation, so the
      // ABI it returns is wrong. Its getters are ignored and the L1Block ones are
      // declared here. Drop once the implementation changes.
      "ignoreMethods": [
        "accessController",
        "MESSAGE_VERSION",
        "messageNonce",
        "messageRoot",
        "paused",
        "totalWithdrawals",
        "isUsedNonceForWithdrawal",
        "leftHashes"
      ],
      "description": "Simple contract that returns information about the latest L1 block, which is derived permissionlessly from the L1 chain.",
      "ignoreInWatchMode": [
        "basefee",
        "hash",
        "number",
        "timestamp",
        "sequenceNumber",
        "blobBaseFee",
        "operatorFeeConstant",
        "operatorFeeScalar"
      ],
      "fields": {
        "DEPOSITOR_ACCOUNT": {
          "handler": {
            "type": "call",
            "method": "function DEPOSITOR_ACCOUNT() pure returns (address addr_)",
            "args": []
          }
        },
        "number": {
          "handler": {
            "type": "call",
            "method": "function number() view returns (uint64)",
            "args": []
          }
        },
        "timestamp": {
          "handler": {
            "type": "call",
            "method": "function timestamp() view returns (uint64)",
            "args": []
          }
        },
        "basefee": {
          "handler": {
            "type": "call",
            "method": "function basefee() view returns (uint256)",
            "args": []
          }
        },
        "hash": {
          "handler": {
            "type": "call",
            "method": "function hash() view returns (bytes32)",
            "args": []
          }
        },
        "sequenceNumber": {
          "handler": {
            "type": "call",
