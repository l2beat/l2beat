        },
        "operatorFeeScalar": {
          "handler": {
            "type": "call",
            "method": "function operatorFeeScalar() view returns (uint32)",
            "args": []
          }
        },
        "daFootprintGasScalar": {
          "handler": {
            "type": "call",
            "method": "function daFootprintGasScalar() view returns (uint16)",
            "args": []
          }
        },
        "version": {
          "handler": {
            "type": "call",
            "method": "function version() pure returns (string)",
            "args": []
          }
        },
        "gasPayingToken": {
          "handler": {
            "type": "call",
            "method": "function gasPayingToken() pure returns (address addr_, uint8 decimals_)",
            "args": []
          }
        },
        "gasPayingTokenName": {
          "handler": {
            "type": "call",
            "method": "function gasPayingTokenName() pure returns (string name_)",
            "args": []
          }
        },
        "gasPayingTokenSymbol": {
          "handler": {
            "type": "call",
            "method": "function gasPayingTokenSymbol() pure returns (string symbol_)",
            "args": []
          }
        },
        "isCustomGasToken": {
          "handler": {
            "type": "call",
            "method": "function isCustomGasToken() pure returns (bool is_)",
            "args": []
          }
        }
      }
    },
    "eth:0x6BCe7408c0781dcE7b71494274302D4b75a1447c": {
      "category": "spam",
      "description": "This contract verifies ZK proofs (if provided). There is an intentional dummy backdoor allowing to call this contract without a proof."
    },
    "eth:0x6b9e81504e961a9CDf81A06e916720fb4c273e90": {
      "types": {
        "VmFromPermissionedGameArgs": {
          "typeCaster": "SliceAddress",
          "arg": { "offset": 32 }
        }
      },
      "fields": {
        // The template resolves the VM of game type 8 only. This chain respects
        // game type 1, whose args share the layout (prestate(32) | vm(20)).
        "permissionedGameVm": {
          "handler": {
            "type": "call",
            "method": "function gameArgs(uint32) view returns (bytes)",
            "args": [1],
            "expectRevert": true
          },
          "edit": ["format", "VmFromPermissionedGameArgs"]
        },
        "proposerFromDGF": {
          "permissions": [
            {
              "type": "interact",
              "description": "Allowed to post new state roots of the current layer to the host chain."
            }
          ]
        },
        "challengerFromDGF": {
          "permissions": [
            {
              "type": "interact",
              "description": "Allowed to challenge or delete state roots proposed by a Proposer."
            }
          ]
        }
      }
    }
  }
