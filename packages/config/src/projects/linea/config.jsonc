{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "linea",
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": [
    "eth:0x051F1D88f0aF5763fB888eC4378b4D8B29ea3319",
    "linea:0x353012dc4a9A6cF55c941bADC267f82004A8ceB9",
    "linea:0xA2Ee6Fce4ACB62D95448729cDb781e3BEb62504A",
    "linea:0xd83af4fbD77f3AB65C3B1Dc4B38D7e67AEcf599A"
  ],
  "names": {
    "linea:0xc808BfCBeD34D90fa9579CAa664e67B9A03C56ca": "L2Timelock",
    "linea:0x3886a948eA7b4053312c3aE31a13776144aA6239": "L2Roles",
    "eth:0x892bb7EeD71efB060ab90140e7825d8127991DD3": "Linea Security Council"
  },
  "overrides": {
    "linea:0xf5cc7604a5ef3565b4D2050D65729A06B68AA0bD": {
      // Actor shell: proposer, executor and canceller on the L2Timelock.
      "canActIndependently": true
    },
    // active PLONK verifiers referenced by LineaRollup.verifiers (proof types 1 and 0): a code change lets forged proofs finalize arbitrary state and drain the bridge.
    // Replaced verifiers drop out of discovery and need no override: every rotation is a HIGH `verifiers` change (reviewed events) on LineaRollup.
    "eth:0x09ac9f7E5Fb37e241e0B1e52aaF01eFE0a488a77": {
      "critical": true
    },
    "eth:0xAFF26999780901ee8B48f0a1271a177ff46fD53F": {
      "critical": true
    },
    // Not critical: the Zodiac Delay eth:0x784CCeE002E259Fc38C4b36C2D8bd8a457e55436 only lets the
    // Security Council act as Linea Multisig 2 after 90 days. Multisig 2 is a PROPOSER on the 0s
    // Timelock whose only EXECUTOR is the Security Council itself, and its TokenBridge roles are a
    // subset of the Council's, so the module neither adds nor constrains any upgrade or custody path.
    // Immutable public forwarding mechanism: LineaRollup.livenessRecoveryOperator, which gets
    // OPERATOR_ROLE after six months without finalization (permissionless liveness recovery).
    "eth:0x3697bD0bC6C050135b8321F989a5316eACbF367D": {
      "critical": true
    },
    // Timelock (0s min delay) owning the L1 ProxyAdmin that upgrades LineaRollup, TokenBridge and YieldManager
    "eth:0xd6B95c960779c72B8C6752119849318E5d550574": {
      "critical": true
    },
    // ProxyAdmin for LineaRollup, TokenBridge and YieldManager
    "eth:0xF5058616517C068C7b8c7EbC69FF636Ade9066d6": {
      "critical": true
    },
    // beacon controlling the BridgedToken implementation of canonical bridged tokens on L1
    "eth:0x971f46a2852d11D59dbF0909e837cfd06f357DeB": {
      "critical": true
    },
    // ProxyAdmin for the L2 TokenBridge and L2MessageService
    "linea:0x1E1f6F22f97b4a7522D8B62e983953639239774E": {
      "critical": true
    },
    // L2 Timelock (0s min delay) owning the L2 ProxyAdmin
    "linea:0xc808BfCBeD34D90fa9579CAa664e67B9A03C56ca": {
      "critical": true
    },
    // beacon controlling the BridgedToken implementation of all canonical bridged tokens on Linea
    "linea:0xE798695d2e78f7caeb5BbF3385433959324c02c0": {
      "critical": true
    }
  }
}
