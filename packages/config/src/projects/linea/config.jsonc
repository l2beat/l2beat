    "eth:0x892bb7EeD71efB060ab90140e7825d8127991DD3": {
      "critical": true
    },
    // Timelock (0s min delay) owning the L1 ProxyAdmin that upgrades LineaRollup, TokenBridge and YieldManager
    "eth:0xd6B95c960779c72B8C6752119849318E5d550574": {
      "critical": true
    },
    // ProxyAdmin for LineaRollup, TokenBridge and YieldManager
    "eth:0xF5058616517C068C7b8c7EbC69FF636Ade9066d6": {
      "critical": true
    },
    // beacon controlling the BridgedToken implementation of canonical bridged tokens on L1
    "eth:0x971f46a2852d11D59dbF0909e837cfd06f357DeB": {
      "critical": true
    },
