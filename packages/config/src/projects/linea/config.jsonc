    "linea:0xf5cc7604a5ef3565b4D2050D65729A06B68AA0bD": {
      // proposer, executor and canceller on the L2Timelock (0s delay) that owns the L2 ProxyAdmin upgrading the L2 TokenBridge and L2MessageService
