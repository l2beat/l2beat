  },
  "overrides": {
    // Boundary cuts: ether.fi fields pointing into external protocols (Lido,
    // EigenLayer, LayerZero, Curve, Chainlink) or enumerating thousands of
    // per-validator node clones. The boundary contracts stay in scope; the
    // foreign graphs are not crawled.
    "eth:0x9FFDF407cDe9a93c47611799DA23924Af3EF764F": {
      "ignoreRelatives": [
        "dummies",
        "lido",
        "lidoWithdrawalQueue",
        "stEth_Eth_Pool",
        "stEthPriceFeed"
      ]
    },
    "eth:0x1B7a4C3797236A1C37f8741c0Be35c2c72736fFf": {
      "ignoreRelatives": [
        "lido",
        "lidoWithdrawalQueue",
        "eigenLayerDelegationManager",
        "eigenLayerStrategyManager",
        "rewardsCoordinator"
      ]
    },
    "eth:0x8B71140AD2e5d1E7018d2a7f8a288BD3CD38916F": {
      "ignoreRelatives": ["etherfiNodeAddress", "BEACON_ETH_STRATEGY_ADDRESS"]
    },
    "eth:0xDadEf1fFBFeaAB4f68A9fD181395F68b4e4E7Ae0": {
      "ignoreRelatives": ["lido", "stEthPriceFeed"]
    },
    "eth:0x3c55986Cfee455E2533F4D29006634EcF9B7c03F": {
      "//": "EtherFiNode implementation (behind the beacon): cut EigenLayer wiring",
      "ignoreRelatives": [
        "delegationManager",
        "eigenPodManager",
        "getEigenPod",
        "BEACON_ETH_STRATEGY_ADDRESS"
      ]
    },
    "eth:0x556Db8c611FE63e694413F718d795f976dcF5881": {
      "//": "EtherFiNode impl address as resolved via beacon: same EigenLayer cuts",
      "ignoreRelatives": [
        "delegationManager",
        "eigenPodManager",
        "getEigenPod",
        "BEACON_ETH_STRATEGY_ADDRESS"
      ]
    },
    "eth:0xcfC6d9Bd7411962Bfe7145451A7EF71A24b6A7A2": {
      "//": "DepositAdapter: external LST/wETH tokens it zaps from",
      "ignoreRelatives": ["stETH", "wETH", "wstETH"]
    },
    "eth:0x89E45081437c959A827d2027135bC201Ab33a2C8": {
      "//": "RestakingRewardsRouter: EIGEN reward token is external",
      "ignoreRelatives": ["rewardTokenAddress"]
    },
    "eth:0x2093Bbb221f1d8C7c932c32ee28Be6dEe4a37A6a": {
      "//": "EtherFiAvsOperatorsManager: EigenLayer core is external",
      "ignoreRelatives": ["avsDirectory", "delegationManager", "avsOperators"]
    },
    "eth:0x6Db24Ee656843E3fE03eb8762a54D86186bA6B64": {
      "//": "KINGDistributor (CumulativeMerkleDrop): the KING/LRT-squared/Liquid reward subgraph and its LayerZero OFT are separate products, out of scope for the weETH staking core",
      "ignoreRelatives": ["token", "oftAdapter", "endpoint"]
    },
    "eth:0xcd2eb13D6831d4602D80E5db9230A57596CDCA63": {
      "ignoreRelatives": ["endpoint", "msgInspector", "preCrime"]
    },
    "eth:0xD789870beA40D056A4d26055d0bEFcC8755DA146": {
      "ignoreRelatives": ["endpoint"]
    },
    "eth:0xf4718766a7fc8c81F788669B0985FAC03D064D29": {
      "//": "AvsOperator implementation matched by the shared eigenlayer/AVSOperator template; implementation() reverts on the logic contract itself",
      "ignoreMethods": ["implementation"]
    }
  }
}
