  "names": {
    "eth:0x35fA164735182de50811E8e2E824cFb9B6118ac2": "eETH",
    "eth:0xCd5fE23C85820F7B72D0926FC9b05b43E359b7ee": "weETH",
    "eth:0x308861A430be4cce5502d0A12724771Fc6DaF216": "LiquidityPool",
    "eth:0x25e821b7197B146F7713C3b89B6A4D83516B912d": "StakingManager",
    "eth:0x8B71140AD2e5d1E7018d2a7f8a288BD3CD38916F": "EtherFiNodesManager",
    "eth:0x00C452aFFee3a17d9Cecc1Bcd2B8d5C7635C4CB9": "AuctionManager",
    "eth:0xd5edf7730ABAd812247F6F54D7bd31a52554e35E": "NodeOperatorManager",
    "eth:0x57AaF0004C716388B21795431CD7D5f9D3Bb6a41": "EtherFiOracle",
    "eth:0x0EF8fa4760Db8f5Cd4d993f3e3416f30f942D705": "EtherFiAdmin",
