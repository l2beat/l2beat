{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "celo",
  "import": ["../globalConfig.jsonc"],
  "maxDepth": 10,
  "initialAddresses": [
    "eth:0x9C4955b92F34148dbcfDCD82e9c9eCe5CF2badfe",
    "celo:0x4200000000000000000000000000000000000007",
    "celo:0x4200000000000000000000000000000000000010",
    "celo:0x4200000000000000000000000000000000000016",
    "celo:0x4200000000000000000000000000000000000018"
  ],
  "names": {
    "eth:0x4092A77bAF58fef0309452cEaCb09221e556E112": "CeloProxyAdminOwner",
    "celo:0x4200000000000000000000000000000000000007": "L2CrossDomainMessenger",
    "celo:0x4200000000000000000000000000000000000010": "L2StandardBridge",
    "celo:0x4200000000000000000000000000000000000016": "L2ToL1MessagePasser",
    "celo:0x4200000000000000000000000000000000000018": "ProxyAdmin",
    "celo:0x51a3a77baF58fef0309452CeaCB09221e556f223": "CeloProxyAdminOwner - L2 Alias"
  },
  "overrides": {
    "celo:0x4200000000000000000000000000000000000007": {
      "critical": { "sinceTimestamp": 1742960663 },
      "fields": {
        "$admin": { "severity": "HIGH" }
      }
    },
    "celo:0x4200000000000000000000000000000000000010": {
      "critical": { "sinceTimestamp": 1742960663 },
      "fields": {
        "$admin": { "severity": "HIGH" }
      }
    },
    "celo:0x4200000000000000000000000000000000000016": {
      "critical": { "sinceTimestamp": 1742960663 },
      "manualSourcePaths": {
        "celo:0xC0D3C0d3c0d3c0d3C0d3C0D3c0D3c0d3c0D30016": "https://celo.blockscout.com/address/0xC0D3C0d3c0d3c0d3C0d3C0D3c0D3c0d3c0D30016"
      },
      "fields": {
        "$admin": { "severity": "HIGH" }
      }
    },
    "celo:0x4200000000000000000000000000000000000018": {
      "critical": { "sinceTimestamp": 1742960663 },
      "fields": {
        "owner": {
          "severity": "HIGH",
          "handler": {
            "type": "call",
            "method": "function owner() view returns (address)",
            "args": []
          },
          "description": "L2 alias of the CeloProxyAdminOwner. It can upgrade the security-critical L2 predeploys."
        }
      }
    },
    "eth:0x55093104b76FAA602F9d6c35A5FFF576bE78d753": {
      // AddressManager of this chain: its owner can repoint the ResolvedDelegateProxy implementations
      "critical": true
    },
    "eth:0xC03172263409584f7860C25B6eB4985f0f6F4636": {
      "references": [
        {
          "text": "Security Council members - Celo Docs",
          "href": "https://docs.celo.org/home/protocol/security-council"
        }
      ]
    },
    "eth:0xD1C635987B6Aa287361d08C6461491Fa9df087f2": { "category": "spam" },
    "eth:0xFbAC162162f4009Bb007C6DeBC36B1dAC10aF683": {
      "ignoreInWatchMode": ["permissionedGamesTotal", "gameCount"]
    },
    // ProxyAdmin (L1): can upgrade every core Celo contract (portal, bridges, DGF, SystemConfig, CeloSuperchainConfig).
    "eth:0x783A434532Ee94667979213af1711505E8bFE374": {
      "critical": true
    },
    // L1 CELO token: Celo is a custom-gas-token chain, so this ERC20 is what the
    // portal escrows against native CELO on L2. It is an EIP-1967 proxy behind the
    // same ProxyAdmin as the core contracts; an implementation change can alter
    // the custody/accounting of the escrowed gas token (mantle L1MantleToken precedent).
    "eth:0x057898f3C43F129a17517B9056D23851F124b19f": {
      "critical": true
    },
    // SuperchainProxyAdmin: can upgrade the shared SuperchainConfig whose guardian can pause the whole Superchain including Celo.
    "eth:0x543bA4AADBAb8f9025686Bd03993043599c6fB04": {
      "critical": true
    },
    // OP Mainnet's legacy AddressManager, discovered as a relative of the shared
    // SuperchainProxyAdmin. It resolves implementations for OP Mainnet's own
    // ResolvedDelegateProxies only; the SuperchainConfig that Celo shares is a plain
    // EIP-1967 proxy (proxyType 0), and Celo's own messenger resolves through Celo's
    // AddressManager (eth:0x55093104...). Outside the Celo perimeter.
    "eth:0xdE1FCfB0851916CA5101820A69b13a4E276bd81F": {},
    // CeloSuperchainConfig: the local superchain config all Celo core contracts read
    // their pause state from. Its guardian (Celo cLabs Multisig, acting alone) can
    // pause Celo withdrawals; it also forwards the shared SuperchainConfig's
    // Superchain-wide pause.
    "eth:0x25035d2233d099f0BA710ca1e5a3834842870C66": {
      "critical": true,
      "fields": {
        "$admin": {
          "severity": "HIGH"
        },
        "guardian": {
          "severity": "MEDIUM",
          "description": "Address that can pause Celo withdrawals on its own, without any other party consenting."
        },
        "paused": { "severity": "MEDIUM" },
        "celoPaused": { "severity": "MEDIUM" }
      }
    },
    // OP Succinct AccessManager: gates who can propose and challenge OPSuccinct
    // dispute games. The owner can rewrite both allowlists with no delay.
    "eth:0xF59a19c5578291cB7fd22618D16281aDf76f2816": {
      "critical": true,
      "fields": {
        // Identity churn inside an unchanged role: proposer/challenger rotations
        // do not change the trust model (the owner controls the lists either way),
        // so they surface as MEDIUM instead of resetting the ossification clock.
        "challengers": { "severity": "MEDIUM" },
        "proposers": { "severity": "MEDIUM" }
      }
    },
    // Active OPSuccinctFaultDisputeGame implementation (game type 42, the respected
    // game type): verifies proposed state roots via SP1 proofs. Vkey rotations are
    // performed by deploying a new game and registering it on the DisputeGameFactory.
    "eth:0xfF1caC738a5263736AF258e4b3D6a4970C6351FF": {
      "critical": true
    },
    "eth:0x2bCeB78Fda0d5e3bfA7F4B8c499aa74bDf8D7755": {
      "fields": {
        "proposer": {
          "permissions": [
            {
              "type": "interact",
              "description": "Allowed to post new state roots of the current layer to the host chain."
            }
          ]
        },
        "challenger": {
          "permissions": [
            {
              "type": "interact",
              "description": "Allowed to challenge or delete state roots proposed by a Proposer."
            }
          ]
        }
      }
    }
  }
}
