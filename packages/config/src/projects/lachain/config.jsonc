{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "lachain",
  "archived": true,
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": ["eth:0x742A28e22277945BBAAa34810393bf6e8512576C"],
  "names": { "eth:0x742A28e22277945BBAAa34810393bf6e8512576C": "Diamond" },
  "overrides": {
    "eth:0x742A28e22277945BBAAa34810393bf6e8512576C": {
      "fields": {
        "validators": {
          "handler": {
            "type": "hardcoded",
            "value": ["eth:0x8c0Bfc04AdA21fd496c55B8C50331f904306F564"]
          }
        }
      }
    },
    "eth:0x8c0Bfc04AdA21fd496c55B8C50331f904306F564": {
      "fields": {
        "daTrackingConfig": {
          // Full DA tracking era history for the backend indexer. Append-only:
          // on a ValidatorTimelock migration, close this era with untilBlock,
          // append a new one and move this field to the new timelock's
          // overrides - never edit or remove existing eras.
          "handler": {
            "type": "zkStackDaTracking",
            "l2ChainId": 2904,
            "eras": [
              {
                // sinceBlock defaults to the first ValidatorAdded for this chain
                "inbox": "eth:0x8c0Bfc04AdA21fd496c55B8C50331f904306F564",
                "validatorSource": "legacyEvents"
              }
            ]
          }
        },
        "validatorsVTL": {
          "handler": {
            "type": "event",
            "select": ["validator"],
            "add": {
              "event": "event ValidatorAdded(uint256 indexed chainId, address validator)",
              "where": ["=", "#chainId", 2904]
            },
            "remove": {
              "event": "event ValidatorRemoved(uint256 indexed chainId, address validator)",
              "where": ["=", "#chainId", 2904]
            }
          },
          "permissions": [
            {
              "type": "interact",
              "description": "Permissioned to call the functions to commit, prove, execute and revert L2 batches through the ValidatorTimelock in the main Diamond contract."
            }
          ]
        }
      }
    }
  }
}
