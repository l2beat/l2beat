{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "ignoreMethods": ["INIT_BYTECODE_TRANSPARENT_PROXY", "claimedBitMap"],
  "ignoreInWatchMode": [
    "depositCount",
    "lastUpdatedDepositCount",
    "getRoot",
    "claimedGlobalIndexHashChain"
  ],
  "category": "core",
  "critical": true,
  "description": "Agglayer bridge contract. Supports interop with Ethereum and blockchains connected to Agglayer. Escrows all preminted ETH because it cannot mint on the L2. The globalExitRootManager is used as an oracle to validate bridge messages against.",
  "fields": {
    "pendingProxiedTokensManager": {
      "severity": "MEDIUM"
    },
    "pendingEmergencyBridgeUnpauser": {
      "severity": "MEDIUM"
    },
    "pendingEmergencyBridgePauser": {
      "severity": "MEDIUM"
    },
    "isEmergencyState": {
      "severity": "MEDIUM"
    },
    "WETHToken": {
      "severity": "HIGH"
    },
    "$admin": {
      "severity": "HIGH"
    },
    // Role holders below (Katana Foundation Engineering Safe): swapping one actor for
    // another is identity, not mechanism. Mechanism changes (e.g. the EOA-to-multisig
    // handover of May 2025) are recorded in katana/ossification.json.
    "getProxiedTokensManager": {
      "severity": "MEDIUM",
      "permissions": [
        {
          "type": "interact",
          "description": "own and upgrade default L2 token contracts deployed by the bridge."
        }
      ]
    },
    "bridgeManager": {
      "severity": "MEDIUM",
      "permissions": [
        {
          "type": "interact",
          "description": "manage token mappings and deployments."
        }
      ]
    },
    "emergencyBridgePauser": {
      "severity": "MEDIUM",
      "permissions": [
        { "type": "interact", "description": "pause the bridge." }
      ]
    },
    "emergencyBridgeUnpauser": {
      "severity": "MEDIUM",
      "permissions": [
        { "type": "interact", "description": "unpause the bridge." }
      ]
    }
  }
}
