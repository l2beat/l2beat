{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "OptimismPortal2",
  "category": "core",
  // asset bridging is disabled, but this is the forced transaction (self-sequencing) entry.
  "critical": true,
  "description": "Stores the configuration of the OP stack components and proof system. Specifies which game type is used for state validation, which currently is the {{ RespectedGameString }}. This contract is modified to disable asset bridging, but it allows forced transactions.",
  "ignoreMethods": ["isOutputFinalized"],
  "ignoreInWatchMode": ["params", "balance"],
  "types": {
    "DisputeGameMap": {
      "typeCaster": "Mapping",
      "arg": {
        "0": "FaultDisputeGame",
        "1": "PermissionedDisputeGame",
        "1337": "KailuaGame"
      }
    }
  },
  "fields": {
    "respectedGameType": {
      // inconsequential here: the dispute-game withdrawal path carries no assets
      // (bridging through this portal is disabled; custody is in the Agglayer bridge).
      "severity": "LOW"
    },
    "RespectedGameString": {
      "handler": {
        "type": "call",
        "method": "respectedGameType",
        "args": []
      },
      "edit": ["format", "DisputeGameMap"]
    },
    "paused": {
      "description": "Whether the contract is paused or not. Determined by the SuperchainConfig contract PAUSED_SLOT. Here it pauses forced transactions (asset bridging through this portal is disabled).",
      "severity": "MEDIUM"
    }
  }
}
