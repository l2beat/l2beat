{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "critical": true,
  "description": "The main registry (hub) for all the contracts in the ZK stack cluster and central entrypoint for bridge transactions. Stores important mappings like from chainId to diamond address, from chainId to parent CTM, from chainId to base token etc. A clone of Bridgehub is also deployed on each L2 chain, but this clone is only used on settlement layers.",
  "category": "shared",
  "ignoreMethods": [
    "__DEPRECATED_baseToken",
    "baseToken",
    "baseTokenAssetId",
    "chainTypeManager",
    "ctmAssetIdFromChainId",
    "getHyperchain",
    "getZKChain",
    "settlementLayer",
    "whitelistedSettlementLayers"
  ],
  "ignoreRelatives": ["getAllZKChains"],
  "fields": {
    "admin": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "create new zk chains (based on the current version), register tokens (ZK cluster Admin role)."
        }
      ]
    },
    "owner": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "set critical contract addresses for the shared cluster, register settlement layers, pause and unpause migrations and the bridge and manage zk chain registration."
        }
      ]
    },
    "paused": { "severity": "MEDIUM" },
    "migrationPaused": { "severity": "MEDIUM" },
    // ecosystem pointers: live onlyOwner setters (setAddresses /
    // setChainAssetHandler) can repoint them without any code change —
    // swapping the asset router redirects every chain's deposit/withdrawal
    // routing, so these are HIGH.
    "assetRouter": { "severity": "HIGH" },
    "sharedBridge": { "severity": "HIGH" },
    "messageRoot": { "severity": "HIGH" },
    "l1CtmDeployer": { "severity": "HIGH" },
    "chainAssetHandler": { "severity": "HIGH" },
    "chainsCreated": {
      "description": "All new chains created go thorugh the central bridgehub and are stored here with their respective STMs.",
      "handler": {
        "type": "event",
        "select": ["chainId", "chainTypeManager", "chainGovernance"],
        "add": { "event": "NewChain" },
        "ignoreRelative": true
      }
    },
    "settlementLayers": {
      "description": "New settlement layers and their whitelist status. Chains can be migrated to whitelisted settlement layers by their chain admin.",
      "severity": "HIGH",
      "handler": {
        "type": "event",
        "select": ["isWhitelisted"],
        "groupBy": "chainId",
        "set": { "event": "SettlementLayerRegistered" }
      }
    }
  }
}
