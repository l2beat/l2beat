{
  "$schema": "../../../../../../../discovery/schemas/contract.v2.schema.json",
  // Applied by referrer from orbitstack/SequencerInbox_Espresso_CAS. The fields
  // name their full signatures so they are read even when the implementation
  // source is not available from the block explorer.
  "displayName": "EspressoTEEVerifier",
  "description": "TEE gateway contract that can be used to 1) register signers that were generated inside a TEE and 2) verify the signatures of such signers. It supports AWS Nitro TEEs through modular contracts.",
  "fields": {
    "owner": {
      "severity": "HIGH",
      "handler": {
        "type": "call",
        "method": "function owner() view returns (address)",
        "args": []
      },
      "permissions": [
        {
          "type": "interact",
          "description": "change the Nitro TEE verifier contract and the attestation verifier it uses."
        },
        {
          "type": "interact",
          "description": "add, remove or disable supported enclave hashes."
        },
        {
          "type": "interact",
          "description": "add or remove guardians."
        }
      ]
    },
    "pendingOwner": {
      "handler": {
        "type": "call",
        "method": "function pendingOwner() view returns (address)",
        "args": []
      }
    },
    "getGuardians": {
      "handler": {
        "type": "call",
        "method": "function getGuardians() view returns (address[])",
        "args": []
      },
      "permissions": [
        {
          "type": "interact",
          "description": "add or re-enable supported enclave hashes.",
          "role": "guardian"
        }
      ]
    },
    "espressoNitroTEEVerifier": {
      "severity": "HIGH",
      "handler": {
        "type": "call",
        "method": "function espressoNitroTEEVerifier() view returns (address)",
        "args": []
      }
    }
  }
}
