{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Deploys a deterministic escrow per recipient and destination chain. Withdrawals paid to such an escrow are bridged onward by keepers via LayerZero OFT or CCIP.",
  "fields": {
    "owner": {
      "permissions": [
        {
          "type": "interact",
          "description": "set the bridge route per token and chain, appoint keepers, and move funds held in any withdraw escrow or in the factory to the owner."
        }
      ]
    },
    "keepers": {
      "handler": {
        "type": "event",
        "select": "keeper",
        "add": { "event": "KeeperSet", "where": ["=", "#allowed", true] },
        "remove": { "event": "KeeperSet", "where": ["!=", "#allowed", true] }
      },
      "permissions": [
        {
          "type": "interact",
          "description": "bridge the balance of a withdraw escrow to its recipient on the configured destination chain."
        }
      ]
    }
  }
}
