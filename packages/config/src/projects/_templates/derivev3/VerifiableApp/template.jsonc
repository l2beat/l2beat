{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Holds the state root and verifies SP1 validity proofs for each batch through {{ verifier }}. Each proof also commits to a Celestia header range and blob hash-chain, which this contract chains from a stored Celestia anchor and checks for freshness.",
  "critical": true,
  "ignoreInWatchMode": [
    "stateRoot",
    "consumedPublicAccIndex",
    "consumedAdminAccIndex",
    "lastOpTimestamp",
    "celestiaTrustedHeight",
    "celestiaTrustedHash",
    "celestiaLastCommitment",
    "getCelestiaAnchor"
  ],
  "fields": {
    "owner": {
      "permissions": [
        {
          "type": "interact",
          "description": "replace the state root, the program verification key, the verifier and the trusted Celestia anchor, and set the batch submitter and its stall timeout."
        }
      ]
    },
    "batchSubmitter": {
      "permissions": [
        {
          "type": "interact",
          "description": "exclusively submit batches with validity proofs, until the oldest unprocessed L1 action is older than the submitter stall timeout."
        }
      ]
    },
    "submitterStallTimeout": {
      "severity": "HIGH",
      "description": "Time after which anyone can remove the batch submitter if an L1 action stays unprocessed."
    },
    "programVKey": { "severity": "HIGH" },
    "verifier": { "severity": "HIGH" },
    // stateRoot and the Celestia anchor are ignored in watch mode because every
    // batch moves them; these counters only move when the owner overrides them.
    "rootRotations": {
      "description": "Number of times the owner replaced the state root (RootRotated).",
      "severity": "HIGH",
      "handler": {
        "type": "eventCount",
        "topics": [
          "0xaa337f05ccfd81fbc39fbd530f908f063cacff0447b474391f34ea4c0bd5b6ad"
        ]
      }
    },
    "celestiaAnchorResets": {
      "description": "Number of times the owner re-pointed the trusted Celestia anchor (CelestiaHeadBootstrapped).",
      "severity": "HIGH",
      "handler": {
        "type": "eventCount",
        "topics": [
          "0x3f41a25d1023e7401dff3589543eb7532a810f6be47ac29af645c393dfe728ed"
        ]
      }
    }
  }
}
