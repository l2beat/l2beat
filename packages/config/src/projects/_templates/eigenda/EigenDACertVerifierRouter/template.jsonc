{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "A router contract for DA Certificate verifiers. Verifier routing depends on the certificate reference block number.",
  "fields": {
    "DAVerifiers": {
      "description": "The DA verifier contracts indexed by activation block number.",
      "severity": "HIGH",
      "handler": {
        "type": "event",
        "select": ["activationBlockNumber", "certVerifier"],
        "add": {
          "event": "CertVerifierAdded"
        }
      }
    },
    "owner": {
      "permissions": [
        {
          "type": "interact",
          "description": "can add cert verifiers to the router, changing which contract validates DA certificates from a chosen block onwards."
        }
      ]
    }
  }
}
