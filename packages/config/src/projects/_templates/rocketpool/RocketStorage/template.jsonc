{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "RocketStorage",
  "category": "core",
  "description": "Eternal-storage registry and the root of the protocol. It holds every protocol variable in typed key-value maps and is the only contract with persistent state; the logic contracts are stateless and read and write through it. Each logic contract is registered under the hash of its name, so repointing a name in a single write moves every caller to a new implementation on its next call. Write access is limited to addresses flagged as registered contracts, which means the registry itself imposes no delay: any delay comes from the contract performing the write. Registered names are not enumerable on-chain, so discovery resolves each one by calling the address lookup with its name hash.",
  "fields": {
    "getGuardian": {
      "description": "Bootstrap account, stored in a dedicated slot rather than the key-value map. It is not a registered contract and cannot write to the map.",
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "can hand the bootstrap role to another address through a two-step transfer, and still holds the ungated powers listed on the penalty-cap and one-shot upgrade contracts."
        }
      ]
    },
    "upgradeDelaySeconds": {
      "handler": {
        "type": "call",
        "address": "{{ rocketDAOProtocolSettingsSecurity }}",
        "method": "function getUpgradeDelay() view returns (uint256)",
        "args": []
      },
      "description": "Waiting period, in seconds, between an approved upgrade and the moment it can be applied."
    },
    "upgradeDelay": {
      "copy": "upgradeDelaySeconds",
      "edit": ["format", "FormatSeconds"],
      "description": "Waiting period between an approved upgrade and the moment it can be applied."
    },
    "addressQueueStorage": {
      "handler": {
        "type": "call",
        "method": "function getAddress(bytes32) view returns (address)",
        "args": [
          // keccak256("contract.address", "addressQueueStorage")
          "0x2addccd64dd43c4ef1213c10626c6170f7f9bb5f4a96dfbbabddcbed2b170fc4"
