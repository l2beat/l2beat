      },
      "severity": "HIGH",
      "permissions": [
        {
          "type": "upgrade",
          "delay": "{{ upgradeDelaySeconds }}",
          "description": "can repoint any upgradeable name in this registry to a new address, which replaces the code every other contract calls. The change is scheduled by a passed oracle-set proposal, waits {{ upgradeDelay }}, and can be cancelled by the security council in that window. A fixed list of names is refused by the code: the custody contract, the token contracts, the beacon-chain deposit contract, and the penalty-cap contract."
        }
      ]
    },
