{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "FaultDisputeGame",
  "critical": true,
  "description": "Logic of the dispute game. When a state root is proposed, a dispute game contract is deployed. Challengers can use such contracts to challenge the proposed state root.",
  "ignoreMethods": [
    "getNumToResolve",
    "resolutionCheckpoints",
    "resolvedSubgames"
  ],
  "fields": {
    "absolutePrestateDecoded": {
      "description": "Prestate tag for known prestates. On clones-with-immutable-args implementations this reads 0 from the bare impl; the authoritative prestate lives in the DisputeGameFactory gameArgs (HIGH-watched there).",
      "handler": {
        "type": "call",
        "method": "absolutePrestate",
        "args": []
      },
      "edit": ["format", "OpStackAbsolutePrestate"]
    }
  }
}
