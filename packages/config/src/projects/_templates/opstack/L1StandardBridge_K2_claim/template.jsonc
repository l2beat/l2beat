{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "L1StandardBridge",
  "description": "Modified L1StandardBridge: deposits and finalizing withdrawals are disabled. ERC20 tokens held by the contract can only be claimed with a Merkle proof against merkleRoot. After the recovery timestamp and while claims are paused (both read from OPTIMISM_PORTAL), the guardian can withdraw all tokens and ETH.",
  "ignoreRelatives": ["OTHER_BRIDGE", "otherBridge", "l2TokenBridge"],
  "fields": {
    "$admin": {
      "permissions": [
        {
          "type": "upgrade",
          "description": "upgrading the bridge implementation can give access to all funds escrowed therein."
        }
      ]
    },
    "guardian": {
      "handler": {
        "type": "call",
        "method": "function guardian() view returns (address)",
        "args": [],
        "address": "{{ OPTIMISM_PORTAL }}"
      },
      "permissions": [
        {
          "type": "interact",
          "description": "set merkleRoot, sweep the bridge's ETH into the OptimismPortal while claims are paused, and after the recovery timestamp withdraw all tokens and ETH."
        }
      ]
    },
    "merkleRoot": {
      "description": "Root of the Merkle tree of (address, tokens, cumulative amounts) ERC20 claims."
    }
  },
  "category": "bridge-canonical"
}
