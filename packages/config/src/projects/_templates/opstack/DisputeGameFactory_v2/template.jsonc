{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "DisputeGameFactory",
  "critical": true,
  "description": "The dispute game factory allows the creation of dispute games, used to propose state roots and eventually challenge them. This variant exposes per-type reads only; the legacy array views (gameImpls[], initBonds[]) were removed in the new implementation.",
  "ignoreInWatchMode": ["gameCount", "permissionedGamesTotal"],
  "ignoreMethods": ["gameAtIndex"],
  "types": {
    "ProposerFromArgs": {
      "typeCaster": "SliceAddress",
      "arg": { "offset": 124 }
    },
    "ChallengerFromArgs": {
      "typeCaster": "SliceAddress",
      "arg": { "offset": 144 }
    },
    "WethFromArgs": {
      "typeCaster": "SliceAddress",
      "arg": { "offset": 72 }
    },
    "AnchorStateRegistryFromArgs": {
      "typeCaster": "SliceAddress",
      "arg": { "offset": 52 }
    },
    "AbsolutePrestateFromArgs": {
      "typeCaster": "SliceBytes32",
      "arg": { "offset": 0 }
    },
    "ChainIdFromArgs": {
      "typeCaster": "SliceUint256",
      "arg": { "offset": 92 }
    },
    "VmFromGame8Args": {
      "typeCaster": "SliceAddress",
      "arg": { "offset": 32 }
    },
    "VmFromPermissionedArgs": {
      "typeCaster": "SliceAddress",
      "arg": { "offset": 32 }
    },
    // Type-5 args, 40 bytes: anchorStateRegistry(20) | proposer(20).
    "AnchorStateRegistryFromGame5Args": {
      "typeCaster": "SliceAddress",
      "arg": { "offset": 0 }
    },
    "ProposerFromGame5Args": {
      "typeCaster": "SliceAddress",
      "arg": { "offset": 20 }
    }
  },
