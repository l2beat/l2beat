{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "This contract is the router for zk proof verification. It stores the mapping between identifiers and the address of onchain verifier contracts, routing each identifier to the corresponding verifier contract.",
  "fields": {
    // Not HIGH: a freeze only removes a verifier, like a kill switch. New
    // routes reset the clock through allVerifiers.
    "activeVerifiers": {
      "description": "Verifiers that are routed to by their selector and not frozen.",
      "severity": "MEDIUM",
      "handler": {
        "type": "event",
        "select": ["selector", "verifier"],
        "add": {
          "event": "RouteAdded"
        },
        "remove": {
          "event": "RouteFrozen"
        }
      }
    },
    // Only grows, on RouteAdded: a new route is a new verifier.
    "allVerifiers": {
      "description": "All verifiers that were ever routed to by this gateway.",
      "severity": "HIGH",
      "handler": {
        "ignoreRelative": true,
        "type": "event",
        "select": ["selector", "verifier"],
        "add": {
          "event": "RouteAdded"
        }
      }
    },
    // role holder: mechanism changes are reviewed events
    "owner": {
      "severity": "MEDIUM",
      "permissions": [
        {
          "type": "interact",
          "description": "affect the liveness and safety of the gateway - can transfer ownership, add and freeze verifier routes."
        }
      ]
    }
  }
}
