{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "ZkApiVault",
  "category": "core",
  "critical": true,
  "description": "Escrows ETH for anonymous API authorizations as publicly numbered notes. A Groth16 proof closes a note with operator clearance, or starts a delayed escape that any request proof with the same nullifier cancels. Closing reveals the note id, payout address and remaining balance and sends the used part to the treasury. Anyone can sweep an expired note entirely to the treasury, also while paused.",
  "ignoreMethods": ["notes", "pendingWithdrawals", "usedNullifiers"],
  "ignoreInWatchMode": ["currentRoot", "nextNoteId"],
  "fields": {
    "owner": {
      "severity": "MEDIUM",
      "permissions": [
        {
          "type": "interact",
          "description": "pause and unpause deposits, cooperative withdrawals and new escape withdrawals, and change the treasury receiving consumed balances and expired notes. Pausing can prevent users from exiting before their notes become sweepable."
        }
      ]
    },
    "treasury": {
      "severity": "MEDIUM",
      "description": "Receives the difference between deposit and final balance on closure, and the full deposit when an active expired note is swept. It has no special call authority."
    },
    "paused": {
      "severity": "MEDIUM",
      "description": "Blocks deposit, mutualClose and initiateEscapeWithdrawal. Challenge, finalizeEscapeWithdrawal and claimExpired are unaffected."
    },
    "proofAdapter": {
      "severity": "HIGH",
      "template": "zkapi/Groth16ProofAdapter"
    },
    "stateSigningKeyX": {
      "severity": "HIGH",
      "description": "X coordinate of the Baby-JubJub public key whose signatures authorize non-genesis offchain balance states. The signing key holder controls settlement availability."
    },
    "stateSigningKeyY": { "severity": "HIGH" },
    "clearanceSigningKeyX": {
      "severity": "HIGH",
      "description": "X coordinate of the Baby-JubJub public key whose signature permits immediate cooperative closure. A delayed escape needs no clearance."
    },
    "clearanceSigningKeyY": { "severity": "HIGH" },
    "noteTtl": {
      "severity": "HIGH",
      "description": "Seconds added to deposit time before rounding expiry up to an EXPIRY_BUCKET boundary. After expiry anyone can sweep an active note to the treasury."
    },
    "challengePeriod": {
      "severity": "HIGH",
      "description": "Seconds during which any valid request proof sharing the escape's nullifier cancels it, served or not."
    },
    "requestChargeCap": {
      "severity": "HIGH",
      "description": "Request cap in gwei, enforced by the client and the authorization service only."
    },
    "nativeAssetWeiPerUnit": {
      "description": "Wei per balance unit. Vault balances and event amounts are denominated in whole gwei."
    },
    "currentRoot": {
      "description": "Current root of the active-note Merkle tree."
    },
    "nextNoteId": {
      "description": "Next deposit's sequential note identifier."
    }
  }
}
