{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "ZkApiVault",
  "category": "core",
  "critical": true,
  "description": "Escrows native ETH for anonymous API authorizations. Each deposit creates a publicly identified note. A Groth16 proof closes it with operator clearance or starts a delayed escape withdrawal that can be challenged with a valid request proof sharing its nullifier. The challenge does not prove service acceptance or delivery. Closures reveal the original note id, payout address and remaining balance, and send the consumed balance to the treasury. Anyone can sweep an expired active note entirely to the treasury. Pausing blocks deposits, cooperative closes and new escapes, while challenges, escape finalization and expiry sweeps remain available.",
  "ignoreMethods": ["notes", "pendingWithdrawals", "usedNullifiers"],
  "ignoreInWatchMode": ["currentRoot", "nextNoteId"],
  "fields": {
    "owner": {
      "severity": "MEDIUM",
      "permissions": [
        {
          "type": "interact",
          "description": "pause and unpause deposits, cooperative withdrawals and new escape withdrawals, and change the treasury receiving consumed balances and expired notes. Pausing can prevent users from exiting before their notes become sweepable."
        }
      ]
    },
    "treasury": {
      "severity": "MEDIUM",
      "description": "Receives the difference between deposit and final balance on closure, and the full deposit when an active expired note is swept. It has no special call authority."
    },
    "paused": {
      "severity": "MEDIUM",
      "description": "Blocks deposit, mutualClose and initiateEscapeWithdrawal. Challenge, finalizeEscapeWithdrawal and claimExpired are unaffected."
    },
    "proofAdapter": {
      "severity": "HIGH",
      "template": "zkapi/Groth16ProofAdapter"
    },
    "stateSigningKeyX": {
      "severity": "HIGH",
      "description": "X coordinate of the Baby-JubJub public key whose signatures authorize non-genesis offchain balance states. The signing key holder controls settlement availability."
    },
    "stateSigningKeyY": { "severity": "HIGH" },
    "clearanceSigningKeyX": {
      "severity": "HIGH",
      "description": "X coordinate of the Baby-JubJub public key whose signature permits immediate cooperative closure. A delayed escape does not require clearance."
    },
    "clearanceSigningKeyY": { "severity": "HIGH" },
    "noteTtl": {
      "severity": "HIGH",
      "description": "Seconds added to deposit time before rounding expiry up to an EXPIRY_BUCKET boundary. After expiry anyone can sweep an active note to the treasury."
    },
    "challengePeriod": {
      "severity": "HIGH",
      "description": "Seconds during which an escape can be challenged with a valid request proof sharing its nullifier. The contract does not check whether the operator accepted or serviced that request."
    },
    "requestChargeCap": {
      "severity": "HIGH",
      "description": "Deployment-pinned request cap in gwei, checked by the client and authorization service. The vault does not compare request proof solvencyBound against this cap."
    },
    "nativeAssetWeiPerUnit": {
      "description": "Wei per balance unit. Vault balances and event amounts are denominated in whole gwei."
    },
    "currentRoot": {
      "description": "Current root of the active-note Merkle tree."
    },
    "nextNoteId": {
      "description": "Next deposit's sequential note identifier."
    }
  }
}
