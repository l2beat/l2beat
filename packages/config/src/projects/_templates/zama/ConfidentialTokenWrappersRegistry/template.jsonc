{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "ignoreRelatives": ["getTokenConfidentialTokenPairs"],
  "ignoreMethods": ["proxiableUUID", "getTokenConfidentialTokenPair"],
  "category": "core",
  "description": "Registry for Zama confidential token wrappers.",
  "fields": {
    "confidentialTokens": {
      "description": "Confidential wrappers the registry lists as valid.",
      "handler": {
        "type": "call",
        "method": "function getTokenConfidentialTokenPairs() view returns ((address tokenAddress, address confidentialTokenAddress, bool isValid)[])",
        "args": []
      },
      "edit": [
        "pipe",
        ["filter", ["get", "isValid"]],
        ["map", ["get", "confidentialTokenAddress"]]
      ]
    },
    "owner": {
      "permissions": [
        {
          "type": "interact",
          "description": "manage addresses in the registry"
        }
      ]
    }
  }
}
