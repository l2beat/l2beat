{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "CiphertextCommits",
  "description": "Gateway contract that stores ciphertext and SNS ciphertext digests after coprocessor consensus, allowing decryption requests to reference committed ciphertext material. Digests referencing unregistered or disabled host chains are rejected. Since v0.5.0, if GatewayConfig designates a priority coprocessor, that coprocessor's single submission commits the material on its own.",
  "category": "core",
  "ignoreMethods": [
    "proxiableUUID",
    "getAddCiphertextMaterialConsensusTxSenders",
    "getCiphertextMaterials",
    "getSnsCiphertextMaterials",
    "isCiphertextMaterialAdded"
  ],
  "fields": {
    "gatewayConfig": {
      "description": "GatewayConfig contract used as the source of truth for the gateway owner, coprocessor set, host-chain registry, and coprocessor consensus threshold.",
      "type": "EXTERNAL",
      "handler": {
        "type": "hardcoded",
        "value": "zama:0xDE537Be194777A56f8B19d14079E6a78249390ab"
      }
    },
    "gatewayOwner": {
      "description": "Owner of GatewayConfig. This account authorizes CiphertextCommits upgrades.",
      "severity": "HIGH",
      "type": "PERMISSION",
      "handler": {
        "type": "call",
        "method": "function owner() view returns (address)",
        "args": [],
        "address": "{{ gatewayConfig }}"
      },
      "permissions": [
        {
          "type": "upgrade",
          "description": "upgrade the CiphertextCommits implementation."
        }
      ]
    },
    "gatewayCoprocessorTxSenders": {
      "description": "Coprocessor transaction-sender addresses configured in GatewayConfig. These accounts may submit ciphertext material commitments.",
      "severity": "HIGH",
      "type": "PERMISSION",
      "handler": {
        "type": "call",
        "method": "function getCoprocessorTxSenders() view returns (address[])",
        "args": [],
        "address": "{{ gatewayConfig }}"
      },
      "permissions": [
        {
          "type": "interact",
          "description": "submit ciphertext and SNS ciphertext digests to CiphertextCommits."
        }
      ]
    },
    "gatewayCoprocessorMajorityThreshold": {
      "description": "Minimum number of matching coprocessor submissions required before ciphertext material is committed. Inert while a priority coprocessor is set in GatewayConfig (see gatewayPriorityCoprocessorTxSender).",
      "severity": "HIGH",
      "type": "RISK_PARAMETER",
      "handler": {
        "type": "call",
        "method": "function getCoprocessorMajorityThreshold() view returns (uint256)",
        "args": [],
        "address": "{{ gatewayConfig }}"
      }
    },
    "gatewayPriorityCoprocessorTxSender": {
      "description": "Priority coprocessor transaction sender configured in GatewayConfig, or zero when disabled. While set, this single coprocessor commits ciphertext material on its own and other coprocessor submissions cannot finalize.",
      "severity": "HIGH",
      "type": "PERMISSION",
      "handler": {
        "type": "call",
        "method": "function getPriorityCoprocessorTxSender() view returns (address)",
        "args": [],
        "address": "{{ gatewayConfig }}"
      },
      "permissions": [
        {
          "type": "interact",
          "description": "commit ciphertext and SNS ciphertext digests to CiphertextCommits alone while priority mode is active."
        }
      ]
    }
  }
}
