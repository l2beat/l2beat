{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "ProtocolConfig",
  "description": "Ethereum host-chain registry of KMS node sets, per-context thresholds, and context lifecycle, introduced in the v0.3.0 KMSVerifier upgrade. A KMS context snapshots node transaction senders and signers; the four per-context thresholds (public decryption, user decryption, key generation, MPC) can be retuned by the ACL owner for any live context, including the current one. Since v0.2.0 a context the ACL owner defines starts pending: it activates only after all of its own node transaction senders and n - t transaction senders of the previous committee confirm it, and all of its signers attest the reshared keys of its first epoch. The same owner can instead store a context as active at once through mirrorKmsContextAndEpoch, a path written for replica chains that nothing disables on Ethereum. Older contexts remain selectable for public decryption proofs until destroyed. Expected enclave measurements (PCR values) are emitted with a new context and hashed into its anchor, and no contract checks them.",
  "category": "core",
  "ignoreMethods": [
    "proxiableUUID",
    "getKmsSignersForContext",
    "getKmsNodesForContext",
    "isValidKmsContext",
    "getPublicDecryptionThresholdForContext",
    "getUserDecryptionThresholdForContext",
    "getKmsGenThresholdForContext",
    "getMpcThresholdForContext",
    "getContextCreationPreviousTxSenderThreshold",
    "isLiveKmsContext",
    "isValidEpochForContext",
    "getKmsContextAnchor"
  ],
  "fields": {
    "aclOwner": {
      "description": "Owner of the Zama ACL contract. This account is authorized by onlyACLOwner for all ProtocolConfig administration.",
      "severity": "HIGH",
      "type": "PERMISSION",
      "handler": {
        "type": "call",
        "method": "function owner() view returns (address)",
        "args": [],
        "address": "eth:0xcA2E8f1F656CD25C01F05d0b243Ab1ecd4a8ffb6"
      },
      "permissions": [
        {
          "type": "upgrade",
          "description": "upgrade the ProtocolConfig implementation."
        },
        {
          "type": "interact",
          "description": "define a KMS context with an arbitrary node set and thresholds, which activates once its nodes and a quorum of the previous committee confirm it, or store one as active at once through mirrorKmsContextAndEpoch. Start a resharing epoch, destroy non-current contexts and epochs, and retune the per-context thresholds (public decryption, user decryption, key generation, MPC) of any live context including the current one. A malicious context or lowered threshold can attest an inflated unwrap amount and drain pooled wrapper backing."
        }
      ]
    },
    "getKmsSigners": {
      "description": "KMS signer addresses in the current context. Their signatures are accepted by the Ethereum KMSVerifier for public decryption results and by KMSGeneration for key- and CRS-generation responses. Signers from other live contexts remain authorized for proofs that select their context until that context is destroyed.",
      "severity": "HIGH",
      "type": "PERMISSION",
      "permissions": [
        {
          "type": "interact",
          "description": "sign public decryption results accepted by the KMSVerifier and key- and CRS-generation responses accepted by KMSGeneration."
        }
      ]
    },
    "currentKmsTxSenders": {
      "description": "KMS node transaction-sender addresses in the current context. These accounts submit key- and CRS-generation responses to the Ethereum KMSGeneration contract.",
      "type": "PERMISSION",
      "handler": {
        "type": "call",
        "method": "function getKmsNodesForContext(uint256 kmsContextId) view returns ((address txSenderAddress, address signerAddress, string ipAddress, string storageUrl)[])",
        "args": ["{{ getCurrentKmsContextId }}"]
      },
      "edit": ["map", ["get", "txSenderAddress"]],
      "permissions": [
        {
          "type": "interact",
          "description": "submit KMS key- and CRS-generation responses to KMSGeneration."
        }
      ]
    },
    "getPublicDecryptionThreshold": {
      "description": "Minimum number of KMS signatures from the current context required to accept a public decryption result. Retunable in place by the ACL owner without rotating the context.",
      "severity": "HIGH",
      "type": "RISK_PARAMETER"
    },
    "getUserDecryptionThreshold": {
      "description": "Minimum number of KMS signatures from the current context required for user decryption verification. Retunable in place by the ACL owner without rotating the context.",
      "severity": "HIGH",
      "type": "RISK_PARAMETER"
    },
    "getKmsGenThreshold": {
      "description": "Minimum number of KMS responses from the current context required to reach consensus on key- and CRS-generation results in KMSGeneration.",
      "type": "RISK_PARAMETER"
    },
    "getMpcThreshold": {
      "description": "MPC fault threshold t recorded for the current context: the number of nodes assumed faulty. A new context needs n - t confirmations from this committee.",
      "type": "RISK_PARAMETER"
    },
    "getCurrentKmsContextId": {
      "description": "Identifier of the current KMS context, used by verifiers when a proof does not explicitly select a historical context.",
      "type": "RISK_PARAMETER"
    },
    "definedKmsContexts": {
      "description": "KMS contexts the ACL owner defined through defineNewKmsContextAndEpoch, with the context they replace, their thresholds and software version. A defined context is pending until its nodes and the previous committee's quorum confirm it.",
      "severity": "HIGH",
      "type": "RISK_PARAMETER",
      "handler": {
        "type": "event",
        "select": [
          "contextId",
          "previousContextId",
          "thresholds",
          "softwareVersion"
        ],
        "add": { "event": "NewKmsContext" }
      }
    },
    "mirroredKmsContexts": {
      "description": "KMS contexts the ACL owner stored as active at once through mirrorKmsContextAndEpoch, without confirmations from any committee.",
      "severity": "HIGH",
      "type": "RISK_PARAMETER",
      "handler": {
        "type": "event",
        "select": ["contextId", "epochId", "thresholds", "softwareVersion"],
        "add": { "event": "MirrorKmsContextAndEpoch" }
      }
    },
    "kmsContextConfirmations": {
      "description": "Confirmations of a pending KMS context by transaction senders of the previous and of the new committee.",
      "type": "RISK_PARAMETER",
      "handler": {
        "type": "event",
        "select": [
          "kmsContextId",
          "txSender",
          "isPreviousTxSender",
          "isNewTxSender"
        ],
        "add": { "event": "KmsContextCreationConfirmation" }
      }
    },
    "destroyedKmsContexts": {
      "description": "KMS contexts destroyed by the ACL owner. Destroyed contexts are invalid: their per-context getters revert and public decryption proofs can no longer select them.",
      "severity": "HIGH",
      "type": "RISK_PARAMETER",
      "handler": {
        "type": "event",
        "select": "kmsContextId",
        "add": { "event": "KmsContextDestroyed" }
      }
    }
  }
}
