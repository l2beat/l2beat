{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "AdminVerifierWhitelist",
  "description": "Admin verifier that lets an account register as the manager of an adopter only if a whitelist admin assigned that account to the adopter. It is consulted only at registration. A whitelist admin can also exclude an adopter, which deletes its assignment and blocks new ones until the releaser named in the exclusion lifts it.",
  "ignoreMethods": ["DEFAULT_ADMIN_ROLE", "WHITELIST_ADMIN_ROLE"],
  "fields": {
    "defaultAdmin": {
      "severity": "HIGH",
      "handler": {
        "type": "accessControl",
        "pickRoleMembers": "DEFAULT_ADMIN_ROLE"
      },
      "permissions": [
        {
          "type": "interact",
          "description": "grant and revoke the admin and whitelist admin roles."
        }
      ]
    },
    "whitelistAdmins": {
      "severity": "HIGH",
      "handler": {
        "type": "accessControl",
        "pickRoleMembers": "WHITELIST_ADMIN_ROLE"
      },
      "permissions": [
        {
          "type": "interact",
          "description": "assign the account that may register as the manager of each adopter and exclude adopters from registration."
        }
      ]
    },
    "assignedManagers": {
      "description": "The account each adopter's manager registration is assigned to.",
      "severity": "MEDIUM",
      "handler": {
        "type": "event",
        "select": ["assertionAdopter", "admin"],
        "dedupBy": "assertionAdopter",
        "add": { "event": "WhitelistAdded" },
        "remove": { "event": "WhitelistRemoved" },
        "ignoreRelative": true
      }
    },
    "exclusions": {
      "description": "Adopters excluded from registration and the account that can lift each exclusion.",
      "severity": "MEDIUM",
      "handler": {
        "type": "event",
        "select": ["assertionAdopter", "releaser"],
        "dedupBy": "assertionAdopter",
        "add": { "event": "ExclusionAdded" },
        "remove": { "event": "ExclusionReleased" },
        "ignoreRelative": true
      }
    }
  }
}
