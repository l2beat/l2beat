{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "AdminVerifierSuperAdmin",
  "description": "Admin verifier that approves only holders of SUPER_ADMIN_ROLE, so each of them can become the manager of any adopter that has none.",
  "ignoreMethods": ["DEFAULT_ADMIN_ROLE", "SUPER_ADMIN_ROLE"],
  "fields": {
    "defaultAdmin": {
      "severity": "HIGH",
      "handler": {
        "type": "accessControl",
        "pickRoleMembers": "DEFAULT_ADMIN_ROLE"
      },
      "permissions": [
        {
          "type": "interact",
          "description": "grant and revoke the admin and super admin roles."
        }
      ]
    },
    "superAdmins": {
      "severity": "HIGH",
      "handler": {
        "type": "accessControl",
        "pickRoleMembers": "SUPER_ADMIN_ROLE"
      },
      "permissions": [
        {
          "type": "interact",
          "description": "register as the manager of any adopter without one on State Oracles that use this verifier."
        }
      ]
    }
  }
}
