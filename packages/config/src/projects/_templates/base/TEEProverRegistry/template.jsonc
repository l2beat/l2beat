{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "TEEProverRegistry",
  "critical": true,
  "description": "Registry of authorized TEE enclave signers and proposer addresses used by the TEEVerifier. Owner can add or remove allowlisted proposers via setProposer (onlyOwner) and set the AggregateVerifier game type lookup. Owner and Manager can register or deregister enclave signers via registerSigner / deregisterSigner. Registration requires a valid AWS Nitro attestation document.",
  "fields": {
    "getExpectedImageHash": {
      "severity": "HIGH"
    },
    "manager": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "register and deregister TEE enclave signers and transfer the manager role."
        }
      ]
    },
    "owner": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "add or remove allowlisted proposers, set the game type, and register or deregister TEE enclave signers."
        }
      ]
    },
    "$admin": {
      "severity": "HIGH"
    },
    "gameType": {
      "severity": "HIGH"
    }
  }
}
