{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "TEEProverRegistry",
  "critical": true,
  "description": "Registry of authorized TEE enclave signers and proposer addresses. Signer registration requires a valid AWS Nitro attestation document.",
  "fields": {
    // Not HIGH: read live from DISPUTE_GAME_FACTORY.gameImpls(gameType).TEE_IMAGE_HASH(),
    // so it duplicates the HIGH game implementation field of the DisputeGameFactory.
    "getExpectedImageHash": {
      "description": "TEE image hash (PCR0) of the AggregateVerifier registered in the DisputeGameFactory for gameType. Derived, not stored in this contract."
    },
    // Operator role: registers signers that hold a valid Nitro attestation and
    // can deregister them (liveness), it cannot change what is accepted.
    "manager": {
      "severity": "MEDIUM",
      "permissions": [
        {
          "type": "interact",
          "description": "register and deregister TEE enclave signers and transfer the manager role."
        }
      ]
    },
    "owner": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "add or remove allowlisted proposers, set the game type, and register or deregister TEE enclave signers."
        }
      ]
    },
    "$admin": {
      "severity": "HIGH"
    },
    "gameType": {
      "severity": "HIGH"
    }
  }
}
