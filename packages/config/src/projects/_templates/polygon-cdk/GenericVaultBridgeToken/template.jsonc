{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "This token contract uses a standard 'vault bridge token' implementation created by Agglayer CDK. It keeps deposited assets in a vault and issues an IOU token ({{name}}) which can be deposited to Agglayer. The underlying asset is generating yield, which does not accrue to the {{symbol}}-IOU but is sent to {{yieldRecipient}}.",
  "category": "bridge-external",
  "ignoreRelatives": ["asset", "underlyingToken", "yieldVault"],
  "ignoreInWatchMode": [
    "backingDifference",
    "stakedAssets",
    "totalAssets",
    "totalSupply",
    "yield"
  ],
  "ignoreMethods": [
    "convertToAssets",
    "convertToShares",
    "previewDeposit",
    "previewMint",
    "previewRedeem",
    "previewWithdraw"
  ],
  "fields": {
    // vault-bridge escrows are outside the ossification perimeter (TVS counts them
    // with additional trust assumptions): important state is MEDIUM so changes
    // surface without touching the clock.
    "accessControl": {
      "severity": "MEDIUM",
      "handler": {
        "type": "accessControl"
      }
    },
    "yieldVault": {
      "severity": "MEDIUM",
      "description": "external vault where the underlying backing assets are deposited to generate yield."
    },
    "yieldRecipient": {
      "severity": "MEDIUM"
    },
    "migrationManager": {
      "severity": "MEDIUM"
    },
    "minimumReservePercentage": {
      "severity": "MEDIUM",
      "description": "share of the underlying that must stay in reserve instead of being deposited into the yield vault."
    },
    "paused": {
      "severity": "MEDIUM"
    }
  }
}
