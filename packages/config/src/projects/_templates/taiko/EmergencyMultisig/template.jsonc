{
  // ossification: the DAO governance stack controls Taiko contracts only since the TaikoDAOController accepted
  // ownership of the Taiko Token from the Taiko Multisig (tx 0xa4dfb666..., 2025-06-06); earlier set-up
  // changes (e.g. the 2025-06-04 test signer removal) could not affect Taiko. Template used only by taiko.
  "critical": { "sinceTimestamp": 1749196415 },
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Modular Governance contract allowing for proposing, voting on and executing encrypted proposals (e.g. for Security Council emergency proposals).",
  "ignoreMethods": ["canExecute", "getProposal", "proxiableUUID"],
  "fields": {
    "proposalCount": {
      "description": "total count of encrypted emergency proposals created."
    },
    "multisigSettings": {
      "severity": "HIGH",
      "description": "the threshold in the SignerList needs to be changed manually if it changes here"
    },
    "dao": {
      "permissions": [
        {
          "type": "interact",
          "description": "manage critical settings (e.g. threshold and multisig settings) for the emergency proposal governance path."
        }
      ]
    },
    "minApprovals": {
      "severity": "HIGH",
      "copy": "multisigSettings",
      "edit": ["get", "minApprovals"]
    }
  }
}
