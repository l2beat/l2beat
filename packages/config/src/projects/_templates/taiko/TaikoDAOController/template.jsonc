{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "name": "TaikoDAOController",
  "description": "Middleware contract that maintains ownership of DAO-controlled assets and contracts. Its token weight does not count towards the DAO quorum.",
  "category": "gov",
  "ignoreMethods": ["proxiableUUID"],
  "fields": {
    "$admin": { "severity": "MEDIUM" },
    "owner": {
      "severity": "MEDIUM",
      "permissions": [{ "type": "act" }]
    },
    "paused": { "severity": "MEDIUM" }
  }
}
