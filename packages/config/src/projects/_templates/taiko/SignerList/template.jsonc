{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "SignerList (Security Council)",
  // ossification: the DAO governance stack controls Taiko contracts only since the TaikoDAOController accepted
  // ownership of the Taiko Token from the Taiko Multisig (tx 0xa4dfb666..., 2025-06-06); earlier set-up
  // changes (e.g. the 2025-06-04 test signer removal) could not affect Taiko. Template used only by taiko.
  "critical": { "sinceTimestamp": 1749196415 },
  "description": "A signer list for storing multisig members and their agents, stores the addresses of the Multisigs that use this signer list. Each signer delegates their permissions to their agent address that they can configure here.",
  "ignoreMethods": ["addresslistLengthAtBlock", "getEncryptionAgents"],
  "ignoreRelatives": ["settings"],
  "fields": {
    "multisigSigners": {
      "handler": {
        "type": "event",
        "select": "signers",
        "flatten": true,
        "add": {
          "event": "SignersAdded"
        },
        "remove": {
          "event": "SignersRemoved"
        }
      },
      "permissions": [
        {
          "type": "interact",
          "description": "configure an agent address that represents this entity in the Security Council"
        }
      ]
    },
    "$members": {
      // agents getting the direct act permissions
      "handler": {
        "type": "call",
        "method": "function getEncryptionAgents() view returns (address[] result)",
        "args": []
      }
    },
    "$threshold": {
      "description": "Emergency multisig approval threshold, mirrored from the EmergencyMultisig contract.",
      "handler": {
        "type": "hardcoded",
        "value": 4
      }
    },
    "settings": {
      "severity": "HIGH"
    },
    "dao": {
      "permissions": [
        {
          "type": "interact",
          "description": "add/remove members from the Security Council and change its minimum size."
        }
      ]
    }
  }
}
