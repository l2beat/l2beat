{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "UniswapV3Factory",
  "critical": true,
  "description": "Deploys Uniswap v3 pools: anyone can create one pool per token pair and enabled fee tier, at a CREATE2 address deterministic in (token0, token1, fee). Immutable. Its owner holds exactly three powers: enable new fee tiers (irreversible), call setFeeProtocol/collectProtocol on pools, and transfer the owner role. It cannot modify, pause, or upgrade deployed pools.",
  "ignoreInWatchMode": ["parameters"],
  "fields": {
    "owner": {
      "permissions": [
        {
          "type": "interact",
          "description": "can enable new fee tiers, set the protocol fee share (up to 1/4 of LP fees per side) on any pool, collect accrued protocol fees, and transfer factory ownership."
        }
      ],
      "severity": "HIGH",
      "description": "Address authorized to exercise the factory owner actions."
    },
    "parameters": {
      "description": "Transient slot used to pass constructor parameters to pools during CREATE2 deployment; zero outside of a pool deployment."
    }
  }
}
