{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "Timelock",
  "description": "Compound-style timelock and the executive account of Uniswap governance: it is the UNI minter, the owner of the V3OpenFeeAdapter (and through it the v3 factory), the v4 PoolManager owner, and the TokenJar owner. Every queued transaction waits the fixed delay ({{delayFormatted}}) and expires after the grace period ({{gracePeriodFormatted}}). Its admin is the GovernorBravo proxy, so only passed proposals can queue actions; there is no emergency bypass.",
  "fields": {
    "delayFormatted": {
      "handler": { "type": "call", "method": "delay", "args": [] },
      "edit": ["format", "FormatSeconds"]
    },
    "gracePeriodFormatted": {
      "handler": { "type": "call", "method": "GRACE_PERIOD", "args": [] },
      "edit": ["format", "FormatSeconds"]
    },
    "admin": {
      "permissions": [
        { "type": "act", "delay": "{{delay}}" },
        {
          "type": "interact",
          "description": "can queue, cancel, and execute timelocked transactions, and change the delay or admin (through the timelock itself)."
        }
      ],
      "severity": "HIGH"
    },
    "delay": {
      "description": "Seconds every queued transaction must wait before execution.",
      "severity": "HIGH"
    }
  }
}
