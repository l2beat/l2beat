{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "UniswapV3Pool",
  "critical": true,
  "description": "A concentrated-liquidity AMM pool for one token pair at one fee tier, deployed by the factory and fully immutable: no owner, no pause, no upgrade path. LPs provide liquidity on tick ranges; swap fees accrue to in-range positions. The factory owner can divert up to 1/4 of the swap fee per side as protocol fee. Also a TWAP oracle whose observation buffer anyone can grow.",
  "ignoreMethods": ["observations", "ticks", "tickBitmap", "positions"],
  "ignoreRelatives": [
    "token0",
    "token1",
    "feeGrowthGlobal0X128",
    "feeGrowthGlobal1X128"
  ],
  "ignoreInWatchMode": [
    "slot0",
    "liquidity",
    "feeGrowthGlobal0X128",
    "feeGrowthGlobal1X128",
    "protocolFees"
  ],
  "fields": {
    "slot0": {
      "description": "Current sqrtPriceX96, tick, oracle observation index/cardinality, protocol fee setting, and the reentrancy lock; changes with every swap."
    },
    // Q128.128 accumulators; large uints in the 160-bit range get misread as
    // addresses by the relative detector.
    "feeGrowthGlobal0X128": {
      "ignoreRelative": true
    },
    "feeGrowthGlobal1X128": {
      "ignoreRelative": true
    },
    "protocolFees": {
      "description": "Protocol fees accrued and not yet collected by the factory owner."
    }
  }
}
