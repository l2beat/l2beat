{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "V3OpenFeeAdapter",
  "description": "Owns the UniswapV3Factory since the UNIfication proposal. Governance (owner and feeSetter, both the Timelock) sets the protocol-fee schedule: a global default, per-tier defaults, and per-pool overrides, each 0 or between 1/10 and 1/4 of LP fees per side. Anyone can push the configured fee onto pools and collect accrued protocol fees, which go only to the TokenJar. The owner can also enable new fee tiers and transfer factory ownership.",
  "fields": {
    "owner": {
      "permissions": [
        {
          "type": "interact",
          "description": "can enable new fee tiers, change the feeSetter, and transfer UniswapV3Factory ownership to a new contract."
        }
      ],
      "severity": "HIGH"
    },
    "feeSetter": {
      "permissions": [
        {
          "type": "interact",
          "description": "sets the protocol fee schedule (global default, per-tier defaults, per-pool overrides) that anyone can then apply to pools."
        }
      ],
      "severity": "HIGH"
    },
    "defaultFee": {
      "description": "Packed per-side protocol fee applied to pools without an override; two 4-bit denominators (68 = 4|4<<4 = 1/4 of LP fees each side)."
    }
  }
}
