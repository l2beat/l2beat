{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "TornadoCash_Eth_01",
  "critical": true,
  "category": "core",
  "ignoreMethods": ["filledSubtrees", "roots", "zeros"],
  "fields": {
    "denomination": {
      "description": "Fixed ETH amount accepted by this pool.",
      "severity": "LOW"
    },
    "operator": {
      "description": "Legacy operator role retained from the trusted-setup phase.",
      "permissions": [
        {
          "type": "interact",
          "description": "replace the withdrawal verifier."
        },
        {
          "type": "interact",
          "description": "transfer the operator role and perform the one-time legacy state migration."
        }
      ]
    },
    "operatorRenounced": {
      "description": "Whether verifier-upgrade and migration authority has been permanently renounced.",
      "severity": "HIGH",
      "copy": "operator",
      "edit": ["=", "eth:0x0000000000000000000000000000000000000000"]
    },
    "verifier": {
      "description": "zkSNARK verifier used to authorize withdrawals from the pool.",
      "severity": "HIGH"
    },
    "isMigrated": {
      "description": "Whether the one-time legacy state migration path has already been used. If true, this pool behaves like the ones without this function.",
      "severity": "HIGH"
    }
  },
  "ignoreInWatchMode": ["currentRootIndex", "getLastRoot", "nextIndex"]
}
