{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "cTornado",
  "critical": true,
  "category": "core",
  "ignoreMethods": ["filledSubtrees", "roots", "zeros"],
  "fields": {
    "denomination": {
      "description": "Fixed cToken amount accepted by this pool.",
      "severity": "LOW"
    },
    "token": {
      "severity": "HIGH",
      "description": "cToken accepted by this mixer instance."
    },
    "verifier": {
      "severity": "HIGH",
      "description": "Immutable zkSNARK verifier used to authorize withdrawals from the pool."
    },
    "hasher": {
      "severity": "HIGH",
      "description": "Merkle-tree hasher used for commitments and root updates."
    },
    "comp": {
      "description": "COMP token accrued by the cToken position and claimable to governance.",
      "severity": "LOW"
    },
    "governance": {
      "description": "Recipient of claimed COMP rewards from this pool. It has no other permissions on the pool.",
      "severity": "LOW"
    }
  },
  "ignoreInWatchMode": ["currentRootIndex", "getLastRoot", "nextIndex"]
}
