{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "NegRiskAdapter",
  "description": "Immutable adapter composing binary conditions into multi-outcome (negative-risk) markets and acting as the on-ledger oracle for them. Split, merge, redeem and conversion functions have no caller restriction; conversions can charge a per-market fee that accrues to a fixed vault.",
  "category": "core",
  "fields": {
    "admins": {
      "handler": {
        "type": "event",
        "ignoreRelative": true,
        "select": "member",
        "add": {
          "event": "event NewAdmin(address indexed admin, address indexed member)"
        },
        "remove": {
          "event": "event RemovedAdmin(address indexed admin, address indexed member)"
        }
      },
      "permissions": [
        {
          "type": "act",
          "description": "can transfer outcome tokens on behalf of a user through this adapter, but only if the user has independently approved both the admin and this adapter as operators on the token ledger, and can add or remove admins."
        }
      ],
      "severity": "HIGH"
    },
    "vault": {
      "description": "Address receiving the per-market fees charged on position conversions.",
      "handler": {
        "type": "call",
        "method": "vault",
        "args": []
      },
      "severity": "HIGH"
    },
    "wcol": {
      "description": "Wrapped-collateral token deployed and owned by this adapter, used as the collateral asset on the underlying conditional-token ledger."
    },
    "adminsEverObserved": {
      "handler": {
        "type": "event",
        "ignoreRelative": true,
        "select": "admin",
        "add": [
          {
            "event": "event NewAdmin(address indexed admin, address indexed member)"
          },
          {
            "event": "event RemovedAdmin(address indexed admin, address indexed member)"
          }
        ]
      },
      "description": "Every address ever observed exercising an admin power, taken from the granter recorded in each authorization event. The authorization mixin grants admin in the constructor without emitting an event, so such an admin is invisible in the added/removed sets and only shows up here. The list is historical and not a live permission set - confirm current status with isAdmin().",
      "severity": "HIGH"
    }
  }
}
