{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "SafeProxyFactory",
  "proxyType": "immutable",
  "description": "Deterministic factory for single-owner Safe proxies. Anyone can submit an EIP-712 creation signature to deploy a wallet owned by the recovered signer at an address derived from that signer.",
  "category": "core",
  "fields": {
    "masterCopy": {
      "description": "Wallet singleton that every deployed proxy delegates to. Set in the constructor, no setter exists."
    },
    "fallbackHandler": {
      "description": "Fallback handler configured on every deployed wallet. Set in the constructor, no setter exists."
    }
  }
}
