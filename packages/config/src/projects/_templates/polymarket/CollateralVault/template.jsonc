{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "CollateralVault",
  "description": "ERC-4337 smart account holding the stablecoin that backs the collateral token. Its owner can execute arbitrary calls from the account, giving it full control over the held funds.",
  "ignoreRelatives": ["ENTRY_POINT", "getEntryPoint", "PLUGIN_MANAGER"],
  "ignoreMethods": ["proxiableUUID"],
  "fields": {
    "getNativeOwner": {
      "permissions": [
        {
          "type": "upgrade",
          "description": "can execute arbitrary calls from the vault, install or uninstall plugins, and upgrade the account implementation, giving it full control over the underlying collateral held here."
        }
      ],
      "severity": "HIGH"
    }
  }
}
