{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "CollateralVault",
  "description": "Upgradeable ERC-4337 single-owner smart account. Its owner can execute arbitrary calls, install or uninstall plugins, and upgrade the implementation, giving it full control over any assets held by the account.",
  "ignoreRelatives": ["ENTRY_POINT", "getEntryPoint", "PLUGIN_MANAGER"],
  "ignoreMethods": ["proxiableUUID"],
  "fields": {
    "getNativeOwner": {
      "permissions": [
        {
          "type": "upgrade",
          "description": "can execute arbitrary calls from the account, install or uninstall plugins, and upgrade the implementation, giving it full control over any assets held by the account."
        }
      ],
      "severity": "HIGH"
    }
  }
}
