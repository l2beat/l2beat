{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "CombinatorialModule",
  "description": "Upgradeable outcome module for combinatorial positions built from legs of other modules; payouts derive from the legs' resolved payouts. Position preparation, transformation and redemption functions have no caller restriction. Bridge-role holders can mint positions without collateral backing.",
  "ignoreMethods": ["proxiableUUID"],
  "fields": {
    "roleHolders": {
      "handler": {
        "type": "event",
        "select": ["user", "roles"],
        "add": { "event": "RolesUpdated" },
        "dedupBy": "user"
      },
      "severity": "HIGH",
      "description": "Role bitmask per address, reconstructed from role-update events. Only bit 0 (1), the admin role, and bit 3 (8), the bridge role, are checked to restrict calls. Granting any other role bit gives no additional access in this contract."
    },
    "owner": {
      "permissions": [
        {
          "type": "upgrade",
          "description": "can upgrade the module implementation and manage all roles."
        }
      ],
      "severity": "HIGH"
    },
    "POSITION_MANAGER": {
      "description": "The outcome-token ledger this module mints and burns positions on."
    },
    "COLLATERAL_TOKEN": {
      "description": "The collateral token minted and burned by this module on split, merge and redemption."
    }
  }
}
