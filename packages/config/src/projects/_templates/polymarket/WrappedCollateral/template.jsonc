{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "WrappedCollateral",
  "description": "ERC20 wrapper around an underlying token, owned by the single adapter contract that deployed it (the owner is immutable, fixed at deployment). Anyone can unwrap: burning wrapper units releases the same amount of the underlying. Only the owner can wrap (deposit underlying and mint) and, more importantly, mint wrapper units without any underlying backing and release arbitrary amounts of the underlying held by this contract to any recipient.",
  "category": "core",
  "fields": {
    "owner": {
      "description": "Adapter contract fixed at deployment.",
      "permissions": [
        {
          "type": "interact",
          "description": "can mint wrapper units without underlying backing and release arbitrary amounts of the underlying held by this contract to any recipient. This owner is immutable and cannot be changed."
        }
      ],
      "severity": "HIGH"
    },
    "underlying": {
      "description": "Underlying token backing the circulating wrapper supply."
    },
    "totalSupply": {
      "description": "Circulating supply of the wrapper token.",
      "ignoreInWatchMode": true
    }
  }
}
