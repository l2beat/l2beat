{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "WrappedCollateral",
  "description": "ERC20 wrapper around an immutable underlying token. Its immutable owner is the deployer. Anyone can burn their wrapper units to send an equal amount of underlying to any recipient; only the owner can wrap, mint without depositing underlying, burn its own units, and release underlying held by the contract.",
  "category": "core",
  "fields": {
    "owner": {
      "description": "Immutable owner set to the deployer.",
      "permissions": [
        {
          "type": "interact",
          "description": "can deposit underlying and mint wrapper units to any recipient, mint units to itself without depositing underlying, burn its own units, and release underlying held by the contract to any recipient. This owner is immutable and cannot be changed."
        }
      ],
      "severity": "HIGH"
    },
    "underlying": {
      "description": "Immutable token transferred into the contract on wrapping and out on unwrapping or owner release."
    },
    "totalSupply": {
      "description": "Total supply of the wrapper token.",
      "ignoreInWatchMode": true
    }
  }
}
