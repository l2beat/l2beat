{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "UpgradeExecutor",
  "critical": true,
  "category": "gov",
  "description": "Central contract defining the access control permissions for upgrading the system contract implementations.",
  "fields": {
    "$admin": {
      "severity": "MEDIUM"
    },
    // Role holders: MEDIUM puts every change under review. A mechanism change
    // (new authority structure, not a Safe swap) is a reviewed event.
    "accessControl": {
      "severity": "MEDIUM",
      "handler": {
        "type": "accessControl"
      }
    },
    "executors": {
      "severity": "MEDIUM",
      "handler": {
        "type": "accessControl",
        "pickRoleMembers": "EXECUTOR_ROLE"
      },
      "permissions": [{ "type": "act" }]
    }
  }
}
