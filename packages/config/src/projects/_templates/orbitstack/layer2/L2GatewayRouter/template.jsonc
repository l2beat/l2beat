{
  "$schema": "../../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "L2GatewayRouter",
  "critical": true,
  "category": "bridge-canonical",
  "description": "Router managing token <–> gateway mapping on L2.",
  "ignoreRelatives": ["counterpartGateway"],
  "fields": {
    "defaultGateway": {
      "severity": "HIGH"
    },
    "router": {
      "severity": "HIGH"
    },
    "counterpartGateway": {
      "severity": "HIGH",
      "edit": ["format", "EthereumAddress"]
    },
    "$admin": {
      "severity": "MEDIUM"
    }
  }
}
