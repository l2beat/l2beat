{
  "$schema": "../../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "L2ArbitrumToken",
  "critical": true,
  "description": "The ARB token contract. Supply can be increased by the owner once per year by a maximum of {{ mintCapPerYer }}%.",
  "ignoreMethods": ["getPastTotalSupply", "getTotalDelegationAt"],
  "ignoreInWatchMode": ["getTotalDelegation"],
  "fields": {
    "l1Address": {
      "severity": "HIGH"
    },
    "MIN_MINT_INTERVAL": {
      "severity": "HIGH"
    },
    "MINT_CAP_DENOMINATOR": {
      "severity": "HIGH"
    },
    "MINT_CAP_NUMERATOR": {
      "severity": "HIGH"
    },
    "owner": {
      "severity": "HIGH"
    },
    "$admin": {
      "severity": "HIGH"
    },
    "mintCapPerYer": {
      "severity": "HIGH",
      "handler": {
        "type": "call",
        "method": "MINT_CAP_NUMERATOR",
        "args": []
      },
      "edit": ["format", "Undecimal2"],
      "description": "The percentage of the total supply that can be minted by the owner once per year."
    }
  }
}
