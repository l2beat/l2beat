{
  "$schema": "../../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "L2UpgradeExecutor",
  "critical": true,
  "category": "gov",
  "description": "This contract can upgrade the L2 system's contracts through the L2ProxyAdmin. The upgrades can be done either by the Security Council or by the L1Timelock (via its alias on L2).",
  "fields": {
    // Hardcoded precompile address (0x..74): the value cannot change. The
    // filterer set is watched on the ArbFilteredTransactionsManager entry.
    "transactionFilteringPrecompile": {},
    "$admin": {
      "severity": "MEDIUM"
    },
    // Role holders: MEDIUM puts every change under review. A mechanism change
    // (new authority structure, not a Safe swap) is a reviewed event.
    "accessControl": {
      "severity": "MEDIUM",
      "handler": {
        "type": "accessControl"
      }
    },
    "executors": {
      "severity": "MEDIUM",
      "handler": {
        "type": "accessControl",
        "pickRoleMembers": "EXECUTOR_ROLE"
      },
      "permissions": [{ "type": "act" }]
    }
  }
}
