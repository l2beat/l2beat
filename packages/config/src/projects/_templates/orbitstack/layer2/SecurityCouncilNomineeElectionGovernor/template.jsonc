{
  "critical": true,
  "$schema": "../../../../../../../discovery/schemas/contract.v2.schema.json",
  "category": "gov",
  "description": "Token governance contract for the Security Council nominee elections.",
  "ignoreMethods": [
    "compliantNomineeCount",
    "compliantNominees",
    "electionIndexToCohort",
    "electionIndexToDescription",
    "electionToTimestamp",
    "excludedNomineeCount",
    "getPastCirculatingSupply",
    "getProposeArgs",
    "nomineeCount",
    "nominees",
    "proposalDeadline",
    "proposalSnapshot",
    "proposalVettingDeadline",
    "quorum"
  ],
  "fields": {
    // Solidity constant: only changes with an implementation upgrade.
    "ROTATION_CUT_OFF_BLOCKS": {},
    // MEDIUM: the election schedule (with votingDelay and votingPeriod) times
    // who fills the seats, not what the council can do.
    "firstNominationStartDate": {
      "severity": "MEDIUM"
    },
    "cadenceInMonths": {
      "severity": "MEDIUM"
    },
    "nomineeVettingDuration": {
      "severity": "MEDIUM"
    },
    // Role holder (the vetting address), not a rule change.
    "nomineeVetter": {
      "severity": "MEDIUM"
    },
    "securityCouncilMemberElectionGovernor": {
      "severity": "HIGH"
    },
    "securityCouncilManager": {
      "severity": "HIGH"
    },
    "quorumDenominator": {
      "severity": "HIGH"
    },
    "quorumNumerator": {
      "severity": "HIGH"
    },
    "votingPeriod": {
      "severity": "MEDIUM"
    },
    "votingDelay": {
      "severity": "MEDIUM"
    },
    "proposalThreshold": {
      "severity": "HIGH"
    },
    "token": {
      "severity": "HIGH"
    },
    "owner": {
      "severity": "MEDIUM"
    },
    "$admin": {
      "severity": "MEDIUM"
    }
  }
}
