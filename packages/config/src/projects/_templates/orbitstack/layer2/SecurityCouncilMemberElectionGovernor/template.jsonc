{
  "critical": true,
  "$schema": "../../../../../../../discovery/schemas/contract.v2.schema.json",
  "category": "gov",
  "description": "Token governance contract for the Security Council member elections.",
  "ignoreMethods": [
    "electionIndexToCohort",
    "electionIndexToDescription",
    "fullWeightVotingDeadline",
    "getProposeArgs",
    "proposalDeadline",
    "proposalSnapshot",
    "quorum",
    "state",
    "topNominees"
  ],
  "fields": {
    "fullWeightDuration": {
      "severity": "HIGH"
    },
    "nomineeElectionGovernor": {
      "severity": "HIGH"
    },
    "securityCouncilManager": {
      "severity": "HIGH"
    },
    "votingPeriod": {
      "severity": "HIGH"
    },
    "votingDelay": {
      "severity": "HIGH"
    },
    "proposalThreshold": {
      "severity": "HIGH"
    },
    "token": {
      "severity": "HIGH"
    },
    "owner": {
      "severity": "HIGH"
    },
    "$admin": {
      "severity": "HIGH"
    }
  }
}
