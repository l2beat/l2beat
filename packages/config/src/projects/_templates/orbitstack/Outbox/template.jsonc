{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "Outbox",
  "critical": true,
  "description": "Facilitates L2 to L1 contract calls: Messages initiated from L2 (for example withdrawal messages) eventually resolve in execution on L1.",
  "ignoreMethods": ["spent", "isSpent"],
  "category": "bridge-canonical",
  "fields": {
    // updateRollupAddress() re-points who may call updateSendRoot(): a
    // swapped rollup can insert arbitrary withdrawal roots.
    "rollup": {
      "severity": "HIGH"
    },
    "bridge": {
      "severity": "HIGH"
    },
    "$admin": {
      "severity": "MEDIUM"
    }
  }
}
