{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "PoolVault",
  "critical": true,
  "category": "core",
  "description": "Holds every pool asset and the state tree of note commitments and spent nullifiers.",
  "ignoreInWatchMode": ["currentRootIndex"],
  "ignoreMethods": [
    "commitments",
    "isKnownRoot",
    "proxiableUUID",
    "roots",
    "spentNullifiers"
  ],
  "fields": {
    "aspRegistry": {
      "description": "Registry whose latest root every transact proof must match.",
      "severity": "HIGH"
    },
    "keystore": {
      "description": "Registry of account auth policies and viewing keys whose roots transact and ragequit proofs must match.",
      "severity": "HIGH"
    },
    "depositVerifier": {
      "severity": "HIGH"
    },
    "ragequitVerifier": {
      "severity": "HIGH"
    },
    "maxStateTreeSize": {
      "description": "Capacity of the state tree in leaves. A full tree stops deposits, transacts and ragequits.",
      "severity": "LOW"
    },
    "rootHistorySize": {
      "description": "Number of recent state roots a transact proof may be built against."
    },
    "paused": {
      "description": "Pauses deposits and transacts. Ragequit stays open.",
      "severity": "MEDIUM"
    },
    "transactVerifier1x1": {
      "description": "Groth16 verifier and selector for transact proofs spending 1 note and creating 1 note.",
      "severity": "HIGH",
      "handler": {
        "type": "call",
        "method": "function verifiers(bytes32) view returns ((address addr, bytes4 selector))",
        "args": [
          "0xcc69885fda6bcc1a4ace058b4a62bf5e179ea78fd58a1ccd71c22cc9b688792f"
        ]
      }
    },
