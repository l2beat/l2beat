{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "PPRouter",
  "category": "core",
  "description": "Yield router for one share token. It wraps deposits of the underlying into shares, and unwraps withdrawn shares to pay the recipient and the relayer fee.",
  "ignoreMethods": ["quote", "quoteWithdraw"],
  "ignoreRelatives": ["POOL", "UNDERLYING", "A_TOKEN"],
  "fields": {
    "DUST_RECIPIENT": {
      "description": "Address that can skim aToken dust left in the router."
    },
    "NATIVE_MODE": {
      "description": "If true, the router takes ETH, wraps it and supplies WETH."
    }
  }
}
