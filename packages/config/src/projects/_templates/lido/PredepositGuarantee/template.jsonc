{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Protects StakingVault deposits by proving validator withdrawal credentials and requiring an initial predeposit before the remaining validator deposit is sent.",
  "category": "core",
  "ignoreRelatives": ["BEACON_ROOTS"],
  "fields": {
    "accessControl": {
      "handler": {
        "type": "accessControl",
        "includeEmptyRoles": true,
        "roleNames": {
          "0x8d0e4ae4847b49935b55c99f9c3ce025c87e7c4604c35b7ae56929bd32fa5a78": "PAUSE_ROLE",
          "0xa79a6aede309e0d48bf2ef0f71355c06ad317956d4c0da2deb0dc47cc34f826c": "RESUME_ROLE"
        }
      }
    },
    "defaultAdmins": {
      "copy": "accessControl",
      "edit": ["get", "DEFAULT_ADMIN_ROLE", "members"],
      "permissions": [
        {
          "type": "interact",
          "description": "grant or revoke PredepositGuarantee roles."
        }
      ]
    },
    "pausers": {
      "copy": "accessControl",
      "edit": ["get", "PAUSE_ROLE", "members"],
      "permissions": [
        {
          "type": "interact",
          "description": "pause predeposit proving and validator-deposit operations for a chosen duration."
        }
      ]
    },
    "resumers": {
      "copy": "accessControl",
      "edit": ["get", "RESUME_ROLE", "members"],
      "permissions": [
        {
          "type": "interact",
          "description": "resume predeposit proving and validator-deposit operations."
        }
      ]
    }
  }
}
