{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Stores key-value configuration consumed by Lido's off-chain oracle daemon.",
  "category": "core",
  "fields": {
    "accessControl": {
      "handler": { "type": "accessControl", "includeEmptyRoles": true }
    },
    "defaultAdmins": {
      "copy": "accessControl",
      "edit": ["get", "DEFAULT_ADMIN_ROLE", "members"],
      "permissions": [
        {
          "type": "interact",
          "description": "grant or revoke OracleDaemonConfig roles."
        }
      ]
    },
    "configManagers": {
      "copy": "accessControl",
      "edit": ["get", "CONFIG_MANAGER_ROLE", "members"],
      "permissions": [
        {
          "type": "interact",
          "description": "create, update, or remove arbitrary oracle-daemon configuration values."
        }
      ]
    }
  }
}
