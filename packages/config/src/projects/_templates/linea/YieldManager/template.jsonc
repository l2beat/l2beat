{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "critical": true,
  "description": "Manages flows of ETH and staked ETH in and out of rollup contract reserves. Tracks the available ETH balance for L2 exits, configures target parameters for amount of staked ETH, communicates with yield provider adaptors.",
  "ignoreMethods": [
    "getEffectiveMinimumWithdrawalReserve",
    "getEffectiveTargetWithdrawalReserve",
    "getMinimumReserveDeficit",
    "getTargetReserveDeficit",
    "getTotalSystemBalance",
    "pendingPermissionlessUnstake"
  ],
  "ignoreInWatchMode": ["userFundsInYieldProvidersTotal"],
  "fields": {
    "userFundsInYieldProvidersTotal": {
      "description": "User ETH principal currently deployed into yield providers (staked), excluding accrued yield. Together with the rollup and YieldManager balances it forms the total system balance used for the reserve thresholds."
    },
    "accessControl": {
      "handler": { "type": "accessControl" }
    },
    "yieldStakingOperatorAC": {
      "description": "Logically this combines several roles: YIELD_PROVIDER_STAKING_ROLE, YIELD_PROVIDER_UNSTAKER_ROLE, YIELD_REPORTER_ROLE, STAKING_PAUSE_CONTROLLER_ROLE, OSSIFICATION_PROCESSOR_ROLE. Currently they are shared by the same two addresses, if this changes the permissions must be modified.",
      "handler": {
        "type": "accessControl",
        "pickRoleMembers": "YIELD_PROVIDER_STAKING_ROLE"
      },
      "permissions": [
        {
          "type": "interact",
          "description": "operate native yield staking: stake and unstake, collect yield, pause and unpause, ossify yield managers."
        }
      ]
    },
    "yieldStakingManagerAC": {
      "description": "Logically this combines several roles: SET_YIELD_PROVIDER_ROLE, SET_L2_YIELD_RECIPIENT_ROLE, WITHDRAWAL_RESERVE_SETTER_ROLE. Currently they are shared by the same address, if this changes the permissions must be modified.",
      "handler": {
        "type": "accessControl",
        "pickRoleMembers": "SET_YIELD_PROVIDER_ROLE"
      },
      "permissions": [
        {
          "type": "interact",
          "description": "manage native yield staking: modify reserve parameters, set yield pools, set yield receiver addresses."
        }
      ]
    },
    "isWithdrawalReserveBelowMinimum": {
      // Flips on its own as the reserve moves: an operational condition, not a
      // governance decision, so it alerts (MEDIUM) without resetting the
      // ossification clock. Same treatment as pause flags.
      "severity": "MEDIUM",
      "description": "True when the LineaRollup ETH balance (the withdrawal reserve backing L2 exits) is below the effective minimum reserve. While true, no more ETH can be moved to the YieldManager or staked, and anyone can permissionlessly trigger unstaking from yield providers (with beacon chain proofs) and replenish the reserve up to the target. Refilling a deficit depends on beacon chain withdrawal latency."
    },
    "yieldProviderByIndex": { "severity": "HIGH" },
    "yieldProviderCount": {},
    "minimumWithdrawalReserveAmount": {
      "severity": "HIGH",
      "description": "Absolute minimum ETH balance the LineaRollup must hold as withdrawal reserve. The effective minimum is the larger of this and the percentage-based minimum."
    },
    "minimumWithdrawalReservePercentageBps": {
      "severity": "HIGH",
      "description": "Minimum withdrawal reserve in basis points of the total ETH in the native yield system (rollup balance + YieldManager balance + ETH deployed in yield providers). The effective minimum is the larger of this and minimumWithdrawalReserveAmount."
    },
    "targetWithdrawalReserveAmount": {
      "severity": "HIGH",
      "description": "Absolute target ETH balance for the LineaRollup withdrawal reserve. Unstaking and replenishment (permissionless while in deficit) refill the reserve up to the effective target, the larger of this and the percentage-based target."
    },
    "targetWithdrawalReservePercentageBps": {
      "severity": "HIGH",
      "description": "Target withdrawal reserve in basis points of the total ETH in the native yield system (rollup balance + YieldManager balance + ETH deployed in yield providers). The effective target is the larger of this and targetWithdrawalReserveAmount; staking is only allowed while the reserve is at or above it."
    }
  }
}
