{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Fills user-signed intents by creating DLN orders on their behalf: it pulls input tokens from users through the DeBridgeAllowanceHolder and forwards them into DlnSource in the same transaction, charging a variable fee that is not part of the user-signed intent.",
  "fields": {
    "getDefaultFeeBps": {
      "description": "Default variable fee in basis points charged on intent fills (admin-settable up to 100% with immediate effect; the fee is not covered by the user-signed price constraints on all paths)."
    },
    "allowanceHolder": {
      "description": "Immutable allowance sink holding all user token approvals for the intent system."
    },
    "feeTreasury": {
      "description": "Immutable address receiving intent fill fees."
    },
    "dlnSource": {
      "description": "The DLN escrow contract that orders are created in."
    },
    "getGlobalNullificationTimestamp": {
      "description": "Intents signed before this timestamp are invalid. Setting it to the current time (GOVMONITORING_ROLE) invalidates all outstanding intents."
    },
    "accessControl": { "handler": { "type": "accessControl" } },
    "defaultAdminAC": {
      "handler": {
        "type": "accessControl",
        "pickRoleMembers": "DEFAULT_ADMIN_ROLE"
      },
      "permissions": [
        {
          "type": "interact",
          "description": "set intent fill fees up to 100% with immediate effect (fees are not part of the user-signed intent), manage the trusted solver set, sweep funds held by the contract, and grant/revoke all roles."
        }
      ]
    }
  }
}
