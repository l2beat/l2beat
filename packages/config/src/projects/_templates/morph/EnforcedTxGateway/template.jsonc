{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Contracts to force L1 -> L2 messages with the L1 sender. Currently paused: {{ paused }}.",
  // Censorship escape hatch: forced L1 -> L2 transactions enter the message queue here.
  "critical": true,
  "fields": {
    "owner": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "pause and unpause, update the fee vault."
        }
      ]
    },
    "messageQueue": {
      "severity": "HIGH"
    },
    "paused": {
      "description": "Whether forced transactions are paused. Affects the sequencer failure risk.",
      "severity": "MEDIUM"
    }
  }
}
