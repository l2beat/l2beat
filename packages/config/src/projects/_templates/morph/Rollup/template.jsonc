{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "The main contract of the Morph rollup. Allows to post transaction data and state roots and implements the proof system. Sequencing and proposing are permissioned to the active submitters registered and staked in the Submitter contract. If the EnforcedTxGateway is not paused, any submitter must include at least one L1 -> L2 message in their proposal if the oldest message is > {{getMinDelayFormatted}} old. If the submitters are censoring or down for more than {{getMinDelayFormatted}}, users can permissionlessly propose and prove via `commitBatchWithProof()`.",
  // Core protocol contract: batch commitment, state root finalization and the
  // challenge/proof system all live here - a code or config change can alter
  // how withdrawals are validated.
  "critical": true,
  "ignoreMethods": [
    "batchChallengedSuccess",
    "batchDataStore",
    "batchExist",
    "batchInChallenge",
    "batchInsideChallengeWindow",
    "challenges",
    "committedBatches",
    "finalizedStateRoots",
    "isBatchFinalized",
    "committedStateRoots",
    "batchBlobVersionedHashes"
  ],
  "ignoreInWatchMode": [
    "batchChallenged",
    "lastCommittedBatchIndex",
    "lastFinalizedBatchIndex"
  ],
  "fields": {
    "rollupDelayPeriod": {
      "severity": "HIGH"
    },
    "$admin": {
      "severity": "HIGH"
    },
    // The verifier route deciding which zk proofs are accepted in challenges.
    "verifier": {
      "severity": "HIGH"
    },
    // Delay after which a committed batch (and its withdrawals) becomes final if unchallenged.
    "finalizationPeriodSeconds": {
      "severity": "HIGH"
    },
    // Time a challenged proposer has to submit a validity proof before the batch is deleted.
    "proofWindow": {
      "severity": "HIGH"
    },
    // Defines the permissioned submitter set allowed to commit batches and
    // propose, and is the contract the Rollup slashes on a lost challenge.
    "submitterContract": {
      "severity": "HIGH"
    },
    "legacyCutoverBatchIndex": {
      "description": "Batch index at which the Rollup switched batch-submission authorization to the Submitter contract; batches above it are attributed to a single submitter account."
    },
    // Queue enforcing L1 -> L2 message inclusion (forced transactions).
    "messageQueue": {
      "severity": "HIGH"
    },
    "paused": {
      "severity": "MEDIUM"
    },
    "challengers": {
      "handler": {
        "type": "event",
        "select": "account",
        "add": { "event": "UpdateChallenger", "where": ["=", "#status", true] },
        "remove": {
          "event": "UpdateChallenger",
          "where": ["!=", "#status", true]
        }
      },
      "permissions": [
        {
          "type": "interact",
          "description": "Allowed to challenge or delete state roots proposed by a Proposer."
        }
      ]
    },
    // Controller of pausing, batch reverts, the proof window, the finalization
    // period and the verifier pointer.
    "owner": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "can pause and unpause, revert unfinalized batches, update proof window and finalization period, manage challengers, modify the verifier address."
        }
      ]
    },
    "getMinDelayFormatted": {
      "description": "commitBatchWithProof() can be called if any:\n1. last committed batch + rollupDelayPeriod < now\n2. oldest enqueued msg + rollupDelayPeriod < now",
      // Threshold after which sequencing/proposing become permissionless (censorship escape hatch).
      "severity": "HIGH",
      "handler": { "type": "call", "method": "rollupDelayPeriod", "args": [] },
      "edit": ["format", "FormatSeconds"]
    }
  }
}
