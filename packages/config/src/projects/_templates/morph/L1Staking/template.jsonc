{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Staking registry of the L2 sequencer set. It relays staker additions and removals to the L2 Staking contract through the messenger, which determines the L2 block-producing sequencer set. The Rollup does not reference it: L1 batch submission and slashing are authorized through the Submitter contract, so the stake, challenge-deposit and reward parameters here are not enforced by the Rollup.",
  // Defines the L2 sequencer set (synced to L2 via the messenger); L1 batch
  // submission and slashing are authorized by the Submitter contract instead.
  "critical": true,
  "ignoreMethods": ["getStakers", "stakerSet"],
  "fields": {
    "rewardPercentage": {
      "severity": "HIGH"
    },
    "messenger": {
      "severity": "HIGH"
    },
    "OTHER_STAKING": {
      "severity": "HIGH"
    },
    "MESSENGER": {
      "severity": "HIGH"
    },
    "$admin": {
      "severity": "HIGH"
    },
    // Identity churn inside the unchanged staker role is not HIGH.
    "getActiveStakers": {
      "permissions": [
        {
          "type": "interact",
          "description": "Stakers relayed to the L2 Staking contract as the L2 sequencer set. This does not authorize committing batches or proposing state roots on L1, which the Submitter contract controls."
        }
      ]
    },
    "rollupContract": {
      "severity": "HIGH"
    },
    // Bond of the L2 sequencer stakers; not slashed by the Rollup, which slashes Submitter stakes.
    "stakingValue": {
      "severity": "HIGH"
    },
    // Not read by the Rollup, which takes the challenge deposit from the Submitter contract.
    "challengeDeposit": {
      "severity": "HIGH"
    },
    // Blocks a staker must wait before withdrawing its bond after exiting.
    "withdrawalLockBlocks": {
      "severity": "HIGH"
    },
    "owner": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "whitelist and remove stakers (the L2 sequencer set relayed to L2) and manage the staking, slashing and reward config of this contract."
        }
      ]
    }
  }
}
