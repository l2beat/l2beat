{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Contains the array of queued L1 -> L2 messages, either appended using the L1Messenger or the EnforcedTxGateway.",
  // Forced-inclusion path: sequencers must drain this queue; tampering with it can censor users.
  "critical": true,
  "ignoreMethods": [
    "getCrossDomainMessage",
    "isMessageDropped",
    "isMessageSkipped",
    "messageQueue",
    "getMessageEnqueueTimestamp",
    "messageEnqueueTime"
  ],
  "ignoreInWatchMode": [
    "pendingQueueIndex",
    "nextCrossDomainMessageIndex",
    "getFirstUnfinalizedMessageEnqueueTime"
  ],
  "fields": {
    "$admin": { "severity": "MEDIUM" },
    "owner": {
      "severity": "MEDIUM",
      "permissions": [
        {
          "type": "interact",
          "description": "manage L2 base fee, max gas limit and set the whitelist checker contract."
        }
      ]
    },
    // Cap on the gas of enqueued (incl. forced) L1 -> L2 transactions; lowering it can block the forced-inclusion path.
    "maxGasLimit": {
      "severity": "MEDIUM"
    },
    // Every enqueue calls isSenderAllowed() on it, but only to waive the fee.
    "whitelistChecker": {
      "severity": "MEDIUM"
    }
  }
}
