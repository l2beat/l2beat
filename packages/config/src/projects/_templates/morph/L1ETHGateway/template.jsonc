{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Contract used to bridge ETH from L1 to L2.",
  // Canonical deposit entrypoint for ETH (funds are escrowed in the L1CrossDomainMessenger).
  "critical": true,
  "fields": {
    "router": {
      "severity": "HIGH"
    },
    "messenger": {
      "severity": "HIGH"
    },
    "counterpart": {
      "severity": "HIGH"
    },
    "$admin": {
      "severity": "HIGH"
    },
    "owner": {
      "severity": "HIGH"
    }
  }
}
