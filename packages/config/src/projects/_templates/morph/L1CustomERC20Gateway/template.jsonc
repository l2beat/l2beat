{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Contract used to bridge ERC20 tokens with custom L2 representations from L1 to L2. It allows to change the token mappings.",
  // Canonical escrow for custom-mapped bridged ERC20s (counted in TVS without additional trust assumptions).
  "critical": true,
  "ignoreRelatives": ["tokenMapping"],
  "fields": {
    "tokenMapping": {
      "severity": "HIGH",
      "description": "L1-to-L2 token mapping used to validate custom-token deposits and withdrawals.",
      "handler": {
        "type": "event",
        "select": "newL2Token",
        "groupBy": "l1Token",
        "set": { "event": "UpdateTokenMapping" }
      }
    }
  }
}
