{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Contract used to bridge USDC tokens from L1 to L2.",
  "critical": true,
  "category": "bridge-external",
  "ignoreMethods": ["l1USDC"],
  "ignoreInWatchMode": ["totalBridgedUSDC"],
  "fields": {
    "withdrawPaused": {
      "severity": "MEDIUM"
    },
    "depositPaused": {
      "severity": "MEDIUM"
    },
    "circleCaller": {
      "severity": "HIGH"
    },
    "router": {
      "severity": "HIGH"
    },
    "messenger": {
      "severity": "HIGH"
    },
    "owner": {
      "severity": "HIGH"
    },
    "$admin": {
      "severity": "HIGH"
    },
    "counterpart": {
      "severity": "HIGH",
      "edit": ["format", "ScrollAddress"]
    },
    "l2USDC": {
      "severity": "HIGH",
      "edit": ["format", "ScrollAddress"]
    }
  }
}
