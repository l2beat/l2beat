{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Contract used to bridge ERC20 tokens from L1 to L2. It allows to change the token mappings.",
  // critical is set per address in config.jsonc: external escrows (e.g. pufETH) share this shape
  "category": "bridge-canonical",
  "fields": {
    "tokenMapping": {
      "severity": "HIGH",
      "description": "L1-to-L2 token mapping used to validate custom-token deposits and withdrawals.",
      "handler": {
        "type": "event",
        "select": "newL2Token",
        "groupBy": "l1Token",
        "set": { "event": "UpdateTokenMapping" }
      }
    },
    "counterpart": {
      "edit": ["format", "ScrollAddress"]
    }
  }
}
