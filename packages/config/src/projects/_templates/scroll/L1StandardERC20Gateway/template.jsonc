{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Contract used to bridge ERC20 tokens from L1 to L2. It uses a fixed token list.",
  "critical": true,
  "category": "bridge-canonical",
  "fields": {
    "router": {
      "severity": "HIGH"
    },
    "messenger": {
      "severity": "HIGH"
    },
    "owner": {
      "severity": "HIGH"
    },
    "$admin": {
      "severity": "HIGH"
    },
    "l2TokenFactory": {
      "severity": "HIGH",
      "edit": ["format", "ScrollAddress"]
    },
    "l2TokenImplementation": {
      "severity": "HIGH",
      "edit": ["format", "ScrollAddress"]
    },
    "counterpart": {
      "severity": "HIGH",
      "edit": ["format", "ScrollAddress"]
    }
  }
}
