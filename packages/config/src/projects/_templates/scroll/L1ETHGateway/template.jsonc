{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Contract used to bridge ETH from L1 to L2.",
  "critical": true,
  "category": "bridge-canonical",
  "fields": {
    "router": {
      "severity": "HIGH"
    },
    "messenger": {
      "severity": "HIGH"
    },
    "owner": {
      "severity": "HIGH"
    },
    "$admin": {
      "severity": "HIGH"
    },
    "counterpart": {
      "severity": "HIGH",
      "edit": ["format", "ScrollAddress"]
    }
  }
}
