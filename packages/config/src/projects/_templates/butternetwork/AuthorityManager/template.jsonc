{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "Butter AuthorityManager",
  "category": "gov",
  "description": "OpenZeppelin AccessManager-derived authority for the restricted functions of the Butter contracts that name it. Its role configuration controls who can change their validation, token and fee settings, pause them and upgrade them.",
  "fields": {
    "targetFunctionRoles": {
      "description": "Role id that may call each restricted function, per target contract and function selector.",
      "severity": "HIGH",
      "handler": {
        "type": "event",
        "select": ["selector", "roleId"],
        "add": { "event": "TargetFunctionRoleUpdated" },
        "dedupBy": "selector",
        "groupBy": "target"
      }
    },
    "adminRole": {
      "description": "Members of ADMIN_ROLE can reconfigure the AuthorityManager itself, including role membership and the function-to-role mappings that govern attached Butter contracts.",
      "severity": "HIGH",
      "handler": { "type": "call", "method": "getRoleMembers", "args": [0] },
      "type": "PERMISSION",
      "permissions": [
        {
          "type": "interact",
          "description": "grant or revoke roles, change role and target permissions, and execute the restricted management functions of the attached Butter contracts."
        }
      ]
    }
  }
}
