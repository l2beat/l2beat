{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "Voting",
  "critical": true,
  "description": "Token-weighted Railgun governance contract. Proposals must be sponsored, voted through quorum, and then executed through the Delegator.",
  "category": "gov",
  "ignoreMethods": ["getActions", "proposals", "proposalsLength"],
  "fields": {
    "proposalCount": {
      "description": "Number of governance proposals published. Proposals are updates, but do not change the system until executed.",
      "handler": {
        "type": "eventCount",
        "topics": [
          "0xe56c149b9a4f632c327b2bc8b691ebfd0d76354ca7b678faea1effbd9d9f223d"
        ]
      }
    },
    "recentProposals": {
      "description": "Proposals from id 33 on. Every earlier proposal is executed or past its sponsor window. A proposal can be called to a vote once its sponsorship reaches PROPOSAL_SPONSOR_THRESHOLD, which sets voteCallTime. A published proposal changes nothing until it is executed.",
      "handler": {
        "type": "array",
        "method": "function proposals(uint256) view returns (bool executed, address proposer, string proposalDocument, uint256 publishTime, uint256 voteCallTime, uint256 sponsorship, uint256 yayVotes, uint256 nayVotes, uint256 sponsorInterval, uint256 votingInterval)",
        "startIndex": 33,
        "ignoreRelative": true
      }
    },
    "DELEGATOR_CONTRACT": {
      "description": "Delegator contract that executes successful proposal actions."
    },
    "STAKING_CONTRACT": {
      "description": "Staking contract whose snapshots determine sponsorship and voting power."
    },
    "QUORUM": {
      "description": "Minimum affirmative voting power required for a proposal to reach quorum.",
      "type": "RISK_PARAMETER"
    },
    "PROPOSAL_SPONSOR_THRESHOLD": {
      "description": "Minimum sponsorship required before a proposal can be moved into the voting phase.",
      "type": "RISK_PARAMETER"
    },
    "SPONSOR_WINDOW": {
      "description": "Maximum time after publication during which a proposal can collect sponsorship.",
      "type": "RISK_PARAMETER"
    },
    "SPONSOR_LOCKOUT_TIME": {
      "description": "Cooldown that limits how often the same account can newly sponsor different proposals.",
      "type": "RISK_PARAMETER"
    },
    "VOTING_START_OFFSET": {
      "description": "Delay between calling a proposal to vote and the opening of the voting window.",
      "type": "RISK_PARAMETER"
    },
    "VOTING_YAY_END_OFFSET": {
      "description": "Deadline for casting affirmative votes after a vote has been called.",
      "type": "RISK_PARAMETER"
    },
    "VOTING_NAY_END_OFFSET": {
      "description": "Deadline for casting negative votes after a vote has been called.",
      "type": "RISK_PARAMETER"
    },
    "EXECUTION_START_OFFSET": {
      "description": "Delay between a successful vote and when execution can begin.",
      "type": "RISK_PARAMETER"
    },
    "EXECUTION_END_OFFSET": {
      "description": "End of the execution window for a successful proposal.",
      "type": "RISK_PARAMETER"
    }
  }
}
