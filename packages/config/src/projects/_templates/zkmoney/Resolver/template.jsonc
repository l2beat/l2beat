{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "Resolver",
  "category": "core",
  "description": "ENS resolver for zk.money names. It returns a deposit address derived from a resolver operator's answer, which must come with a zk proof that it matches the user's registered keys and L2 address in the AccountMetadataRegistry.",
  "fields": {
    "VERIFIER": {
      "template": "zkmoney/ResolverVerifier"
    },
    "ensNode": {
      "description": "ENS node monitored for this deployment."
    },
    "ensNodeOwner": {
      "description": "Owner of zk.money in the ENS registry. The DNS domain holder can reclaim this DNS name in ENS with a DNSSEC proof.",
      "severity": "MEDIUM",
      "handler": {
        "type": "call",
        "address": "eth:0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e",
        "method": "function owner(bytes32 node) view returns (address)",
        "args": ["{{ ensNode }}"]
      },
      "permissions": [
        {
          "type": "interact",
          "description": "replace this Resolver as the ENS resolver of zk.money names, which decides the addresses that payments to these names resolve to."
        }
      ]
    },
    "ensResolver": {
      "description": "Resolver set for zk.money in the ENS registry.",
      "severity": "HIGH",
      "handler": {
        "type": "call",
        "address": "eth:0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e",
        "method": "function resolver(bytes32 node) view returns (address)",
        "args": ["{{ ensNode }}"],
        "ignoreRelative": true
      }
    }
  }
}
