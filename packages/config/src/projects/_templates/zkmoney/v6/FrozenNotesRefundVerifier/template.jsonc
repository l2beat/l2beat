{
  "$schema": "../../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "FrozenNotesRefundVerifier",
  "critical": true,
  "category": "core",
  "description": "UltraHonk verifier for refunds of notes that were unspent when the zk.money portal froze. Its verification key is immutable.",
  "fields": {
    // No severity: the verifier is immutable, so the key cannot change on a live system.
    "verificationKeyHash": {
      "description": "Circuit verification key hash embedded in the verified Solidity source.",
      "type": "CODE_CHANGE",
      // Internal constant without a getter. The template shape binds this value
      // to the verified circuit.
      "handler": {
        "type": "hardcoded",
        "value": "0x2249c28908d7fb322c39421e6c030c96dddbd364163e5b41f378a21953a58135"
      }
    }
  }
}
