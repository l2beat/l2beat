{
  "$schema": "../../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "SIPAFactory",
  "critical": true,
  "category": "core",
  "description": "Deploys zk.money deposit addresses (SIPAs) as deterministic clones. A clone counts as blessed when its implementation was blessed and its ForwardingTable approved. Each clone's code and table are fixed in its address. New deposit addresses, from the wallet or the Resolver, clone the current implementation for their intent.",
  "fields": {
    "owner": {
      "severity": "MEDIUM",
      "permissions": [
        {
          "type": "interact",
          "description": "bless deposit address implementations and approve ForwardingTables. A newly blessed implementation for an intent decides the code of every new deposit address for that intent. Earlier blessings are never revoked."
        }
      ]
    },
    // HIGH: the current implementation is the code that receives every new
    // deposit, and the owner can replace it at any time. Read from events
    // because the legacy factory types the intent as an enum, which rejects
    // intents it does not know.
    "implementations": {
      "description": "Current implementation per intent (1 = Deposit, 2 = Registration, 3 = UserOp, 4 = AddPasskey), cloned by new addresses for that intent.",
      "severity": "HIGH",
      "handler": {
        "type": "event",
        "select": "implementation",
        "groupBy": "intent",
        "set": { "event": "ImplementationBlessed" }
      }
    },
    "blessedImplementations": {
      "description": "All blessed implementations with their intent. Clones of any of them count as blessed.",
      "handler": {
        "type": "event",
        "select": ["implementation", "intent"],
        "add": { "event": "ImplementationBlessed" }
      }
    },
    "approvedTables": {
      "description": "ForwardingTables that blessed deposit addresses may use.",
      "severity": "MEDIUM",
      "handler": {
        "type": "event",
        "select": "table",
        "add": { "event": "TableBlessed" }
      }
    }
  }
}
