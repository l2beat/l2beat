{
  "$schema": "../../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "ResolverVerifier",
  "category": "core",
  "discoverLibraries": true,
  "description": "UltraHonk verifier for the zk.money resolver circuit with a hardcoded verification key, generated by a newer Barretenberg than the v5 resolver verifier. The Resolver uses it to check that a resolver operator's answer matches the user's registered keys and L2 address.",
  "fields": {
    // No severity on verificationKeyHash and $libraries: the verifier is
    // immutable, so neither can change on a live system.
    "verificationKeyHash": {
      "description": "Circuit verification key hash embedded in the verified Solidity source.",
      "type": "CODE_CHANGE",
      // Internal constant without a getter. The template shape binds this
      // value to the verified source.
      "handler": {
        "type": "hardcoded",
        "value": "0x012486c74ac5045c0bd91bde9cbbf5f815d2d4761eb54601f0b0c5840dac28ff"
      }
    },
    "$libraries": {
      "template": "zkmoney/ResolverVerifierLibrary",
      "description": "Runtime libraries immutably linked into this verifier.",
      "type": "CODE_CHANGE"
    }
  }
}
