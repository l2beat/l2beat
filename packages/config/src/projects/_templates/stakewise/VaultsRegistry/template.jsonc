{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "VaultsRegistry",
  "category": "gov",
  "description": "List of vaults, approved vault implementations and factories. Registered factories add the vaults they create; a vault admin can only upgrade to an approved implementation of the next version, and only vaults on an approved implementation can mint osToken.",
  "fields": {
    "owner": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "approve or remove the vault implementations that vault admins may upgrade to, add or remove vault factories, register vaults directly, and accept a meta vault as a sub-vault of another meta vault, with no delay."
        }
      ]
    },
    "vaultImpls": {
      "severity": "HIGH",
      "handler": {
        "type": "event",
        "select": "impl",
        "add": {
          "event": "VaultImplAdded"
        },
        "remove": {
          "event": "VaultImplRemoved"
        }
      },
      "description": "Approved vault implementations."
    },
    "factories": {
      "handler": {
        "type": "event",
        "select": "factory",
        "add": {
          "event": "FactoryAdded"
        },
        "remove": {
          "event": "FactoryRemoved"
        }
      },
      "description": "Factories allowed to register new vaults."
    }
  },
  "ignoreRelatives": ["vaultImpls", "factories"]
}
