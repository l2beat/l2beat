{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "category": "core",
  "description": "First-generation vault with a blocklist and no osToken minting: deposits are open to anyone not barred, the keys manager publishes the root of staking keys that anyone can register with oracle approval, withdrawals return to the vault, and every harvest applies the keeper's root, minting {{feePercent}} basis points of gains (fixed at creation) to the fee recipient. Upgrades need the admin and a registry-approved implementation of the next version.",
  "ignoreMethods": [
    "convertToAssets",
    "convertToShares",
    "getExitQueueIndex",
    "calculateExitedAssets",
    "DOMAIN_SEPARATOR",
    "eip712Domain",
    "UPGRADE_INTERFACE_VERSION",
    "proxiableUUID",
    "implementation",
    "nonces",
    "osTokenPositions",
    "getShares",
    "getExitQueueData",
    "withdrawableAssets",
    "validatorsManagerNonce",
    "isStateUpdateRequired",
    "vaultId"
  ],
  "ignoreInWatchMode": [
    "totalAssets",
    "totalShares",
    "totalSupply",
    "totalExitingAssets",
    "queuedShares"
  ],
  "ignoreRelatives": ["feeRecipient"],
  "fields": {
    "admin": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "appoint the keys manager, fee recipient and blocklist manager, and upgrade the vault to the next implementation approved by the vault registry, with no delay."
        }
      ]
    },
    "feePercent": {
      "severity": "HIGH",
      "description": "Share of rewards minted to the fee recipient, in basis points; fixed at creation."
    },
    "feeRecipient": {
      "description": "Receiver of the vault's fee shares."
    },
    "capacity": {
      "description": "Maximum total assets, in wei."
    },
    "blocklistManager": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "bar addresses from depositing and force a barred holder's shares into the exit queue."
        }
      ]
    },
    "keysManager": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "publish the root of staking keys that the vault's ETH may fund, subject to oracle approval."
        }
      ]
    }
  }
}
