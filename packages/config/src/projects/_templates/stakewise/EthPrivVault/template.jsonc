{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "category": "core",
  "description": "Staking vault where only whitelisted accounts can deposit. The key manager registers staking keys that withdraw to the vault, each registration approved by the oracle quorum in the keeper. Every harvest applies the vault's reward or loss from the keeper's root, mints {{feePercent}} basis points of gains to the fee recipient and pays the exit queue from spare assets, claimable after a delay fixed at deployment. Shares collateralise osToken up to the vault's loan-to-value. Upgrades need the admin and a registry-approved implementation of the next version.",
  "ignoreMethods": [
    "convertToAssets",
    "convertToShares",
    "getExitQueueIndex",
    "calculateExitedAssets",
    "DOMAIN_SEPARATOR",
    "eip712Domain",
    "UPGRADE_INTERFACE_VERSION",
    "proxiableUUID",
    "implementation",
    "nonces",
    "osTokenPositions",
    "getShares",
    "getExitQueueData",
    "withdrawableAssets",
    "validatorsManagerNonce",
    "isStateUpdateRequired",
    "vaultId"
  ],
  "ignoreInWatchMode": [
    "totalAssets",
    "totalShares",
    "totalSupply",
    "totalExitingAssets",
    "queuedShares"
  ],
  "ignoreRelatives": ["feeRecipient"],
  "fields": {
    "admin": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "appoint the key manager, deposit data manager, fee recipient and access managers, raise the fee by at most a fifth every three days, and upgrade the vault to the next registry-approved implementation, with no delay."
        }
      ]
    },
    "validatorsManager": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "choose which staking keys the vault's ETH funds, subject to oracle approval, and exit or consolidate the vault's stakes."
        }
      ]
    },
    "feePercent": {
      "severity": "HIGH",
      "description": "Share of rewards minted to the fee recipient, in basis points."
    },
    "feeRecipient": {
      "description": "Receiver of the vault's fee shares."
    },
    "capacity": {
      "description": "Maximum total assets, in wei."
    },
    "whitelister": {
      "severity": "MEDIUM",
      "permissions": [
        {
          "type": "interact",
          "description": "decide which addresses may deposit into and mint osToken from this vault."
        }
      ]
    }
  }
}
