{
  "$schema": "../../../../../discovery/schemas/contract.v2.schema.json",
  "description": "Owner and admin of the ZCHF CCIP token pool and of the ZCHF entry in Chainlink's TokenAdminRegistry. Every action requires 2% of FPS votes: pool configuration changes (adding/removing chains and remote pools) execute after a 7-day timelock, handover of the admin role after 21 days; setting rate limits and vetoing pending proposals is immediate.",
  "fields": {
    "GOVERNANCE": {
      "permissions": [
        {
          "type": "interact",
          "delay": "604800",
          "description": "propose changes to the ZCHF CCIP token pool configuration (add/remove chains and remote pools; 7-day delay) or a transfer of the CCIP admin role and pool ownership (21-day delay), with 2% of FPS votes."
        },
        {
          "type": "interact",
          "description": "immediately set per-chain CCIP rate limits for bridged ZCHF and veto pending CCIPAdmin proposals, with 2% of FPS votes."
        }
      ]
    }
  }
}
