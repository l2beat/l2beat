{
  "$schema": "../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "MintingHubV1",
  "description": "Deprecated first version of the minting hub with the same oracle-free, auction-policed design (upfront fees instead of continuous interest). The official frontend no longer supports it, but it remains a registered minter forever and stays permissionlessly usable.",
  "ignoreMethods": ["challenges"],
  "fields": {
    "openedPositions": {
      "description": "All positions ever opened through this deprecated hub, from PositionOpened events. A new entry is unexpected and warrants review: new originals still pass a 3+ day veto window, but the hub is no longer curated by the Frankencoin frontend.",
      "handler": {
        "type": "event",
        "select": "position",
        "add": {
          "event": "PositionOpened"
        },
        "ignoreRelative": true
      }
    }
  }
}
