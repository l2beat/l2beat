{
  "$schema": "../../../../../../discovery/schemas/contract.v2.schema.json",
  "displayName": "L2OutputOracle",
  "description": "Contains a list of proposed state roots which Proposers assert to be a result of block execution. Each proposal records its own finalization period.",
  "ignoreMethods": [
    "getL2OutputAfter",
    "getL2OutputIndexAfter",
    "getL2Output",
    "computeL2Timestamp",
    "stateRootPeriodSeconds",
    "finalizationStateRootPeriodSeconds"
  ],
  "ignoreInWatchMode": [
    "nextBlockNumber",
    "nextOutputIndex",
    "latestBlockNumber",
    "latestOutputIndex"
  ],
  "fields": {
    "FINALIZATION_PERIOD_SECONDS": {
      "description": "Challenge period (Number of seconds until a state root is finalized)."
    },
    "proposer": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "Allowed to post new state roots of the current layer to the host chain."
        }
      ]
    },
    "PROPOSER": {
      "permissions": [
        {
          "type": "interact",
          "description": "Allowed to post new state roots of the current layer to the host chain."
        }
      ]
    },
    "challenger": {
      "severity": "HIGH",
      "permissions": [
        {
          "type": "interact",
          "description": "Allowed to challenge or delete state roots proposed by a Proposer."
        }
      ]
    },
    "CHALLENGER": {
      "permissions": [
        {
          "type": "interact",
          "description": "Allowed to challenge or delete state roots proposed by a Proposer."
        }
      ]
    },
    "deletedOutputs": {
      "severity": "HIGH",
      "handler": {
        "type": "event",
        "select": ["prevNextOutputIndex", "newNextOutputIndex"],
        "add": { "event": "OutputsDeleted" }
      }
    }
  },
  "category": "core"
}
