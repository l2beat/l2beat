{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "shared-aztec",
  "import": ["../globalConfig.jsonc"],
  // Governance, staking and token contracts that every Aztec rollup version
  // shares. The rollup versions live in their own projects (aztecnetwork,
  // aztecnetworkv6), so the pointers to the latest rollup are not followed.
  "initialAddresses": [
    "eth:0x35b22e09Ee0390539439E24f06Da43D83f90e298", // Registry
    "eth:0xBbB4aF368d02827945748b28CD4b2D42e4A37480" // vetoer of every version's Slasher, nothing here references it
  ],
  "overrides": {
    "eth:0x35b22e09Ee0390539439E24f06Da43D83f90e298": {
      "ignoreRelatives": ["getCanonicalRollup"]
    },
    "eth:0xa92ecFD0E70c9cd5E5cd76c50Af0F7Da93567a4f": {
      "ignoreRelatives": ["getLatestRollup"]
    },
    "eth:0x555bAAc4757A89f1CE0c84fA35afE9dD7aa8E1d3": {
      "ignoreRelatives": ["canonicalRollup"]
    },
    "eth:0x06Ef1DcF87E419C48B94a331B252819FADbD63ef": {
      "ignoreRelatives": ["getInstance"]
    },
    "eth:0xA27EC0006e59f245217Ff08CD52A7E8b169E62D2": {
      "fields": {
        "owner": {
          "permissions": [
            {
              "type": "interact",
              "description": "mint AZTEC only through the CoinIssuer's capped issuance function. The CoinIssuer exposes no path to transfer or renounce ownership of the AZTEC token."
            }
          ]
        }
      }
    },
    "eth:0xD938bE4A2cB41105Bc2FbE707dca124A2e5d0c80": {
      "displayName": "AztecTokenPositionRegistry_ProtocolTreasury",
      "description": "AZTEC token-position Registry referenced by the ProtocolTreasury for its activation cutoff and by other ecosystem vesting contracts."
    },
    "eth:0xBbB4aF368d02827945748b28CD4b2D42e4A37480": {
      "displayName": "SlashVeto Council",
      "category": "gov"
    }
  }
}
