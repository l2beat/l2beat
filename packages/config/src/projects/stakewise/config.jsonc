  // Boundary cuts. The DAO Safe's Reality module is kept with its ERC20 Reality oracle; the
  // SWISE bond token and the V2 proxy admin behind it are not part of the LST. The legacy V2
  // reward token keeps only its migration edge into the Genesis vault, not V2's distributor
  // and oracle set. Factories point at the approved vault implementations, which already
  // appear as the implementation of each vault proxy. Meta vaults' curator is stateless.
  "overrides": {
    "eth:0x867092A32bC16816F12Fb326EfF7A2865E1ec138": {
      "ignoreRelatives": ["token"]
    },
    "eth:0x20BC832ca081b91433ff6c17f85701B6e92486c5": {
      "ignoreRelatives": ["merkleDistributor"]
    },
    "eth:0x09e84205DF7c68907e619D07aFD90143c5763605": {
      "ignoreRelatives": ["authenticator"]
    },
    // Three vaults use unverified copies of OwnMevEscrow (same code family, `vault()` points back
    // at the vault); they are left out so the page carries no unverified contract. One vault
    // admin Safe runs a Safe Allowance module that is unrelated to the vault.
    "eth:0x47fd7ac6C6bc73F2D419a18D0692F37Df3f48034": {
      "ignoreRelatives": ["mevEscrow"]
    },
