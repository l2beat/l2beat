    "eth:0xa0273f884816dfF0BE9B5ED50aB3AA29D6AaA712": {
      "description": "Unverified contract that supplies committee-sortition entropy to the CiphernodeRegistry as a Chainlink VRF v2.5 subscription consumer, replacing the previous EIP-2935 blockhash-based entropy.",
      "category": "core",
      "fields": {
        "owner": {
          "description": "Account controlling the VRF configuration.",
          "type": "PERMISSION",
          "handler": {
            "type": "call",
            "method": "function owner() view returns (address)",
            "args": []
          },
          "permissions": [
            {
              "type": "interact",
              "description": "replace the VRF coordinator that the sortition entropy is requested from."
            }
          ]
        },
        "vrfCoordinator": {
          "description": "External Chainlink VRF v2.5 coordinator that delivers the verified randomness. The Chainlink system is outside the Interfold discovery perimeter.",
          "type": "CODE_CHANGE",
          "handler": {
            "type": "call",
            "method": "function s_vrfCoordinator() view returns (address)",
            "args": [],
            "ignoreRelative": true
          }
        },
        "subscriptionId": {
          "description": "Chainlink VRF subscription funding the randomness requests.",
          "handler": {
            "type": "call",
            "method": "function subscriptionId() view returns (uint256)",
            "args": []
          }
        },
        "keyHash": {
          "description": "Chainlink VRF key hash (gas lane) used for randomness requests.",
          "type": "RISK_PARAMETER",
          "handler": {
            "type": "call",
            "method": "function keyHash() view returns (bytes32)",
            "args": []
          }
        },
        "callbackGasLimit": {
          "handler": {
            "type": "call",
            "method": "function callbackGasLimit() view returns (uint32)",
            "args": []
          }
        },
        "requestConfirmations": {
          "description": "Block confirmations Chainlink waits for before delivering randomness.",
          "type": "RISK_PARAMETER",
          "handler": {
            "type": "call",
            "method": "function requestConfirmations() view returns (uint16)",
            "args": []
          }
        },
        "nativePayment": {
          "description": "Whether the VRF subscription is paid in native ETH instead of LINK.",
          "handler": {
            "type": "call",
            "method": "function nativePayment() view returns (bool)",
            "args": []
          }
        }
      }
    },
