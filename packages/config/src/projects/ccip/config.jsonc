  "overrides": {
    // These two contracts are not source-verified. Only fields read through their deployed runtime interface are included.
    "eth:0xa22606F055146f0eac2FBEd49253E779b781355D": {
      "fields": {
        "typeAndVersion": {
          "handler": {
            "type": "call",
            "method": "function typeAndVersion() view returns (string)",
            "args": []
          }
        },
        "owner": {
          "handler": {
            "type": "call",
            "method": "function owner() view returns (address)",
            "args": []
          }
        },
        "versionTag": {
          "handler": {
            "type": "call",
            "method": "function versionTag() view returns (bytes4)",
            "args": []
          }
        },
        "getAllowedFinalityConfig": {
          "handler": {
            "type": "call",
            "method": "function getAllowedFinalityConfig() view returns (bytes4)",
            "args": []
          },
          "edit": ["format", "CCIPAllowedFinality"]
        },
        "getStaticConfig": {
          "handler": {
            "type": "call",
            "method": "function getStaticConfig() view returns (address tokenMessenger, address messageTransmitterProxy, address usdcToken, uint32 localDomainIdentifier)",
            "args": []
          }
        },
        "getDynamicConfig": {
          "handler": {
            "type": "call",
            "method": "function getDynamicConfig() view returns ((address feeAggregator, address allowlistAdmin, uint16 fastFinalityBps) dynamicConfig)",
            "args": []
          }
        },
        "getStorageLocations": {
          "handler": {
            "type": "call",
            "method": "function getStorageLocations() view returns (string[])",
            "args": []
          }
        },
        "remoteChainSelectors": {
          "handler": {
            "type": "event",
            "select": "remoteChainSelector",
            "add": {
              "event": "event RemoteChainConfigSet(uint64 indexed remoteChainSelector, address router, bool allowlistEnabled)"
            }
          }
        },
        "remoteChainConfigs": {
          "handler": {
            "type": "array",
            "method": "function getRemoteChainConfig(uint64 remoteChainSelector) view returns ((address router, uint64 remoteChainSelector, bool allowlistEnabled, uint16 feeUSDCents, uint32 gasForVerification, uint16 payloadSizeBytes) remoteChainConfig, address[] allowedSendersList)",
            "indices": "{{ remoteChainSelectors }}"
          },
          "edit": [
            "pipe",
            [
              "map",
              [
                "pipe",
                ["shape", "remoteChainConfig", "allowedSendersList"],
                [
                  "set",
                  ["remoteChainConfig", "remoteChainSelector"],
                  ["format", "CCIPChainName"]
                ],
                ["set", "allowedSendersList", ["sort"]]
              ]
            ],
            ["sort", ["get", "remoteChainConfig", "remoteChainSelector"]]
          ]
        }
      }
    },
    "eth:0x65E0c4AB4Da5d22E824879DEB43123D23217DEdD": {
      "fields": {
        "typeAndVersion": {
          "handler": {
            "type": "call",
            "method": "function typeAndVersion() view returns (string)",
            "args": []
          }
        },
        "owner": {
          "handler": {
            "type": "call",
            "method": "function owner() view returns (address)",
            "args": []
          }
        },
        "i_cctpTransmitter": {
          "handler": {
            "type": "call",
            "method": "function i_cctpTransmitter() view returns (address)",
            "args": []
          }
        },
        "getAllAuthorizedCallers": {
          "handler": {
            "type": "call",
            "method": "function getAllAuthorizedCallers() view returns (address[])",
            "args": []
          },
          "edit": ["sort"]
        }
      }
    },
    "eth:0x006bC1F599a10B73C88cc3cD19a92829C4AC1E83": {
      "description": "Keystone CapabilitiesRegistry used by CCIP to manage node operators, nodes, capabilities, and DONs. When a DON includes the registered CCIP capability, updating it forwards the DON membership and configuration to CCIPHome, where the payload can set, revoke, or promote an OCR configuration.",
      // These unbounded, frequently rotating arrays duplicate CCIP membership and configuration data already surfaced through CCIPHome.
      "ignoreMethods": ["getNodes", "getDONs"]
    },
