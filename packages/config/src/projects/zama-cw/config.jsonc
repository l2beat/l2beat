          ]
        },
        "initialMigratedKmsSigners": {
          "description": "KMS signers in the Gateway context created by the v0.5 migration. Node membership is immutable, so this signer set remains authorized for requests pinned to this context after future rotations, until the owner destroys the context (only possible once it is no longer current).",
          "severity": "HIGH",
