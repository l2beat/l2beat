  // Boundary cuts: EigenLayerManager points into EigenLayer core (DelegationManager,
  // EigenPodManager, StrategyManager) and enumerates the per-stake StakerProxy
  // clones; the StakerProxy beacon stays in scope, the clones and EigenLayer are
  // not crawled; the rswETH DepositManager's empty legacy EigenPod is cut too. The fee sink's payment token (SWELL) is not part of the LSTs.
  "overrides": {
    "eth:0xc94cffd5249df4008a043ee61e13f19af16d0936": {
      "ignoreMethods": ["stakerProxyAddresses", "isValidStaker"],
      "ignoreRelatives": [
        "DelegationManager",
        "EigenPodManager",
        "strategyManagerAddress",
        "deprecatedDelayedWithdrawalRouter"
      ]
    },
    "eth:0x5e6342D8090665bE14eeB8154c8a87B7249a4889": {
      "ignoreRelatives": ["EigenPodManager", "eigenPodDeprecated"]
    },
    "eth:0xf17b581496bc2669ce0931FAcAA1ADe35029E85D": {
      "ignoreRelatives": ["paymentToken"]
    }
  }
}
