{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "shape",
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": ["eth:0x62Edd5f4930Ea92dCa3fB81689bDD9b9d076b57B"],
  "overrides": {
    "eth:0xcee78437aE9e15cee9c78E63757E0153c0FD7479": {
      // AddressManager of this chain: its owner can repoint the ResolvedDelegateProxy implementations
      "critical": true
    },
    // OPContractsManagerV2 (shared upgrade tooling). Ignored so discovery
    // doesn't follow it into bare implementations; authority is the ProxyAdminOwner.
    "eth:0x9Ce712Ff84E02659846dc6450BB9b7642fE8bE5D": {
      "ignoreDiscovery": true
    },
    "eth:0x2c03e8BF8b16Af89079852BE87f0e9eC674a5952": {
      "ignoreInWatchMode": ["permissionedGamesTotal", "gameCount"],
      "fields": {
        "proposerFromDGF": {
          "permissions": [
            {
              "type": "interact",
              "description": "Allowed to post new state roots of the current layer to the host chain."
            }
          ]
        },
        "challengerFromDGF": {
          "permissions": [
            {
              "type": "interact",
              "description": "Allowed to challenge or delete state roots proposed by a Proposer."
            }
          ]
        }
      }
    }
  }
}
