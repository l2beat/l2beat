{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "polymarket",
  "import": ["../globalConfig.jsonc"],
  "maxAddresses": 90,
  "initialAddresses": [
    // Minimal seed set: every other contract is reached by crawling these.
    // Trading: the two settlement venues (no contract points at them).
    "matic:0xE111180000d2663C0091e4f400237545B87B996B", // CTFExchange -> collateral, CTF, wallet factories
    "matic:0xe2222d279d744050d28e00520010520000310F59", // NegRiskCtfExchange
    // Combos: RFQ venue -> PositionManager -> the three outcome modules.
    "matic:0xe3333700cA9d93003F00f0F71f8515005F6c00Aa", // CombosExchange
    "matic:0xa1200000d0002264C9a1698e001292D00E1b00af", // AutoRedeemer (leaf)
    // Wallets: factory -> beacon -> wallet implementations.
    "matic:0x00000000000Fb5C9ADea0298D729A0CB3823Cc07", // DepositWalletFactory
    // Resolution: adapters are referenced by markets, not by other contracts.
    // The neg-risk adapter and its operator reference each other, so one of the
    // two has to be seeded; the adapter also reaches the oracle.
    "matic:0x65070BE91477460D8A7AeEb94ef92fe056C2f2A7", // UmaCtfAdapter (binary)
    "matic:0x69c47De9D4D3Dad79590d61b9e05918E03775f24", // UmaCtfAdapter (neg risk)
    "matic:0x6A9D222616C90FcA5754cd1333cFD9b7fb6a4F74" // UmaCtfAdapter (legacy)
  ],
  "names": {
    "matic:0xE111180000d2663C0091e4f400237545B87B996B": "CTFExchange",
    "matic:0xe2222d279d744050d28e00520010520000310F59": "NegRiskCtfExchange",
    "matic:0x4D97DCd97eC945f40cF65F87097ACe5EA0476045": "ConditionalTokens",
    "matic:0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB": "CollateralToken",
    "matic:0xC417fD8E9661c0d2120B64a04Bb3278C17E99DB1": "CollateralVault",
    "matic:0x93070a847efEf7F70739046A929D47a521F5B8ee": "CollateralOnramp",
    "matic:0x2957922Eb93258b93368531d39fAcCA3B4dC5854": "CollateralOfframp",
    "matic:0xebC2459Ec962869ca4c0bd1E06368272732BCb08": "PermissionedRamp",
    "matic:0xADa100874d00e3331D00F2007a9c336a65009718": "CtfCollateralAdapter",
    "matic:0xAdA100Db00Ca00073811820692005400218FcE1f": "CtfCollateralAdapter2",
    "matic:0xAdA200001000ef00D07553cEE7006808F895c6F1": "NegRiskCtfCollateralAdapter",
    "matic:0xadA2005600Dec949baf300f4C6120000bDB6eAab": "NegRiskCtfCollateralAdapter2",
    "matic:0x006F54F7f9A22e0000CC2AB60031000000ae9fEF": "PositionManager",
    "matic:0x1000008dD9001B968442c1000017eaE6E0dA00Ba": "BinaryModule",
    "matic:0x200000900045e3B6259600682756002200028933": "NegRiskModule",
    "matic:0x30000034706C7d8e12009DAB006Be20000c031A8": "CombinatorialModule",
    "matic:0xe3333700cA9d93003F00f0F71f8515005F6c00Aa": "CombosExchange",
    "matic:0xa1200000d0002264C9a1698e001292D00E1b00af": "AutoRedeemer",
    "matic:0x00000000000Fb5C9ADea0298D729A0CB3823Cc07": "DepositWalletFactory",
    "matic:0x7A18EDfe055488A3128f01F563e5B479D92ffc3a": "DepositWalletBeacon",
    "matic:0x6A9D222616C90FcA5754cd1333cFD9b7fb6a4F74": "UmaCtfAdapterLegacy",
    "matic:0x65070BE91477460D8A7AeEb94ef92fe056C2f2A7": "UmaCtfAdapterBinary",
    "matic:0x69c47De9D4D3Dad79590d61b9e05918E03775f24": "UmaCtfAdapterNegRisk",
    "matic:0x661992aebf6BecF7BA5abB66f6b0Bf62Aa7a2E93": "NegRiskOperator",
    "matic:0xd91E80cF2E7be2e162c6513ceD06f1dD0dA35296": "NegRiskAdapter",
    "matic:0x3A3BD7bb9528E159577F7C2e685CC81A765002E2": "WrappedCollateral",
    "matic:0x7f67327E88c258932D7d8f72950bE0d46975E11D": "NegRiskFeeVault",
    "matic:0x2C0367a9DB231dDeBd88a94b4f6461a6e47C58B1": "ManagedOptimisticOracleV2",
    "matic:0x47EbFAC3353314C788B96CDCbf41daadfE03629C": "Timelock",
    "matic:0x3dcE0a29139A851Da1dFCa56Af8e8a6440b4D952": "AdminSafe",
    "matic:0x115F48DC2A731aA16251c6d6e1BEfC42f92Accc9": "FeeReceiverSafe",
    "matic:0xaB45c5A4B0c941a2F231C04C3f49182e1A254052": "ProxyWalletFactory",
    "matic:0xaacFeEa03eb1561C4e67d661e40682Bd20E3541b": "SafeProxyFactory",
    // Unverified smart account holding admin on the zero-delay multi-outcome
    // operator, the creator role on two outcome modules and operator on the
    // auto-redeemer. Named so it is not rendered blank; see unverifiedContracts.
    "matic:0xAC9930b2AE455a671b62dE86876A7e8587825294": "OperationsAccount"
  },
  // Overrides are limited to discovery-engine exceptions and boundaries around
  // external systems; each project-specific exception is justified below.
  "overrides": {
    // Proxy detection runs before shape matching, so this cannot be templated:
    // the automatic detector misreads this factory as a Safe (slot0 holds the
    // singleton) and aborts looking for its modules.
    "matic:0xaacFeEa03eb1561C4e67d661e40682Bd20E3541b": {
      "proxyType": "immutable"
    },
    // Bridged collateral: the token is in scope, the Polygon bridge admin and
    // its owner set are not.
    "matic:0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174": {
      "ignoreRelatives": ["$admin", "proxyOwner"]
    },
    // Native collateral: keep the token, drop the issuer's own control tree.
    "matic:0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359": {
      "ignoreRelatives": [
        "masterMinter",
        "minters",
        "owner",
        "pauser",
        "blacklister",
        "rescuer",
        "$admin"
      ]
    },
    // Shared UMA oracle templates do not crawl Finder because its registry
    // spans unrelated applications. Expose it only for Polymarket; the Finder
    // override below limits traversal to dependencies its oracle flow reads.
    "matic:0x2C0367a9DB231dDeBd88a94b4f6461a6e47C58B1": {
      "fields": {
        "umaFinder": {
          "handler": { "type": "call", "method": "finder", "args": [] }
        }
      }
    },
    "matic:0xeE3Afe347D5C74317041E2618C49534dAf887c24": {
      "fields": {
        "umaFinder": {
          "handler": { "type": "call", "method": "finder", "args": [] }
        }
      }
    },
    // Finder also indexes unrelated UMA applications. Keep the full registry
    // visible, but crawl only the entries read by Polymarket's oracle contracts.
    "matic:0x09aea4b2242abC8bb4BB78D537A67a245A7bEC64": {
      "ignoreRelatives": ["namedAddresses"],
      "fields": {
        "oracle": {
          "handler": {
            "type": "call",
            "method": "getImplementationAddress",
            "args": [
              "0x4f7261636c650000000000000000000000000000000000000000000000000000"
            ]
          }
        },
        "store": {
          "handler": {
            "type": "call",
            "method": "getImplementationAddress",
            "args": [
              "0x53746f7265000000000000000000000000000000000000000000000000000000"
            ]
          }
        },
        "identifierWhitelist": {
          "handler": {
            "type": "call",
            "method": "getImplementationAddress",
            "args": [
              "0x4964656e74696669657257686974656c69737400000000000000000000000000"
            ]
          }
        },
        "collateralWhitelist": {
          "handler": {
            "type": "call",
            "method": "getImplementationAddress",
            "args": [
              "0x436f6c6c61746572616c57686974656c69737400000000000000000000000000"
            ]
          }
        }
      }
    },
    // Safe singleton and fallback handler: uninitialized when called directly.
    "matic:0xE51abdf814f8854941b9Fe8e3A4F65CAB4e7A4a8": {
      "ignoreMethods": ["getOwners"]
    },
    "matic:0xe16bA5bF81E5BB113e4752E4fdC20351d796fB24": {
      "ignoreMethods": ["getModules"]
    },
    "matic:0xE111180000d2663C0091e4f400237545B87B996B": {
      // Same code shape as NegRiskCtfExchange. The explorer archived this
      // deployment's constructor arguments, so admin can be extracted from them.
      "fields": {
        "constructorArgs": {
          "handler": { "type": "constructorArgs", "nameArgs": true }
        },
        "admin": {
          "copy": "constructorArgs",
          "edit": ["get", "params", "admin"]
        }
      }
    },
    "matic:0xe2222d279d744050d28e00520010520000310F59": {
      // Same code shape as CTFExchange. The explorer did not archive constructor
      // arguments for this CREATE2 deployment, so admin is hardcoded from an
      // on-chain isAdmin() check.
      "fields": {
        "admin": {
          "handler": {
            "type": "hardcoded",
            "value": "matic:0x3dcE0a29139A851Da1dFCa56Af8e8a6440b4D952"
          }
        }
      }
    },
    // Chain-level native token predeploy, not part of the protocol.
    "matic:0x0000000000000000000000000000000000001010": {
      "ignoreDiscovery": true
    }
  }
}
