    "base:0x8cC51c3008b3f03Fe483B28B8Db90e19cF076a6d": "Base Governance Multisig - L2 Alias"
  },
  "overrides": {
    // active RISC Zero verification path for the TEE prover registration
    // (shared deployment with taiko; estopped instances are not flagged)
    "eth:0x8EaB2D97Dfce405A1692a21b3ff3A172d593D319": {
      "critical": true
    },
    "eth:0x9F9994Eb4Cb5200198FEfb470f8b50301662e696": {
      "critical": true
    },
    "eth:0x1efDd13f831ceeEa14940806705A53D3211CD698": {
      "critical": true
    },
    "eth:0x844D5f01161E3559d36f23d0Aa9E9620949aF782": {
      "critical": true
    },
    "eth:0x2a098988600d87650Fb061FfAff08B97149Fa84D": {
      "critical": true
    },
    "eth:0xafB31f5b70623CDF4b20Ada3f7230916A5A79df9": {
      "critical": true
    },
    "eth:0x5005aBa3DFf7C940fcc1e48DccCAD611a80eEB85": {
      "critical": true
    },
    // SP1 verification path used by ZkVerifier
    "eth:0xdc32E228636273285Befa5F001dBB5142517C106": {
      "critical": true
    },
    "eth:0xc3c6dDDAc8829b233Dc6536Ec024775a57b0AF2A": {
      "critical": true
    },
    // ProxyAdmin (L1): can upgrade every core Base contract (portal, bridges, DGF, SystemConfig, SuperchainConfig, TEEProverRegistry).
    "eth:0x0475cBCAebd9CE8AfA5025828d5b98DFb67E059E": {
      "critical": true
    },
    // ProxyAdmin (L2): can upgrade all L2 predeploys incl. L2StandardBridge, L2CrossDomainMessenger and L2ToL1MessagePasser.
    "base:0x4200000000000000000000000000000000000018": {
      "critical": true
    },
    // Base Governance Multisig: owner of both ProxyAdmins, SuperchainConfig guardian and SP1VerifierGateway owner.
    "eth:0x7bB41C3008B3f03FE483B28b8DB90e19Cf07595c": {
      "critical": true
    },
    // Base Multisig 1: SystemConfig owner (batcher/sequencer config) and SuperchainConfig INCIDENT_RESPONDER (can pause).
    "eth:0x14536667Cd30e52C0b458BaACcB9faDA7046E056": {
      "critical": true
    },
    // Base Coordinator Multisig: required signer (2-of-2) of the Base Governance Multisig; direct owner of TEEProverRegistry and NitroEnclaveVerifier.
    "eth:0x9855054731540A48b28990B63DcF4f33d8AE46A1": {
      "critical": true
    },
    // RISC Zero governance timelock: owner of the RiscZeroVerifierRouter used to validate TEE signer registrations (add/remove verifiers).
    "eth:0x0b144E07A0826182B6b59788c34b32Bfa86Fb711": {
      "critical": true
    },
    // RISC Zero governance Safe: proposer/executor/canceller of the timelock and owner of the RiscZeroVerifierEmergencyStops.
    "eth:0x2E5bcc9959dB5F5016F830E47943b07242CB2609": {
      "critical": true
    },
    // Base Security Council: required signer (2-of-2) of the Base Governance Multisig (upgrade + guardian authority).
    "eth:0x20AcF55A3DCfe07fC4cecaCFa1628F788EC8A4Dd": {
      "critical": true,
      "references": [
        {
          "text": "Security Council members - Base Docs",
          "href": "https://docs.base.org/chain/security-council"
        }
      ]
    },
    "eth:0x73a79Fab69143498Ed3712e519A88a918e1f4072": {
      "ignoreInWatchMode": ["gasLimit"]
    },
    "eth:0x9de443AdC5A411E83F1878Ef24C3F52C61571e72": {
      "ignoreRelatives": ["l2Token", "l1Token"],
      "fields": {
        "accessControl": {
          "handler": { "type": "accessControl", "ignoreRelative": true }
        }
      }
    },
    "eth:0xA5874756416Fa632257eEA380CAbd2E87cED352A": {
      "description": "Custom bridge for USDS and sUSDS managed by Sky governance.",
      "ignoreMethods": ["proxiableUUID"]
    },
    "eth:0x0000F90827F1C53a10cb7A02335B175320002935": {
      "description": "EIP-2935 system contract storing the last 8191 L1 blockhashes. Bytecode is canonical to the EIP, deployed at the same address across networks.",
      // consumed by the AggregateVerifier (EIP2935_CONTRACT) to validate the L1 head of proofs.
      "critical": true,
      "manualSourcePaths": {
        "eth:0x0000F90827F1C53a10cb7A02335B175320002935": "https://eips.ethereum.org/EIPS/eip-2935"
      }
    },
    "eth:0x1af2A7E537DE2eE795DE5B8BfbB1Ad0DD513A5aA": {
      "ignoreInWatchMode": ["getRegisteredSigners"],
      "fields": {
        "getRegisteredSigners": { "severity": "LOW" }
      }
    }
  }
}
