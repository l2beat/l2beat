{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "base",
  "import": ["../globalConfig.jsonc"],
  "maxAddresses": 200,
  "initialAddresses": [
    "eth:0x9de443AdC5A411E83F1878Ef24C3F52C61571e72",
    "eth:0x3154Cf16ccdb4C6d922629664174b904d80F2C35",
    "eth:0xA5874756416Fa632257eEA380CAbd2E87cED352A",

    "base:0x4200000000000000000000000000000000000007",
    "base:0x4200000000000000000000000000000000000010",
    "base:0x4200000000000000000000000000000000000011",
    "base:0x4200000000000000000000000000000000000012",
    "base:0x4200000000000000000000000000000000000013",
    "base:0x4200000000000000000000000000000000000014",
    "base:0x4200000000000000000000000000000000000015",
    "base:0x4200000000000000000000000000000000000016",
    "base:0x4200000000000000000000000000000000000017",
    "base:0x4200000000000000000000000000000000000019",
    "base:0x420000000000000000000000000000000000001A",
    "base:0x4200000000000000000000000000000000000020",
    "base:0x4200000000000000000000000000000000000021"
  ],
  "names": {
    "eth:0x9de443AdC5A411E83F1878Ef24C3F52C61571e72": "wstETHEscrow",
    "eth:0xa2f2aC6F5aF72e494A227d79Db20473Cf7A1FFE8": "DelayedWETH_PermissionlessGames",
    "eth:0x3E8a0B63f57e975c268d610ece93da5f78c01321": "DelayedWETH_PermissionedGames",
    "eth:0xA5874756416Fa632257eEA380CAbd2E87cED352A": "SkyLink Bridge",
    "eth:0x0000F90827F1C53a10cb7A02335B175320002935": "HistoryStorage",

    "base:0x8cC51c3008b3f03Fe483B28B8Db90e19cF076a6d": "Base Governance Multisig - L2 Alias"
  },
  "overrides": {
    "eth:0x8EfB6B5c4767B09Dc9AA6Af4eAA89F749522BaE2": {
      // AddressManager of this chain: its owner can repoint the ResolvedDelegateProxy implementations
      "critical": true
    },
    // The air gap: how long a resolved dispute game must wait before its root
    // can finalize withdrawals. Not HIGH: it is an immutable of the
    // AnchorStateRegistry implementation, so it only changes with an upgrade,
    // which is already a critical code change.
    "eth:0x909f6cf47ed12f010A796527f562bFc26C7F4E72": {
      "fields": {
        "disputeGameFinalityDelaySeconds": {
          "description": "Delay between a dispute game resolving and its root claim becoming usable to finalize withdrawals (the air gap)."
        }
      }
    },
    // Detached Cannon fault-proof system. The Azul multiproof upgrade (tx
    // 0x75b1c9b2090ba2b311d6be08c319340b87dc1aabfae2505d126e7a0f1fc6b11c,
    // block 25181743, ts 1779825599) set AnchorStateRegistry.respectedGameType
    // 0 -> 621 (AggregateVerifier) and retirementTimestamp = 1779825599. Every
    // FaultDisputeGame/PermissionedDisputeGame created up to then is retired,
    // and newer games of types 1 and 8 are not respected (isGameRespected), so
    // OptimismPortal2 cannot prove or finalize withdrawals with them. Their
    // DelayedWETHs only held game bonds (20.16 ETH of FaultDisputeGame bonds at
    // the switch, 0 ETH since). Re-attaching them needs a respectedGameType
    // change, which is HIGH on the AnchorStateRegistry and resets the clock.
    // FaultDisputeGame (game type 8, was also game type 0 until the upgrade)
    "eth:0x6dDBa09bc4cCB0D6Ca9Fc5350580f74165707499": {
      "critical": { "untilTimestamp": 1779825599 }
    },
    // PermissionedDisputeGame (game type 1, permissioned fallback)
    "eth:0x58bf355C5d4EdFc723eF89d99582ECCfd143266A": {
      "critical": { "untilTimestamp": 1779825599 }
    },
    // MIPS VM of the Cannon games
    "eth:0x6463dEE3828677F6270d83d45408044fc5eDB908": {
      "critical": { "untilTimestamp": 1779825599 }
    },
    // PreimageOracle of the Cannon games
    "eth:0x1fb8cdFc6831fc866Ed9C51aF8817Da5c287aDD3": {
      "critical": { "untilTimestamp": 1779825599 }
    },
    // DelayedWETH of the FaultDisputeGame
    "eth:0x2453c1216E49704d84eA98a4daCd95738F2fC8Ec": {
      "critical": { "untilTimestamp": 1779825599 }
    },
    // DelayedWETH of the PermissionedDisputeGame
    "eth:0x64AE5250958CdeB83f6b61f913B5Ac6Ebe8EFd4D": {
      "critical": { "untilTimestamp": 1779825599 }
    },
    // Optimism's shared SuperchainConfig: Base's pause authority from tx
    // 0xb690dad4829ca8b07b6944d7e937d7d36048ea29a9278cbae012ab4a66aac817
    // (ts 1719592367, OptimismPortal/bridges started reading it) until the
    // governance decoupling tx
    // 0xa2dc938704977d2f3d0765832e79e1239d97aa6912efadc21a9705ef7dca42eb
    // (ts 1772559059, SystemConfig repointed to Base's own SuperchainConfig
    // 0xb535...). Its OP-governed upgrades in that window changed Base's pause
    // mechanism. It left discovery in 91b4eeeb.
    "eth:0x95703e0982140D16f8ebA6d158FccEde42f04a4C": {
      "critical": { "sinceTimestamp": 1719592367, "untilTimestamp": 1772559059 }
    },
    // Historical RISC Zero verification path for TEE prover registration,
    // retired by the Cobalt upgrade on 2026-09-28. Permanently paused verifier
    // routes were never part of this path.
    "eth:0x8EaB2D97Dfce405A1692a21b3ff3A172d593D319": {
      "critical": {
        "untilTimestamp": 1790627891
      }
    },
    "eth:0x9F9994Eb4Cb5200198FEfb470f8b50301662e696": {
      "critical": {
        "untilTimestamp": 1790627891
      }
    },
    "eth:0x1efDd13f831ceeEa14940806705A53D3211CD698": {
      "critical": {
        "untilTimestamp": 1790627891
      }
    },
    "eth:0x844D5f01161E3559d36f23d0Aa9E9620949aF782": {
      "critical": {
        "untilTimestamp": 1790627891
      }
    },
    "eth:0x2a098988600d87650Fb061FfAff08B97149Fa84D": {
      "critical": {
        "untilTimestamp": 1790627891
      }
    },
    "eth:0xafB31f5b70623CDF4b20Ada3f7230916A5A79df9": {
      "critical": {
        "untilTimestamp": 1790627891
      }
    },
    "eth:0x5005aBa3DFf7C940fcc1e48DccCAD611a80eEB85": {
      "critical": {
        "untilTimestamp": 1790627891
      }
    },
    // RISC Zero governance timelock: owned the RiscZeroVerifierRouter.
    "eth:0x0b144E07A0826182B6b59788c34b32Bfa86Fb711": {
      "critical": {
        "untilTimestamp": 1790627891
      }
    },
    // SP1 verification path used by ZkVerifier
    "eth:0xdc32E228636273285Befa5F001dBB5142517C106": {
      "critical": true
    },
    "eth:0xc3c6dDDAc8829b233Dc6536Ec024775a57b0AF2A": {
      "critical": true
    },
    // ProxyAdmin (L1): can upgrade every core Base contract (portal, bridges, DGF, SystemConfig, SuperchainConfig, TEEProverRegistry, ProtocolVersions).
    "eth:0x0475cBCAebd9CE8AfA5025828d5b98DFb67E059E": {
      "critical": true
    },
    // ProxyAdmin (L2): can upgrade all L2 predeploys incl. L2StandardBridge, L2CrossDomainMessenger and L2ToL1MessagePasser.
    "base:0x4200000000000000000000000000000000000018": {
      "critical": true
    },
    // Safes are actor containers outside the perimeter. Mechanism changes of
    // the Safes on the upgrade path are recorded in ossification.json against
    // the L1 ProxyAdmin.
    "eth:0x20AcF55A3DCfe07fC4cecaCFa1628F788EC8A4Dd": {
      "references": [
        {
          "text": "Security Council members - Base Docs",
          "href": "https://docs.base.org/chain/security-council"
        }
      ]
    },
    "eth:0x73a79Fab69143498Ed3712e519A88a918e1f4072": {
      "ignoreInWatchMode": ["gasLimit"]
    },
    "eth:0x49048044D57e1C92A77f79988d21Fa8fAF74E97e": {
      "fields": {
        "minimumGasLimitZeroBytes": {
          "handler": {
            "type": "call",
            "method": "function minimumGasLimit(uint64 _byteCount) pure returns (uint64)",
            "args": [0]
          }
        },
        "minimumGasLimitOneByte": {
          "handler": {
            "type": "call",
            "method": "function minimumGasLimit(uint64 _byteCount) pure returns (uint64)",
            "args": [1]
          }
        }
      }
    },
    "eth:0x9de443AdC5A411E83F1878Ef24C3F52C61571e72": {
      "ignoreRelatives": ["l2Token", "l1Token"],
      "fields": {
        "accessControl": {
          "handler": { "type": "accessControl", "ignoreRelative": true }
        }
      }
    },
    "eth:0xA5874756416Fa632257eEA380CAbd2E87cED352A": {
      "description": "Custom bridge for USDS and sUSDS managed by Sky governance.",
      "ignoreMethods": ["proxiableUUID"]
    },
    "eth:0x0000F90827F1C53a10cb7A02335B175320002935": {
      "description": "EIP-2935 system contract storing the last 8191 L1 blockhashes. Bytecode is canonical to the EIP, deployed at the same address across networks.",
      // Consumed by the AggregateVerifier (EIP2935_CONTRACT) to validate the L1
      // head of proofs. Not critical: an Ethereum protocol system contract is
      // part of the L1 trust root, not Base's code or configuration.
      "manualSourcePaths": {
        "eth:0x0000F90827F1C53a10cb7A02335B175320002935": "https://eips.ethereum.org/EIPS/eip-2935"
      }
    },
    "eth:0x1af2A7E537DE2eE795DE5B8BfbB1Ad0DD513A5aA": {
      "ignoreInWatchMode": ["getRegisteredSigners"],
      "fields": {
        "getRegisteredSigners": { "severity": "LOW" }
      }
    }
  }
}
