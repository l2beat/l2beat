{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "bob",
  "import": ["../globalConfig.jsonc"],
  "initialAddresses": [
    "eth:0x3F6cE1b36e5120BBc59D0cFe8A5aC8b6464ac1f7",
    "eth:0x091dF5E1284E49fA682407096aD34cfD42B95B72"
  ],
  "overrides": {
    // Active Kailua proof path: KailuaGame/KailuaTreasury (game type 1337) verify
    // state roots through the KailuaVerifier, which routes RISC Zero receipts
    // through the shared RiscZeroVerifierRouter. Permanently paused verifier
    // routes are intentionally not flagged (base precedent).
    "eth:0xD37b0BEdD9094988a31dBbB6BF77dC97269E742b": {
      "critical": true
    },
    "eth:0x9937033Cc967eED9d753e31c77D2F146d002ae53": {
      "critical": true
    },
    "eth:0xa23bf38299bbCbAA01b9ea8a1d3412D9f405b97d": {
      "critical": true
    },
    // Active RISC Zero verification path: router, unpaused emergency stops and
    // the verifiers they wrap.
    "eth:0x9F9994Eb4Cb5200198FEfb470f8b50301662e696": {
      "critical": true
    },
    "eth:0x1efDd13f831ceeEa14940806705A53D3211CD698": {
      "critical": true
    },
    "eth:0x844D5f01161E3559d36f23d0Aa9E9620949aF782": {
      "critical": true
    },
    "eth:0x2a098988600d87650Fb061FfAff08B97149Fa84D": {
      "critical": true
    },
    "eth:0xafB31f5b70623CDF4b20Ada3f7230916A5A79df9": {
      "critical": true
    },
    "eth:0x5005aBa3DFf7C940fcc1e48DccCAD611a80eEB85": {
      "critical": true
    },
    // ProxyAdmin: can upgrade the core BOB contracts (portal, bridges, DGF, SystemConfig).
    "eth:0x0d9f416260598313Be6FDf6B010f2FbC34957Cd0": {
      "critical": true
    },
    // ProxyAdmin: can upgrade the SuperchainConfig fork that holds BOB's pause authority.
    "eth:0xa70ddfb3e00fCFD083E64B200FE867104f703E1c": {
      "critical": true
    },
    "eth:0x8EaB2D97Dfce405A1692a21b3ff3A172d593D319": {
      // RiscZeroVerifierRouter: routes proof verification by selector; the owner
      // (RISC Zero governance timelock) can add or remove verifier routes.
      "critical": true,
      "fields": {
        // "verifier0Manual": {
        //   "handler": {
        //     "type": "call",
        //     "method": "getVerifier",
        //     "args": ["0x310fe598"]
        //   }
        // },
        // "verifier1ManualREMOVED": {
        //   "handler": {
        //     "type": "call",
        //     "method": "getVerifier",
        //     "args": ["0x50bd1769"]
        //   }
        // },
        // "verifier2ManualREMOVED": {
        //   "handler": {
        //     "type": "call",
        //     "method": "getVerifier",
        //     "args": ["0xc101b42b"]
        //   }
        // },
        // "verifier3Manual": {
        //   "handler": {
        //     "type": "call",
        //     "method": "getVerifier",
        //     "args": ["0x9f39696c"]
        //   }
        // },
        // "verifier4Manual": {
        //   "handler": {
        //     "type": "call",
        //     "method": "getVerifier",
        //     "args": ["0xf536085a"]
        //   }
        // },
        // above verifiers seem to be unused by BOB, below is v2.2.0
        "verifier5Manual": {
          "handler": {
            "type": "call",
            "method": "getVerifier",
            "args": ["0xbb001d44"]
          }
        },
        "verifier6Manual": {
          "handler": {
            "type": "call",
            "method": "getVerifier",
            "args": ["0x73c457ba"]
          }
        },
        "verifier7Manual": {
          "handler": {
            "type": "call",
            "method": "getVerifier",
            "args": ["0x242f9d5b"],
            "expectRevert": true
          }
        }
      }
    },
    "eth:0x0b144E07A0826182B6b59788c34b32Bfa86Fb711": {
      // RISC Zero governance timelock: owner of the RiscZeroVerifierRouter used by
      // the KailuaVerifier (add/remove verifier routes).
      "critical": true,
      "fields": {
        "callsScheduled": {
          "description": "since the RiscZeroVerifierRouter does not emit events on verifier changes, we watch the single upstream permissioned address.",
          "handler": {
            "type": "event",
            "add": {
              "event": "CallScheduled"
            }
          }
        },
        "callsExecuted": {
          "description": "since the RiscZeroVerifierRouter does not emit events on verifier changes, we watch the single upstream permissioned address.",
          "severity": "HIGH",
          "handler": {
            "type": "event",
            "add": {
              "event": "CallExecuted"
            }
          }
        }
      }
    }
  }
}
