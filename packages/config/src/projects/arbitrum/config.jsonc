    "arb1:0x912CE59144191C1204E64559FE8253a0e49E6548": "L2ArbitrumToken",
    "arb1:0x5288c571Fd7aD117beA99bF60FE0846C4E84F933": "L2GatewayRouter",
    "arb1:0x09e9222E96E7B4AE2a407B98d48e330053351EEe": "L2ERC20Gateway",
    "arb1:0x6c411aD3E74De3E7Bd422b94A27770f5B86C623B": "L2WethGateway",
    "arb1:0x82aF49447D8a07e3bd95BD0d56f35241523fBab1": "L2WETH",
    "arb1:0xCaD7828a19b363A2B44717AFB1786B5196974D8E": "L2ARBGateway",
    "arb1:0x467194771dAe2967Aef3ECbEDD3Bf9a310C76C65": "L2DAIGateway",
    "arb1:0x6D2457a4ad276000A615295f7A80F79E48CcD318": "L2LPTGateway",
    "arb1:0xd570aCE65C43af47101fC6250FD6fC63D1c22a86": "L2GatewaysProxyAdmin",
    "arb1:0x423552c0F05baCCac5Bfa91C6dCF1dc53a0A1641": "L2SecurityCouncilEmergency",
