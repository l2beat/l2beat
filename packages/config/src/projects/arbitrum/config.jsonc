    "arb1:0x7481716f05E315Fc4C4a64E56DcD9bc1D6F24C0a": "UpgradeExecRouteBuilder",
    "arb1:0x9BF7b8884Fa381a45f8CB2525905fb36C996297a": "SecurityCouncilMemberSyncAction",
    "arb1:0xd343Fd9ba453D3AD0f868c24734808FB73f5F52B": "KeyValueStore",
    "arb1:0xf7951D92B0C345144506576eC13Ecf5103aC905a": "L1Timelock_l2alias",
    "eth:0x8315177aB297bA92A06054cE80a67Ed4DBd7ed3a": "Bridge",
    "eth:0xcEe284F754E854890e311e3280b767F80797180d": "L1CustomGateway",
    "eth:0xd92023E9d9911199a6711321D1277285e6d4e2db": "L1WethGateway",
    "eth:0xbbcE8aA77782F13D4202a230d978F361B011dB27": "L1ARBGateway",
    "eth:0xa3A7B6F88361F48403514059F1F16C8E78d60EeC": "L1ERC20Gateway",
    "eth:0x554723262467F125Ac9e1cDFa9Ce15cc53822dbD": "ArbitrumProxyAdmin",
    "eth:0x5613AF0474EB9c528A34701A5b1662E3C8FA0678": "UpgradeExecutorAdmin",
    "eth:0xE6841D92B0C345144506576eC13ECf5103aC7f49": "L1Timelock",
    "eth:0x4DCeB440657f21083db8aDd07665f8ddBe1DCfc0": "RollupProxy",
    "eth:0x1c479675ad559DC151F6Ec7ed3FbF8ceE79582B6": "SequencerInbox",
    "eth:0x4Dbd4fc535Ac27206064B68FfCf827b0A60BAB3f": "Inbox",
    "eth:0x667e23ABd27E623c11d4CC00ca3EC4d0bD63337a": "OutboxV0",
    "eth:0x760723CD2e632826c38Fef8CD438A4CC7E7E1A40": "OutboxV1",
    "eth:0x0B9857ae2D4A3DBe74ffE1d7DF045bb7F96E4840": "Outbox",
    "eth:0x9aD46fac0Cf7f790E5be05A0F15223935A0c0aDa": "GatewaysAdmin",
    "eth:0xD3B5b60020504bc3489D6949d545893982BA3011": "L1DaiGateway",
    "eth:0x9E40625F52829Cf04bC4839F186D621ee33b0E67": "ValidatorUtils",
    "eth:0xe5896783a2F463446E1f624e64Aa6836BE4C6f58": "ChallengeManager",
    "eth:0x0F25c1DC2a9922304f2eac71DCa9B07E310e8E5a": "wstETHEscrow",
    "eth:0x3e40D73EB977Dc6a537aF587D48316feE66E9C8c": "wstETHEscrowAdmin",
    "eth:0x6A23F4940BD5BA117Da261f98aae51A8BFfa210A": "LPTL1Escrow",
    "eth:0x14797f5432f699Cb4d4dB04DF599B74952d78d7b": "UpgradeableBeacon",
    "eth:0xA5565d266c3c3Ee90B16Be8A5b13d587ef559fB0": "EdgeChallengeManager",
    "eth:0xA10c7CE4b876998858b1a9E12b10092229539400": "L1Escrow",
    "eth:0xc4940069140142236D4065b866018f7b2BeC77fD": "OutboxEntry"
  },
  "overrides": {
    // Governance timelocks: the minimum delay defines the reaction window
    // users have before a passed proposal executes — a delay change alters
    // the security conditions of every governed contract.
    "eth:0xE6841D92B0C345144506576eC13ECf5103aC7f49": {
      "fields": {
        "getMinDelay": {
          "severity": "HIGH",
          "description": "Minimum timelock delay in seconds before a scheduled governance action can execute on L1."
        }
      }
    },
    "arb1:0x34d45e99f7D8c45ed05B5cA72D54bbD1fb3F98f0": {
      "fields": {
        "getMinDelay": {
          "severity": "HIGH",
          "description": "Minimum timelock delay in seconds before a scheduled governance action can execute on Arbitrum One."
        }
      }
    },
    // Changing the constitutional quorum changes the conditions under which
    // core (upgrade-capable) proposals pass.
    "arb1:0xf07DeD9dC292157749B6Fd268E37DF6EA38395B9": {
      "fields": {
        "l2CoreQuorumPercent": {
          "severity": "HIGH",
          "description": "The percentage of total Delegated Voting Power (DVP) required to pass a constitutional proposal."
        }
      }
    },
    "arb1:0xCF57572261c7c2BCF21ffD220ea7d1a27D40A827": {
      "fields": {
        // EXECUTOR_ROLE members hold undelayed, unrestricted upgrade authority
        // over every L2 proxy (same power class as ProxyAdmin.owner, which is
        // HIGH); the 2023 role migration is a recorded criticalEvent.
        "executors": { "severity": "HIGH" },
        // Seeds the ArbOS 61 transaction-filtering precompile (0x..74) as a
        // relative and applies the shared orbitstack/ArbFilteredTransactionsManager
        // template (censored-tx counts + authorized filterer set). The feature is
        // not enabled on Arbitrum One, so it yields no results today; it
        // auto-populates if it is ever activated. Hosted on the chain owner
        // (UpgradeExecutor) because that is the ArbOS-config authority.
        "transactionFilteringPrecompile": {
          "handler": {
            "type": "hardcoded",
            "value": "arb1:0x0000000000000000000000000000000000000074"
          },
          "template": "orbitstack/ArbFilteredTransactionsManager"
        }
      }
    },
    "arb1:0x0000000000000000000000000000000000000074": {
      // The precompile is a 0xfe stub once ArbOS 61 activates (no code before
      // then), so discovery cannot fetch its source and would flag it unverified.
      // Point at the Nitro implementation. This is a manual label, NOT an
      // integrity check: divergence of the actual precompile logic is caught by
      // the RollupProxy wasmModuleRoot (One/Nova activate the reproduced v61 root
      // 0xc10cd7ec..., identical to Robinhood), not by this source hash.
      "manualSourcePaths": {
        "arb1:0x0000000000000000000000000000000000000074": "https://github.com/OffchainLabs/nitro/blob/v3.11.0/precompiles/ArbFilteredTransactionsManager.go"
      }
    },
    "arb1:0xF06E95eF589D9c38af242a8AAee8375f14023F85": {
      "ignoreDiscovery": true
    },
    "eth:0x40Cd7D713D7ae463f95cE5d342Ea6E7F5cF7C999": {
      // ParentToChildRewardRouter.destination is an L2 treasury address. Keep
      // the value recorded, but do not follow it as an Ethereum relative.
      "ignoreRelatives": ["destination"]
    },
    "eth:0x0B9857ae2D4A3DBe74ffE1d7DF045bb7F96E4840": {
      "fields": {
        // updateRollupAddress() re-points who may call updateSendRoot(): a
        // swapped rollup can insert arbitrary withdrawal roots. State-only.
        "rollup": { "severity": "HIGH" }
      },
      "description": "Facilitates L2 to L1 contract calls: Messages initiated from L2 (for example withdrawal messages) eventually resolve in execution on L1. Is also used to relay governance action messages from Arbitrum One to Ethereum, allowing the L2Timelock and its Governance actors on L2 to act as this address and inherit all its listed permissions."
    },
    "eth:0x8315177aB297bA92A06054cE80a67Ed4DBd7ed3a": {
      "fields": {
        // updateRollupAddress() re-points the bridge's trusted rollup without
        // any implementation upgrade; the rollup gates outbox/inbox authority.
        "rollup": { "severity": "HIGH" },
        "mainOutboxAddress": {
          "handler": {
            "type": "call",
            "method": "function allowedOutboxList(uint256) view returns (address)",
            "args": [0]
          },
          "permissions": [{ "type": "act" }]
        }
      }
    },
    "eth:0xC12BA48c781F6e392B49Db2E25Cd0c28cD77531A": {
      "ignoreDiscovery": true
    },
    "eth:0x760723CD2e632826c38Fef8CD438A4CC7E7E1A40": {
      // legacy outbox, still registered in the Bridge's allowedOutboxList:
      // can call the Bridge to move any escrowed funds.
      "critical": true,
      "ignoreMethods": ["outboxEntries", "outboxEntryExists"]
    },
    "eth:0xD3B5b60020504bc3489D6949d545893982BA3011": {
      "ignoreRelatives": [
        "counterpartGateway",
        "inbox",
        "l1Dai",
        "l1Router",
        "l2Counterpart",
        "l2Dai"
      ],
      "category": "bridge-external"
    },
    "eth:0x9E40625F52829Cf04bC4839F186D621ee33b0E67": {
      "fields": {
        "ARBITRUM_STAKERS": {
          "handler": {
            "type": "call",
            "method": "function getStakers(address rollup, uint64 startIndex, uint64 max) view returns (address[], bool hasMore)",
            "args": ["0x5eF0D09d1E6204141B4d37530808eD19f60FBa35", 0, 100]
          }
        }
      },
      "ignoreRelatives": ["ARBITRUM_STAKERS"]
    },
    "eth:0x667e23ABd27E623c11d4CC00ca3EC4d0bD63337a": {
      // legacy outbox, still registered in the Bridge's allowedOutboxList:
      // can call the Bridge to move any escrowed funds.
      "critical": true,
      "ignoreMethods": [
        "l2ToL1BatchNum",
        "l2ToL1OutputId",
        "outboxEntryExists",
        "outboxes"
      ]
    },
    "eth:0x0F25c1DC2a9922304f2eac71DCa9B07E310e8E5a": {
      // escrow holding TVS-counted wstETH for the Lido custom gateway. Lido-governed (admin is the Lido DAO Agent), so it is an external escrow outside the ossification perimeter.
      "category": "bridge-external",
      "ignoreRelatives": ["l2Token", "l1Token"],
      "fields": { "accessControl": { "handler": { "type": "accessControl" } } }
    },
    "eth:0x3e40D73EB977Dc6a537aF587D48316feE66E9C8c": {
      "ignoreDiscovery": true
    },
    "eth:0x73b047fe6337183A454c5217241D780a932777bD": {
      "ignoreDiscovery": true
    },
    "eth:0x6A23F4940BD5BA117Da261f98aae51A8BFfa210A": {
      // escrow holding TVS-counted LPT for the Livepeer gateway. Livepeer-governed external escrow, outside the ossification perimeter.
      "category": "bridge-external"
    },
    "eth:0xA10c7CE4b876998858b1a9E12b10092229539400": {
      // MakerDAO escrow holding TVS-counted DAI, L1DaiGateway can pull from it. Maker/Sky-governed external escrow, outside the ossification perimeter.
      "category": "bridge-external"
    },
    // ProxyAdmin of the core system contracts (Bridge, RollupProxy, Inbox,
    // Outbox(es), SequencerInbox): can swap their implementations.
    "eth:0x554723262467F125Ac9e1cDFa9Ce15cc53822dbD": {
      "critical": true,
      "category": "spam"
    },
    // ProxyAdmin of the L1 UpgradeExecutor: can swap its implementation.
    "eth:0x5613AF0474EB9c528A34701A5b1662E3C8FA0678": {
      "critical": true,
      "category": "spam"
    },
    // Beacon governing the OutboxEntry implementation used by OutboxV0, which
    // is still an allowed outbox in the Bridge: a malicious implementation can
    // forge/replay legacy withdrawal records against the Bridge escrow.
    "eth:0x14797f5432f699Cb4d4dB04DF599B74952d78d7b": {
      "critical": true,
      "category": "spam",
      "fields": {
        // beacon swaps are plain value changes (proxyType immutable), not
        // auto-HIGH code events; past swaps are recorded criticalEvents.
        "implementation": { "severity": "HIGH" },
        "owner": { "severity": "HIGH" }
      }
    },
    // ProxyAdmin of the canonical token gateways and GatewayRouter: can swap
    // their implementations and drain escrows.
    "eth:0x9aD46fac0Cf7f790E5be05A0F15223935A0c0aDa": {
      "critical": true,
      "category": "spam"
    },
    // OutboxEntry beacon implementation: enforces merkle-root/spent-state
    // validity of legacy withdrawals executed through the still-allowed OutboxV0.
    "eth:0xc4940069140142236D4065b866018f7b2BeC77fD": {
      "critical": true,
      "category": "spam"
    },
    // L2ProxyAdmin (global/ProxyAdmin shape): can swap implementations of the
    // L2 governance stack (L2Timelock, L2UpgradeExecutor, ARB token, governors).
    "arb1:0xdb216562328215E010F819B5aBe947bad4ca961e": {
      "critical": true
    },
    // L2GatewaysProxyAdmin (global/ProxyAdmin shape): can swap implementations
    // of the L2 token gateways, whose withdrawal messages the L1 gateways trust.
    "arb1:0xd570aCE65C43af47101fC6250FD6fC63D1c22a86": {
      "critical": true
    },
    // Canonical gateway counterparts and token implementations. These are
    // explicit roots because their cross-chain references otherwise resolve on
    // the source chain and materialize as EOAs.
    "eth:0xd92023E9d9911199a6711321D1277285e6d4e2db": {
      "critical": true,
      "category": "bridge-canonical",
      "description": "Canonical WETH gateway escrowing L1 WETH and releasing it for withdrawals proven through the Arbitrum bridge.",
      "ignoreRelatives": ["counterpartGateway", "l1Weth", "l2Weth"]
    },
    "eth:0xbbcE8aA77782F13D4202a230d978F361B011dB27": {
      "critical": true,
      "category": "bridge-canonical",
      "description": "Canonical reverse gateway for ARB transfers between Ethereum and Arbitrum One.",
      "ignoreRelatives": ["counterpartGateway"]
    },
    "arb1:0x82aF49447D8a07e3bd95BD0d56f35241523fBab1": {
      "critical": true,
      "category": "bridge-canonical",
      "description": "Canonical upgradeable WETH token burned by L2WethGateway when withdrawing against the L1 WETH escrow.",
      "ignoreRelatives": ["l1Address"],
      "ignoreInWatchMode": ["totalSupply"]
    },
    // Factory/beacon stack defining standard L2 token code redeemable against
    // the canonical L1ERC20Gateway escrow.
    "arb1:0x3fE38087A94903A9D946fa1915e1772fe611000f": {
      "critical": true
    },
    "arb1:0xE72ba9418b5f2Ce0A6a40501Fe77c6839Aa37333": {
      "critical": true,
      "fields": {
        // beacon swaps are plain value changes (proxyType immutable), not
        // auto-HIGH code events; past swaps are recorded criticalEvents.
        "implementation": { "severity": "HIGH" },
        "owner": { "severity": "HIGH" }
      }
    },
    "arb1:0x3f770Ac673856F105b586bb393d122721265aD46": {
      "critical": true
    },
    // --- ossification severity overrides on shared orbitstack templates
    // (config-level, NOT the templates: template edits fan out to all orbit
    // chains; see the timelock getMinDelay precedent above) ---
    "eth:0x4DCeB440657f21083db8aDd07665f8ddBe1DCfc0": {
      "fields": {
        // live onlyOwner setters on RollupAdminLogic — no upgrade needed:
        // setChallengeManager (fraud-proof adjudicator pointer),
        // setAnyTrustFastConfirmer (bypasses the challenge period when set),
        // setValidatorWhitelistDisabled (re-permissions fraud proofs),
        // setConfirmPeriodBlocks (the challenge window), setOwner.
        "challengeManager": { "severity": "HIGH" },
        "anyTrustFastConfirmer": { "severity": "HIGH" },
        "validatorWhitelistDisabled": { "severity": "HIGH" },
        "confirmPeriodBlocks": { "severity": "HIGH" },
        "owner": { "severity": "HIGH" }
      }
    },
    "eth:0x1c479675ad559DC151F6Ec7ed3FbF8ceE79582B6": {
      "fields": {
        // force-inclusion window (delayBlocks/delaySeconds): the user's
        // censorship-resistance guarantee, owner-settable. Same rationale as
        // the timelock getMinDelay override above.
        "maxTimeVariation": { "severity": "HIGH" }
      }
    },
    "eth:0x3ffFbAdAF827559da092217e474760E2b2c3CeDd": {
      "fields": {
        // EXECUTOR_ROLE members hold undelayed, unrestricted upgrade authority
        // over every L1 ProxyAdmin; the 2023 role migration is a recorded
        // criticalEvent.
        "executors": { "severity": "HIGH" }
      }
    },
    "eth:0x72Ce9c846789fdB6fC1f34aC4AD25Dd9ef7031ef": {
      "fields": {
        // a changed default gateway redirects future deposits to an arbitrary
        // "gateway"; owner can also set per-token routes (setGateway).
        "defaultGateway": { "severity": "HIGH" },
        "owner": { "severity": "HIGH" }
      }
    },
    "arb1:0x5288c571Fd7aD117beA99bF60FE0846C4E84F933": {
      "fields": {
        "defaultGateway": { "severity": "HIGH" }
      }
    }
  }
}
