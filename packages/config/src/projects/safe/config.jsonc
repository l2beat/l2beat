{
  "$schema": "../../../../discovery/schemas/config.v2.schema.json",
  "name": "safe",
  "import": ["../globalConfig.jsonc"],
  "maxAddresses": 50,
  "initialAddresses": [
    // Canonical v1.3.0, v1.4.1 and v1.5.0 deployments (safe-global/safe-deployments).
    // Every Safe account is a proxy created by a factory that delegates to one
    // of the singletons; the accounts themselves are not enumerated. The v1.3.0
    // "eip155" deployment is left out: it created under 2k accounts on Ethereum.
    // v1.4.1
    "eth:0x41675C099F32341bf84BFc5382aF534df5C7461a", // Safe
    "eth:0x29fcB43b46531BcA003ddC8FCB67FFE91900C762", // SafeL2
    "eth:0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67", // SafeProxyFactory
    "eth:0xfd0732Dc9E303f09fCEf3a7388Ad10A83459Ec99", // CompatibilityFallbackHandler
    "eth:0x38869bf66a61cF6bDB996A6aE40D5853Fd43B526", // MultiSend
    "eth:0x9641d764fc13c8B624c04430C7356C1C7C8102e2", // MultiSendCallOnly
    "eth:0xd53cd0aB83D845Ac265BE939c57F53AD838012c9", // SignMessageLib
    "eth:0x9b35Af71d77eaf8d7e40252370304687390A1A52", // CreateCall
    "eth:0x3d4BA2E0884aa488718476ca2FB8Efc291A46199", // SimulateTxAccessor
    // v1.3.0
    "eth:0xd9Db270c1B5E3Bd161E8c8503c55cEABeE709552", // GnosisSafe
    "eth:0x3E5c63644E683549055b9Be8653de26E0B4CD36E", // GnosisSafeL2
    "eth:0xa6B71E26C5e0845f74c812102Ca7114b6a896AB2", // GnosisSafeProxyFactory
    "eth:0xf48f2B2d2a534e402487b3ee7C18c33Aec0Fe5e4", // CompatibilityFallbackHandler
    "eth:0xA238CBeb142c10Ef7Ad8442C6D1f9E89e07e7761", // MultiSend
    "eth:0x40A2aCCbd92BCA938b02010E17A5b8929b49130D", // MultiSendCallOnly
    "eth:0xA65387F16B013cf2Af4605Ad8aA5ec25a2cbA3a2", // SignMessageLib
    "eth:0x7cbB62EaA69F79e6873cD1ecB2392971036cFAa4", // CreateCall
    "eth:0x59AD6735bCd8152B84860Cb256dD9e96b85F69Da", // SimulateTxAccessor
    // v1.5.0
    "eth:0xFf51A5898e281Db6DfC7855790607438dF2ca44b", // Safe
    "eth:0xEdd160fEBBD92E350D4D398fb636302fccd67C7e", // SafeL2
    "eth:0x14F2982D601c9458F93bd70B218933A6f8165e7b", // SafeProxyFactory
    "eth:0x3EfCBb83A4A7AfcB4F68D501E2c2203a38be77f4", // CompatibilityFallbackHandler
    "eth:0x218543288004CD07832472D464648173c77D7eB7", // MultiSend
    "eth:0xA83c336B20401Af773B6219BA5027174338D1836", // MultiSendCallOnly
    "eth:0x4FfeF8222648872B3dE295Ba1e49110E61f5b5aa", // SignMessageLib
    "eth:0x2Ef5ECfbea521449E4De05EDB1ce63B75eDA90B4", // CreateCall
    "eth:0x07EfA797c55B5DdE3698d876b277aBb6B893654C" // SimulateTxAccessor
  ],
  "names": {
    "eth:0x41675C099F32341bf84BFc5382aF534df5C7461a": "Safe_v1_4_1",
    "eth:0x29fcB43b46531BcA003ddC8FCB67FFE91900C762": "SafeL2_v1_4_1",
    "eth:0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67": "SafeProxyFactory_v1_4_1",
    "eth:0xfd0732Dc9E303f09fCEf3a7388Ad10A83459Ec99": "CompatibilityFallbackHandler_v1_4_1",
    "eth:0x38869bf66a61cF6bDB996A6aE40D5853Fd43B526": "MultiSend_v1_4_1",
    "eth:0x9641d764fc13c8B624c04430C7356C1C7C8102e2": "MultiSendCallOnly_v1_4_1",
    "eth:0xd53cd0aB83D845Ac265BE939c57F53AD838012c9": "SignMessageLib_v1_4_1",
    "eth:0x9b35Af71d77eaf8d7e40252370304687390A1A52": "CreateCall_v1_4_1",
    "eth:0x3d4BA2E0884aa488718476ca2FB8Efc291A46199": "SimulateTxAccessor_v1_4_1",
    "eth:0xd9Db270c1B5E3Bd161E8c8503c55cEABeE709552": "GnosisSafe",
    "eth:0x3E5c63644E683549055b9Be8653de26E0B4CD36E": "GnosisSafeL2",
    "eth:0xa6B71E26C5e0845f74c812102Ca7114b6a896AB2": "GnosisSafeProxyFactory",
    "eth:0xf48f2B2d2a534e402487b3ee7C18c33Aec0Fe5e4": "CompatibilityFallbackHandler_v1_3_0",
    "eth:0xA238CBeb142c10Ef7Ad8442C6D1f9E89e07e7761": "MultiSend_v1_3_0",
    "eth:0x40A2aCCbd92BCA938b02010E17A5b8929b49130D": "MultiSendCallOnly_v1_3_0",
    "eth:0xA65387F16B013cf2Af4605Ad8aA5ec25a2cbA3a2": "SignMessageLib_v1_3_0",
    "eth:0x7cbB62EaA69F79e6873cD1ecB2392971036cFAa4": "CreateCall_v1_3_0",
    "eth:0x59AD6735bCd8152B84860Cb256dD9e96b85F69Da": "SimulateTxAccessor_v1_3_0",
    "eth:0xFf51A5898e281Db6DfC7855790607438dF2ca44b": "Safe_v1_5_0",
    "eth:0xEdd160fEBBD92E350D4D398fb636302fccd67C7e": "SafeL2_v1_5_0",
    "eth:0x14F2982D601c9458F93bd70B218933A6f8165e7b": "SafeProxyFactory_v1_5_0",
    "eth:0x3EfCBb83A4A7AfcB4F68D501E2c2203a38be77f4": "CompatibilityFallbackHandler_v1_5_0",
    "eth:0x218543288004CD07832472D464648173c77D7eB7": "MultiSend_v1_5_0",
    "eth:0xA83c336B20401Af773B6219BA5027174338D1836": "MultiSendCallOnly_v1_5_0",
    "eth:0x4FfeF8222648872B3dE295Ba1e49110E61f5b5aa": "SignMessageLib_v1_5_0",
    "eth:0x2Ef5ECfbea521449E4De05EDB1ce63B75eDA90B4": "CreateCall_v1_5_0",
    "eth:0x07EfA797c55B5DdE3698d876b277aBb6B893654C": "SimulateTxAccessor_v1_5_0"
  },
  "overrides": {
    // Factories and default fallback handlers are critical here; their shared
    // templates stay neutral because other projects discover them too.
    "eth:0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67": { "critical": true },
    "eth:0xfd0732Dc9E303f09fCEf3a7388Ad10A83459Ec99": { "critical": true },
    "eth:0xa6B71E26C5e0845f74c812102Ca7114b6a896AB2": { "critical": true },
    "eth:0x14F2982D601c9458F93bd70B218933A6f8165e7b": { "critical": true },
    "eth:0x3EfCBb83A4A7AfcB4F68D501E2c2203a38be77f4": { "critical": true },
    // Same source as a handler in polymarket, so it is described here rather
    // than through the shared template, to leave that project untouched.
    "eth:0xf48f2B2d2a534e402487b3ee7C18c33Aec0Fe5e4": {
      "critical": true,
      "description": "Default fallback handler for Safe v1.3.0 accounts: lets them receive ERC-721, ERC-1155 and ERC-777 tokens and answer EIP-1271 signature checks. It has no owner and no state.",
      // Only meaningful when reached through an account's fallback.
      "ignoreMethods": ["getModules"]
    },
    // The singletons match the shared GnosisSafe template (by shape), which is
    // applied to every Safe account in other projects, so their descriptions
    // live here instead. Not being proxies, they have none of the multisig
    // values that template's model.lp reads, hence its `|orNil`.
    "eth:0x41675C099F32341bf84BFc5382aF534df5C7461a": {
      "critical": true,
      "description": "Implementation of Safe v1.4.1 multisig accounts, which are proxies that delegatecall it. Accounts have M-of-N owners and optional modules, guard and fallback handler. Immutable and ownerless; it locks itself at deployment."
    },
    "eth:0x29fcB43b46531BcA003ddC8FCB67FFE91900C762": {
      "critical": true,
      "description": "Same as the v1.4.1 implementation, but it also emits an event for every executed transaction, for indexing on chains without transaction tracing."
    },
    "eth:0xFf51A5898e281Db6DfC7855790607438dF2ca44b": {
      "critical": true,
      "description": "Implementation of Safe v1.5.0 multisig accounts, which are proxies that delegatecall it. Accounts have M-of-N owners and optional modules, guards and fallback handler. Immutable and ownerless; it locks itself at deployment."
    },
    // Not among the shared GnosisSafe template's shapes, so its getters (which
    // revert on the locked implementation) are skipped here.
    "eth:0xEdd160fEBBD92E350D4D398fb636302fccd67C7e": {
      "critical": true,
      "ignoreMethods": ["getOwners", "getThreshold"],
      "description": "Same as the v1.5.0 implementation, but it also emits an event for every executed transaction, for indexing on chains without transaction tracing."
    },
    "eth:0xd9Db270c1B5E3Bd161E8c8503c55cEABeE709552": {
      "critical": true,
      "description": "Implementation of Safe v1.3.0 multisig accounts, which are proxies that delegatecall it. Accounts have M-of-N owners and optional modules, guard and fallback handler. Immutable and ownerless; it locks itself at deployment."
    },
    "eth:0x3E5c63644E683549055b9Be8653de26E0B4CD36E": {
      "critical": true,
      "description": "Same as the v1.3.0 implementation, but it also emits an event for every executed transaction, for indexing on chains without transaction tracing."
    }
  }
}
