#!/usr/bin/env bash
# Checks what a push changes before it leaves: format and lint (Biome) on the
# changed files, then a typecheck of each package they are in. CI runs the
# same checks on everything; this catches the common failures in seconds.
#
# Lint skips Biome's project rules (noFloatingPromises, noMisusedPromises),
# which infer types across the whole repo: ~10 s even for one file. CI runs
# them.
#
# Typechecks use tsrs (a Rust port of TypeScript 7) when it is installed, and
# the repo's tsc otherwise. They read workspace dependencies from their build
# output, so a change to a dependency's types is checked by CI, not here.
#
# Skip once with `git push --no-verify`.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
zero=0000000000000000000000000000000000000000

files=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue # deleting a branch
  if [[ "$remote_sha" == "$zero" ]]; then
    # A new branch: compare with where it left main
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || continue
  else
    base=$remote_sha
  fi
  while IFS= read -r file; do files+=("$file"); done \
    < <(git diff --name-only --diff-filter=ACMR "$base" "$local_sha")
done
[[ ${#files[@]} -eq 0 ]] && exit 0
mapfile -t files < <(printf '%s\n' "${files[@]}" | sort -u)

start=$(date +%s.%N)
status=0

echo "pre-push: Biome on ${#files[@]} changed files"
flags=(--no-errors-on-unmatched --files-ignore-unknown=true)
# Formatting and import order, then lint. Biome 2.3 still prints lint
# findings with the linter off, so lint runs only when the first step
# passes, and a finding is not shown twice.
pnpm exec biome check --linter-enabled=false "${flags[@]}" "${files[@]}" &&
  pnpm exec biome lint --skip=project "${flags[@]}" "${files[@]}" || status=1

packages=$(printf '%s\n' "${files[@]}" | grep -E '^packages/[^/]+/.*\.(ts|tsx|mts|cts)$' |
  cut -d/ -f1,2 | sort -u || true)
if command -v tsrs >/dev/null; then checker=tsrs; else checker="$root/node_modules/.bin/tsc"; fi
pids=()
for package in $packages; do
  grep -q '"typecheck"' "$package/package.json" 2>/dev/null || continue
  echo "pre-push: typecheck $package ($(basename "$checker"))"
  (cd "$package" && "$checker" --noEmit --pretty false) &
  pids+=($!)
done
for pid in "${pids[@]}"; do wait "$pid" || status=1; done

printf 'pre-push: %.1fs\n' "$(echo "$(date +%s.%N) - $start" | bc)"
if [[ $status -ne 0 ]]; then
  echo "pre-push: fix the errors above, or push with --no-verify to skip"
fi
exit $status
