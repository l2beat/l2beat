#!/usr/bin/env bash
# Checks what a push changes before it leaves: format and lint (Biome) on the
# changed files, then a typecheck of each package they are in. CI runs the
# same checks on everything; this catches the common failures in seconds.
#
# Lint skips Biome's project rules (noFloatingPromises, noMisusedPromises),
# which infer types across the whole repo: ~10 s even for one file. CI runs
# them.
#
# Typechecks use tsrs (a Rust port of TypeScript 7) when it is installed, and
# the repo's tsc otherwise. They read workspace dependencies from their build
# output, so a change to a dependency's types is checked by CI, not here.
#
# The checks read the working tree, so the hook refuses a push whose commit
# differs from it where the checks look: commit or stash those changes first.
#
# Runs on the Bash 3.2 that macOS ships: no mapfile, and no empty arrays
# expanded under `set -u`. Skip once with `git push --no-verify`.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
zero=0000000000000000000000000000000000000000

fail() {
  echo "pre-push: $1" >&2
  exit 1
}

now() { perl -MTime::HiRes=time -e 'printf "%.3f", time'; }

# Where the pushed commit's changes start: the remote's tip, or for a new
# branch, or a remote tip this clone hasn't fetched, where it left main
base_for() {
  local local_sha=$1 remote_sha=$2
  if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    echo "$remote_sha"
  elif git merge-base origin/main "$local_sha" 2>/dev/null; then
    :
  else
    fail "can't find where $local_sha starts: no origin/main to compare with (git fetch origin main)"
  fi
}

# Paths one a line, unquoted: core.quotePath=false keeps non-ASCII names as
# they are. Git still quotes a name with a quote, backslash or control
# character; the repo has none, so such a name stops the push.
diff_names() {
  git -c core.quotePath=false diff --name-only "$@"
}

# Fills the array named $1 with the non-empty lines of $2, so paths with
# spaces stay whole
lines_to_array() {
  eval "$1=()"
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && eval "$1+=(\"\$line\")"
  done <<< "$2"
  return 0
}

# Files in what the push adds, one list for Biome (the files that exist) and
# one for picking packages to typecheck (deletions too: a deleted module can
# break the files that import it)
pushed=()
existing=""
touched=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue # deleting a branch
  base=$(base_for "$local_sha" "$remote_sha")
  existing+=$(diff_names --diff-filter=ACMR "$base" "$local_sha")$'\n'
  changed=$(diff_names --diff-filter=ACMRD "$base" "$local_sha")
  touched+="$changed"$'\n'
  pushed+=("$local_sha")
done
existing=$(sed '/^$/d' <<< "$existing" | sort -u)
touched=$(sed '/^$/d' <<< "$touched" | sort -u)
[[ -z "$touched" ]] && exit 0
if grep -q '^"' <<< "$touched"; then
  fail "can't check a file name git has to quote:"$'\n'"$(grep '^"' <<< "$touched")"
fi

packages=$(grep -E '^packages/[^/]+/.*\.(ts|tsx|mts|cts)$' <<< "$touched" |
  cut -d/ -f1,2 | sort -u || true)
typechecked=""
for package in $packages; do
  grep -q '"typecheck"' "$package/package.json" 2>/dev/null &&
    typechecked+="$package"$'\n'
done
typechecked=$(sed '/^$/d' <<< "$typechecked")
[[ -z "$existing" && -z "$typechecked" ]] && exit 0

# What the checks read must be what is pushed: the changed files, and every
# file of the packages they typecheck, tracked or not
lines_to_array scope "$(printf '%s\n%s\n' "$existing" "$typechecked")"
while IFS= read -r sha; do
  dirty=$(
    diff_names "$sha" -- "${scope[@]}"
    git -c core.quotePath=false ls-files --others --exclude-standard -- "${scope[@]}"
  )
  if [[ -n "$dirty" ]]; then
    fail "the working tree differs from the pushed commit ${sha:0:10} in:"$'\n'"$dirty"$'\n'"commit or stash these, or check out the branch you push, then push again"
  fi
done < <(printf '%s\n' "${pushed[@]}")

start=$(now)
status=0

if [[ -n "$existing" ]]; then
  lines_to_array files "$existing"
  echo "pre-push: Biome on ${#files[@]} changed files"
  flags=(--no-errors-on-unmatched --files-ignore-unknown=true)
  # Formatting and import order, then lint. Biome 2.3 still prints lint
  # findings with the linter off, so lint runs only when the first step
  # passes, and a finding is not shown twice.
  pnpm exec biome check --linter-enabled=false "${flags[@]}" "${files[@]}" &&
    pnpm exec biome lint --skip=project "${flags[@]}" "${files[@]}" || status=1
fi

if command -v tsrs >/dev/null; then checker=tsrs; else checker="$root/node_modules/.bin/tsc"; fi
pids=""
for package in $typechecked; do
  echo "pre-push: typecheck $package ($(basename "$checker"))"
  (cd "$package" && "$checker" --noEmit --pretty false) &
  pids+=" $!"
done
for pid in $pids; do wait "$pid" || status=1; done

printf 'pre-push: %.1fs\n' "$(perl -e "print $(now) - $start")"
if [[ $status -ne 0 ]]; then
  echo "pre-push: fix the errors above, or push with --no-verify to skip"
fi
exit $status
